#--- source.hlsl

RWByteAddressBuffer Output : register(u0);

[numthreads(1, 1, 1)]
void main() {
  int3x2 Matrix = { 1, 2, 3, 4, 5, 6 };
  Output.Store<int3x2>(0, Matrix);
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: Output
    Format: Int32
    FillSize: 24
  - Name: ExpectedOutput
    Format: Int32
    Data: [ 1, 2, 3, 4, 5, 6 ]
Results:
  - Result: LegacyRowMajorStore
    Rule: BufferExact
    Actual: Output
    Expected: ExpectedOutput
DescriptorSets:
  - Resources:
    - Name: Output
      Kind: RWByteAddressBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
...
#--- end

# REQUIRES: Vulkan
# XFAIL: Clang && Vulkan

# RUN: split-file %s %t
# RUN: %dxc_target -fspv-use-legacy-buffer-matrix-order -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
