#--- source.hlsl
StructuredBuffer<float4> In : register(t0);
RWStructuredBuffer<float4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  float3x2 r32 = log(float3x2(In[0].xy, In[0].zw, In[1].xy));
  float2x4 r24 = log(float2x4(In[1], In[2]));
  float3x1 r31 = log(float3x1(In[0].x, In[1].x, In[2].x));
  float4x4 r44 = log(float4x4(In[0], In[1], In[2], In[3]));

  Out[0]  = float4(r32[0], 0.0, 0.0);
  Out[1]  = float4(r32[1], 0.0, 0.0);
  Out[2]  = float4(r32[2], 0.0, 0.0);
  Out[3]  = r24[0];
  Out[4]  = r24[1];
  Out[5]  = float4(r31[0], 0.0, 0.0, 0.0);
  Out[6]  = float4(r31[1], 0.0, 0.0, 0.0);
  Out[7]  = float4(r31[2], 0.0, 0.0, 0.0);
  Out[8]  = r44[0];
  Out[9]  = r44[1];
  Out[10] = r44[2];
  Out[11] = r44[3];
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float32
    Stride: 16
    Data: [ 0.0,     0.25,    0.5,    1.0,
            2.0,     2.71828, 4.0,   10.0,
          100.0,     1.0,     4.0,    0.5,
            0.25, 10.0, 1.0, 0.5 ]
    # In[0]: 0 (-inf), 0.25, 0.5, 1
    # In[1]: 2, e, 4, 10
    # In[2]: 100, 1, 4, 0.5 (reuse)
    # In[3]: 0.25, 10.0, 1.0, 0.5
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 192
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    Data: [ -inf, -1.3862944, 0.0, 0.0,
            -0.6931472, 0.0, 0.0, 0.0,
            0.6931472, 0.99999934, 0.0, 0.0,
            0.6931472, 0.99999934, 1.3862944, 2.3025851,
            4.6051702, 0.0, 1.3862944, -0.6931472,
            -inf, 0.0, 0.0, 0.0,
            0.6931472, 0.0, 0.0, 0.0,
            4.6051702, 0.0, 0.0, 0.0,
            -inf, -1.3862944, -0.6931472, 0.0,
            0.6931472, 0.99999934, 1.3862944, 2.3025851,
            4.6051702, 0.0, 1.3862944, -0.6931472,
            -1.3862944, 2.3025851, 0.0, -0.6931472 ]
Results:
  - Result: Test1
    Rule: BufferFloatULP
    ULPT: 2
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
