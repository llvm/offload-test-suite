#--- source.hlsl
StructuredBuffer<half4> In : register(t0);
RWStructuredBuffer<half4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  half3x2 r32 = sqrt(half3x2(In[0].xy, In[0].zw, In[1].xy));
  half2x4 r24 = sqrt(half2x4(In[1], In[2]));
  half3x1 r31 = sqrt(half3x1(In[0].x, In[1].x, In[2].x));
  half4x4 r44 = sqrt(half4x4(In[0], In[1], In[2], In[3]));

  Out[0]  = half4(r32[0], 0.0, 0.0);
  Out[1]  = half4(r32[1], 0.0, 0.0);
  Out[2]  = half4(r32[2], 0.0, 0.0);
  Out[3]  = r24[0];
  Out[4]  = r24[1];
  Out[5]  = half4(r31[0], 0.0, 0.0, 0.0);
  Out[6]  = half4(r31[1], 0.0, 0.0, 0.0);
  Out[7]  = half4(r31[2], 0.0, 0.0, 0.0);
  Out[8]  = r44[0];
  Out[9]  = r44[1];
  Out[10] = r44[2];
  Out[11] = r44[3];
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float16
    Stride: 8
    Data: [ 0x0000, 0x2C00, 0x3400, 0x3C00,
            0x4000, 0x4400, 0x4880, 0x4C00,
            0x5640, 0x3C00, 0x4400, 0x2C00,
            0x2C00, 0x3400, 0x4880, 0x4C00 ]
    # In[0]: 0, 0.0625, 0.25, 1.0
    # In[1]: 2.0, 4.0, 9.0, 16.0
    # In[2]: 100.0, 1.0, 4.0, 0.0625
    # In[3]: 0.0625, 0.25, 9.0, 16.0
  - Name: Out
    Format: Float16
    Stride: 8
    FillSize: 96
  - Name: ExpectedOut
    Format: Float16
    Stride: 8
    Data: [ 0x0000, 0x3400, 0x0000, 0x0000,
            0x3800, 0x3C00, 0x0000, 0x0000,
            0x3DA8, 0x4000, 0x0000, 0x0000,
            0x3DA8, 0x4000, 0x4200, 0x4400,
            0x4900, 0x3C00, 0x4000, 0x3400,
            0x0000, 0x0000, 0x0000, 0x0000,
            0x3DA8, 0x0000, 0x0000, 0x0000,
            0x4900, 0x0000, 0x0000, 0x0000,
            0x0000, 0x3400, 0x3800, 0x3C00,
            0x3DA8, 0x4000, 0x4200, 0x4400,
            0x4900, 0x3C00, 0x4000, 0x3400,
            0x3400, 0x3800, 0x4200, 0x4400 ]
    # sqrt(0)=0x0000, sqrt(0.0625)=0.25=0x3400, sqrt(0.25)=0.5=0x3800
    # sqrt(1)=0x3C00, sqrt(2)~0x3DA8, sqrt(4)=0x4000
    # sqrt(9)=3=0x4200, sqrt(16)=4=0x4400, sqrt(100)=10=0x4900
Results:
  - Result: Test1
    Rule: BufferFloatULP
    ULPT: 1
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# REQUIRES: Half
# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
