#--- source.hlsl
StructuredBuffer<half4> In : register(t0);
RWStructuredBuffer<half4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  half3x2 r32 = tan(half3x2(In[0].xy, In[0].zw, In[1].xy));
  half2x4 r24 = tan(half2x4(In[1], In[2]));
  half3x1 r31 = tan(half3x1(In[0].x, In[1].x, In[2].x));
  half4x4 r44 = tan(half4x4(In[0], In[1], In[2], In[3]));

  Out[0]  = half4(r32[0], 0.0, 0.0);
  Out[1]  = half4(r32[1], 0.0, 0.0);
  Out[2]  = half4(r32[2], 0.0, 0.0);
  Out[3]  = r24[0];
  Out[4]  = r24[1];
  Out[5]  = half4(r31[0], 0.0, 0.0, 0.0);
  Out[6]  = half4(r31[1], 0.0, 0.0, 0.0);
  Out[7]  = half4(r31[2], 0.0, 0.0, 0.0);
  Out[8]  = r44[0];
  Out[9]  = r44[1];
  Out[10] = r44[2];
  Out[11] = r44[3];
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float16
    Stride: 8
    Data: [ 0xBC30, 0xBA48, 0xB830, 0xB430,
            0x0000, 0x3430, 0x3830, 0x3A48,
            0x3C30, 0xBC30, 0x3430, 0xB430,
            0xBA48, 0x3A48, 0xBC30, 0xB830 ]
    # In[0]: ~-pi/3, ~-pi/4, ~-pi/6, ~-pi/12
    # In[1]: 0, ~pi/12, ~pi/6, ~pi/4
    # In[2]: ~pi/3, ~-pi/3, ~pi/12, ~-pi/12
    # In[3]: ~-pi/4, ~pi/4, ~-pi/3, ~-pi/6
  - Name: Out
    Format: Float16
    Stride: 8
    FillSize: 96
  - Name: ExpectedOut
    Format: Float16
    Stride: 8
    Data: [ 0xBEEE, 0xBC00, 0x0000, 0x0000,
            0xB89E, 0xB44A, 0x0000, 0x0000,
            0x0000, 0x344A, 0x0000, 0x0000,
            0x0000, 0x344A, 0x389E, 0x3C00,
            0x3EEE, 0xBEEE, 0x344A, 0xB44A,
            0xBEEE, 0x0000, 0x0000, 0x0000,
            0x0000, 0x0000, 0x0000, 0x0000,
            0x3EEE, 0x0000, 0x0000, 0x0000,
            0xBEEE, 0xBC00, 0xB89E, 0xB44A,
            0x0000, 0x344A, 0x389E, 0x3C00,
            0x3EEE, 0xBEEE, 0x344A, 0xB44A,
            0xBC00, 0x3C00, 0xBEEE, 0xB89E ]
    # tan(-pi/3)~-sqrt3=0xBEEE, tan(-pi/4)=-1=0xBC00, tan(-pi/6)~-1/sqrt3=0xB89E
    # tan(-pi/12)~-0.268=0xB44A, tan(pi/12)~0.268=0x344A, tan(pi/6)~0x389E, tan(pi/4)=1=0x3C00
    # tan(pi/3)~sqrt3=0x3EEE; sqrt3~1.732=0x3EEE, -sqrt3=0xBEEE
Results:
  - Result: Test1
    Rule: BufferFloatEpsilon
    Epsilon: 0.003
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# REQUIRES: Half
# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
