#--- source.hlsl
StructuredBuffer<half4> In : register(t0);
RWStructuredBuffer<half4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  half3x2 R32 = tan(half3x2(In[0].xyz, In[1].xyz));
  half2x4 R24 = tan(half2x4(In[2], In[3]));
  half3x1 R31 = tan(half3x1(In[4].xyz));
  half4x4 R44 = tan(half4x4(In[5], In[6], In[7], In[8]));
  half2x2 R22 = tan(half2x2(0.0, 0.52359878, 0.78539816, 1.04719755));
  // 0, pi/6, pi/4, pi/3

  Out[0] = half4(R32[0], R32[1]);
  Out[1] = half4(R32[2], 0.0, 0.0);
  Out[2] = R24[0];
  Out[3] = R24[1];
  Out[4] = half4(R31[0], R31[1], R31[2], 0.0);
  Out[5] = R44[0];
  Out[6] = R44[1];
  Out[7] = R44[2];
  Out[8] = R44[3];
  Out[9] = half4(R22[0], R22[1]);
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float16
    Stride: 8
    Data: [ 0xBC30, 0xBA48, 0xB830, 0x0000,
            0xB430, 0x0000, 0x3430, 0x0000,
            0x0000, 0x3430, 0x3830, 0x3A48,
            0x3C30, 0xBC30, 0x3430, 0xB430,
            0xBC30, 0x0000, 0x3C30, 0x0000,
            0xBC30, 0xBA48, 0xB830, 0xB430,
            0x0000, 0x3430, 0x3830, 0x3A48,
            0x3C30, 0xBC30, 0x3430, 0xB430,
            0xBA48, 0x3A48, 0xBC30, 0xB830 ]
    # 3x2: -pi/3, -pi/4, -pi/6, _, -pi/12, 0, pi/12, _
    # 2x4: 0, pi/12, pi/6, pi/4, pi/3, -pi/3, pi/12, -pi/12
    # 3x1: -pi/3, 0, pi/3, _
    # 4x4: -pi/3, -pi/4, -pi/6, -pi/12, 0, pi/12, pi/6, pi/4,
    #      pi/3, -pi/3, pi/12, -pi/12, -pi/4, pi/4, -pi/3, -pi/6
  - Name: Out
    Format: Float16
    Stride: 8
    FillSize: 80
  - Name: ExpectedOut
    Format: Float16
    Stride: 8
    Data: [ 0xBEEE, 0xBC00, 0xB89E, 0xB44A,
            0x0000, 0x344A, 0x0000, 0x0000,
            0x0000, 0x344A, 0x389E, 0x3C00,
            0x3EEE, 0xBEEE, 0x344A, 0xB44A,
            0xBEEE, 0x0000, 0x3EEE, 0x0000,
            0xBEEE, 0xBC00, 0xB89E, 0xB44A,
            0x0000, 0x344A, 0x389E, 0x3C00,
            0x3EEE, 0xBEEE, 0x344A, 0xB44A,
            0xBC00, 0x3C00, 0xBEEE, 0xB89E,
            0x0000, 0x389E, 0x3C00, 0x3EEE ]
    # 3x2: -sqrt3, -1, -sqrt3/3, sqrt3-2, 0, 2-sqrt3, _, _
    # 2x4: 0, 2-sqrt3, sqrt3/3, 1, sqrt3, -sqrt3, 2-sqrt3, sqrt3-2
    # 3x1: -sqrt3, 0, sqrt3, _
    # 4x4: -sqrt3, -1, -sqrt3/3, sqrt3-2, 0, 2-sqrt3, sqrt3/3, 1,
    #      sqrt3, -sqrt3, 2-sqrt3, sqrt3-2, -1, 1, -sqrt3, -sqrt3/3
Results:
  - Result: Test1
    Rule: BufferFloatEpsilon
    Epsilon: 0.003
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# Unimplemented https://github.com/llvm/llvm-project/issues/184520
# XFAIL: Clang

# REQUIRES: Half
# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
