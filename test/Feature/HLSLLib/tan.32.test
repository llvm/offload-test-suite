#--- source.hlsl

StructuredBuffer<float4> In : register(t0);

RWStructuredBuffer<float4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  Out[0] = tan(In[0]);
  Out[1] = float4(tan(In[1].xyz), tan(In[1].w));
  Out[2] = float4(tan(In[2].xy), tan(In[2].zw));
  Out[3] = float4(tan(-314.16), tan(-100), tan(100), tan(314.16));
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float32
    Stride: 16
    Data: [ -1.04719755, -0.78539816, -0.52359878, -0.26179939,
             0.0, 0.26179939, 0.52359878, 0.78539816,
             1.04719755, -1.04719755, 0.26179939, -0.26179939 ]
    # -pi/3, -pi/4, -pi/6, -pi/12
    # 0, pi/12, pi/6, pi/4
    # pi/3, -pi/3, pi/12, -pi/12
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 64
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    Data: [ -1.73205, -1.0, -0.57735, -0.26795,
             0.0, 0.26795, 0.57735, 1.0,
             1.73205, -1.73205, 0.26795, -0.26795,
             -0.0007346412, 0.5872139, -0.5872139, 0.0007346412 ]
    # -sqrt3, -1, -1/sqrt3, sqrt3-2
    # 0, 2-sqrt3, sqrt3/3, 1
    # sqrt3, -sqrt3, 2-sqrt3, sqrt3-2
    # tan(-314.16), tan(-100), tan(100), tan(314.16)
Results:
  - Result: Test1
    Rule: BufferFloatEpsilon
    Epsilon: 0.0008
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
