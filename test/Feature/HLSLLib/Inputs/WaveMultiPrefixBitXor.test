#--- source.hlsl

// Checks signed and unsigned scalars, vectors, and matrices.

#if TYPE_BITS == 16
typedef uint16_t UInt;
typedef int16_t Int;
#elif TYPE_BITS == 64
typedef uint64_t UInt;
typedef int64_t Int;
#else
typedef uint UInt;
typedef int Int;
#endif

typedef vector<UInt, 4> UInt4;
typedef vector<Int, 4> Int4;
#if TEST_MATRIX
typedef matrix<UInt, 2, 3> UInt2x3;
typedef matrix<Int, 2, 3> Int2x3;
#endif

// Negative inputs also test the upper bits at each width.
StructuredBuffer<int4> Inputs : register(t0);
// Expected outputs exclude the input at the current lane.
// Row 0 is for lane 0. Rows 1-4 are later full-wave outputs.
// Rows 5-8 are outputs within later four-lane groups.
// Rows 9-12 are even/odd outputs for later lanes.
StructuredBuffer<int4> ExpectedPrefixResults : register(t3);
RWStructuredBuffer<uint4> OutGroups : register(u1);
RWStructuredBuffer<uint> OutDivergent : register(u2);

static const UInt4 IdentityExpected = UInt4(0, 0, 0, 0);

uint4 laneMask(uint Lane, uint Bits) {
  uint Word = Lane / 32;
  return uint4(Word == 0 ? Bits : 0, Word == 1 ? Bits : 0, Word == 2 ? Bits : 0,
               Word == 3 ? Bits : 0);
}

bool check(UInt4 Value, UInt4 Expected, uint4 Mask) {
  Int4 SignedValue = Int4(Value);
  Int4 SignedExpected = Int4(Expected);
#if TEST_MATRIX
  UInt2x3 UMatrix = UInt2x3(Value.xyz, Value.wxy);
  Int2x3 IMatrix = Int2x3(SignedValue.xyz, SignedValue.wxy);
  UInt2x3 UResult = WaveMultiPrefixBitXor(UMatrix, Mask);
  Int2x3 IResult = WaveMultiPrefixBitXor(IMatrix, Mask);
  UInt2x3 UExpected = UInt2x3(Expected.xyz, Expected.wxy);
  Int2x3 IExpected = Int2x3(SignedExpected.xyz, SignedExpected.wxy);
  bool Passed = true;
  for (uint Row = 0; Row < 2; ++Row)
    for (uint Column = 0; Column < 3; ++Column)
      Passed = Passed && UResult[Row][Column] == UExpected[Row][Column] &&
               IResult[Row][Column] == IExpected[Row][Column];
  return Passed;
#else
  UInt U1 = WaveMultiPrefixBitXor(Value.x, Mask);
  Int I1 = WaveMultiPrefixBitXor(SignedValue.x, Mask);
  vector<UInt, 2> U2 = WaveMultiPrefixBitXor(Value.xy, Mask);
  vector<Int, 2> I2 = WaveMultiPrefixBitXor(SignedValue.xy, Mask);
  vector<UInt, 3> U3 = WaveMultiPrefixBitXor(Value.xyz, Mask);
  vector<Int, 3> I3 = WaveMultiPrefixBitXor(SignedValue.xyz, Mask);
  UInt4 U4 = WaveMultiPrefixBitXor(Value, Mask);
  Int4 I4 = WaveMultiPrefixBitXor(SignedValue, Mask);

  bool Passed = U1 == Expected.x && I1 == SignedExpected.x;
  for (uint Component = 0; Component < 2; ++Component)
    Passed = Passed && U2[Component] == Expected[Component] &&
             I2[Component] == SignedExpected[Component];
  for (uint Component = 0; Component < 3; ++Component)
    Passed = Passed && U3[Component] == Expected[Component] &&
             I3[Component] == SignedExpected[Component];
  for (uint Component = 0; Component < 4; ++Component)
    Passed = Passed && U4[Component] == Expected[Component] &&
             I4[Component] == SignedExpected[Component];
  return Passed;
#endif
}

#ifdef WAVE_SIZE
[WaveSize(WAVE_SIZE)]
#endif
[numthreads(128, 1, 1)]
void main(uint3 TID : SV_GroupThreadID) {
  uint Lane = WaveGetLaneIndex();
  // Lane 0 uses zero instead of the repeated input.
  // This detects a scan that restarts at a later 32-lane boundary.
  UInt4 Value = UInt4(Int4(Inputs[Lane == 0 ? 4 : Lane % 4]));

  // Full wave: include every earlier lane.
  uint4 FullMask = uint4(~0u, ~0u, ~0u, ~0u);
  uint FullExpectedRow = Lane == 0 ? 0 : 1 + Lane % 4;
  UInt4 FullExpected = UInt4(Int4(ExpectedPrefixResults[FullExpectedRow]));
  bool FullPassed = check(Value, FullExpected, FullMask);

  // Even and odd lanes: each group uses only its own earlier lanes.
  uint4 ParityMask =
      Lane % 2 == 0 ? uint4(0x55555555, 0x55555555, 0x55555555, 0x55555555)
                    : uint4(0xAAAAAAAA, 0xAAAAAAAA, 0xAAAAAAAA, 0xAAAAAAAA);
  uint ParityExpectedRow = Lane == 0 ? 0 : 9 + Lane % 4;
  UInt4 ParityExpected = UInt4(Int4(ExpectedPrefixResults[ParityExpectedRow]));
  bool ParityPassed = check(Value, ParityExpected, ParityMask);

  // Four-lane groups: only the first group starts with the zero input.
  uint BlockBitOffset = (Lane % 32) / 4 * 4;
  uint4 BlockMask = laneMask(Lane, 0xFu << BlockBitOffset);
  uint BlockExpectedRow = Lane < 4 ? FullExpectedRow : 5 + Lane % 4;
  UInt4 BlockExpected = UInt4(Int4(ExpectedPrefixResults[BlockExpectedRow]));
  bool BlockPassed = check(Value, BlockExpected, BlockMask);

  // Single lanes: no earlier lane belongs to the group.
  uint4 SingleMask = laneMask(Lane, 1u << (Lane % 32));
  bool SinglePassed = check(Value, IdentityExpected, SingleMask);
  OutGroups[TID.x] =
      uint4(FullPassed, ParityPassed, BlockPassed, SinglePassed);

  // Inactive lanes: only even lanes call the builtin.
  // They expect the same result as the even group above.
  uint Passed = 1;
  if (Lane % 2 == 0)
    Passed = check(Value, ParityExpected, FullMask);
  OutDivergent[TID.x] = Passed;
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: Inputs
    Format: Int32
    Stride: 16
    Data: [
      # Four inputs, repeated across the wave.
      -2, -3, -5, -9,
      -3, -5, -9, -17,
      -2, -3, -5, -9,
      -3, -5, -9, -17,
      # Lane 0 uses this zero input instead.
      0, 0, 0, 0
    ]
  - Name: ExpectedPrefixResults
    Format: Int32
    Stride: 16
    Data: [
      # Row 0: lane 0. Rows 1-4: later lanes with Lane % 4 of 0-3.
      0, 0, 0, 0,
      -2, -3, -5, -9,
      0, 0, 0, 0,
      -3, -5, -9, -17,
      3, 6, 12, 24,
      # Rows 5-8: four-lane groups after the first group.
      0, 0, 0, 0,
      -2, -3, -5, -9,
      3, 6, 12, 24,
      -3, -5, -9, -17,
      # Rows 9-12: even/odd results for Lane % 4 of 0-3, after lane 0.
      -2, -3, -5, -9,
      0, 0, 0, 0,
      0, 0, 0, 0,
      -3, -5, -9, -17
    ]
  - Name: OutGroups
    Format: UInt32
    Stride: 16
    FillSize: 2048
  - Name: ExpectedGroups
    Format: UInt32
    Stride: 16
    FillSize: 2048
    FillValue: 1
  - Name: OutDivergent
    Format: UInt32
    Stride: 4
    FillSize: 512
  - Name: ExpectedDivergent
    Format: UInt32
    Stride: 4
    FillSize: 512
    FillValue: 1
Results:
  - Result: TestGroups
    Rule: BufferExact
    Actual: OutGroups
    Expected: ExpectedGroups
  - Result: TestDivergent
    Rule: BufferExact
    Actual: OutDivergent
    Expected: ExpectedDivergent
DescriptorSets:
  - Resources:
    - Name: Inputs
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: ExpectedPrefixResults
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 3
        Space: 0
      VulkanBinding:
        Binding: 3
    - Name: OutGroups
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: OutDivergent
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
...
