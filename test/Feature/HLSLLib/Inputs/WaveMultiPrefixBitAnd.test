#--- source.hlsl

// Checks signed and unsigned scalars, vectors, and matrices at 16, 32,
// and 64 bits. All cases share the input data and group masks below.
//
// Inputs[Lane % 4] repeats four rows across each wave. The first three
// rows contain negative values; the fourth contains zeros. Conversion
// through Int preserves the sign when the test uses 64-bit values.
//
// ExpectedPrefixResults stores five rows: all ones, input 0, inputs 0 AND 1,
// inputs 0 AND 1 AND 2, and zero. The full-wave check selects row
// min(Lane, 4), because lane 3 supplies zero to every later lane.
//
// The parity masks separate even and odd lanes. Lanes 0 and 1 expect all
// ones. Lanes 2 and 3 expect inputs 0 and 1, respectively. Later even lanes
// expect inputs 0 AND 2, which is (-6, -11, -21, -41). Later odd lanes
// expect zero because their group includes lane 3.
//
// Each four-lane group starts the same input sequence, so its expected row
// is Lane % 4. A single-lane group always expects all ones.
//
// These examples show the first component as a signed value:
// Lane  Input  Full wave  Parity  Four-lane group  Single lane
//    0     -2         -1      -1               -1           -1
//    1     -3         -2      -1               -2           -1
//    2     -5         -4      -2               -4           -1
//    3      0         -8      -3               -8           -1
//    4     -2          0      -6               -1           -1
//    5     -3          0       0               -2           -1
//
// The inactive-lane check excludes lanes where Lane % 3 is 1. Lane 0
// expects all ones. Lane 2 expects input 0. Lane 3 expects inputs 0 AND 2.
// Later active lanes expect zero because lane 3 remains active.
//
// Scalars use the first component; vectors use the first two, three, or
// four components. Matrices repeat the four components in row order.
// The matrix drivers select 3x2, 2x3, 3x1, and 4x4 dimensions.
//
// OutGroups stores four pass flags in this order: full wave, parity,
// four-lane groups, and single lanes. OutDivergent stores one pass flag;
// inactive lanes store 1 without a check. Both expected buffers contain
// only ones, so each checked result must pass.

#include "common.hlsl"

bool check(UInt4 Value, UInt4 Expected, uint4 Mask) {
  Int4 SignedValue = Int4(Value);
  Int4 SignedExpected = Int4(Expected);
  UInt U1 = WaveMultiPrefixBitAnd(Value.x, Mask);
  Int I1 = WaveMultiPrefixBitAnd(SignedValue.x, Mask);
  vector<UInt, 2> U2 = WaveMultiPrefixBitAnd(Value.xy, Mask);
  vector<Int, 2> I2 = WaveMultiPrefixBitAnd(SignedValue.xy, Mask);
  vector<UInt, 3> U3 = WaveMultiPrefixBitAnd(Value.xyz, Mask);
  vector<Int, 3> I3 = WaveMultiPrefixBitAnd(SignedValue.xyz, Mask);
  UInt4 U4 = WaveMultiPrefixBitAnd(Value, Mask);
  Int4 I4 = WaveMultiPrefixBitAnd(SignedValue, Mask);

  bool Passed = U1 == Expected.x && I1 == SignedExpected.x;
  for (uint Component = 0; Component < 2; ++Component)
    Passed = Passed && U2[Component] == Expected[Component] &&
             I2[Component] == SignedExpected[Component];
  for (uint Component = 0; Component < 3; ++Component)
    Passed = Passed && U3[Component] == Expected[Component] &&
             I3[Component] == SignedExpected[Component];
  for (uint Component = 0; Component < 4; ++Component)
    Passed = Passed && U4[Component] == Expected[Component] &&
             I4[Component] == SignedExpected[Component];
  return Passed;
}

#include "main.hlsl"

#--- matrix.hlsl

#include "common.hlsl"

typedef matrix<UInt, MATRIX_ROWS, MATRIX_COLS> UIntMatrix;
typedef matrix<Int, MATRIX_ROWS, MATRIX_COLS> IntMatrix;

bool check(UInt4 Value, UInt4 Expected, uint4 Mask) {
  UIntMatrix UMatrix;
  UIntMatrix UExpected;
  for (uint Row = 0; Row < MATRIX_ROWS; ++Row)
    for (uint Column = 0; Column < MATRIX_COLS; ++Column) {
      uint Component = (Row * MATRIX_COLS + Column) % 4;
      UMatrix[Row][Column] = Value[Component];
      UExpected[Row][Column] = Expected[Component];
    }

  IntMatrix IMatrix = IntMatrix(UMatrix);
  IntMatrix IExpected = IntMatrix(UExpected);
  UIntMatrix UResult = WaveMultiPrefixBitAnd(UMatrix, Mask);
  IntMatrix IResult = WaveMultiPrefixBitAnd(IMatrix, Mask);
  bool Passed = true;
  for (uint Row = 0; Row < MATRIX_ROWS; ++Row)
    for (uint Column = 0; Column < MATRIX_COLS; ++Column)
      Passed = Passed && UResult[Row][Column] == UExpected[Row][Column] &&
               IResult[Row][Column] == IExpected[Row][Column];
  return Passed;
}

#include "main.hlsl"

#--- common.hlsl

#if TYPE_BITS == 16
typedef uint16_t UInt;
typedef int16_t Int;
#elif TYPE_BITS == 64
typedef uint64_t UInt;
typedef int64_t Int;
#else
typedef uint UInt;
typedef int Int;
#endif

typedef vector<UInt, 4> UInt4;
typedef vector<Int, 4> Int4;

StructuredBuffer<int4> Inputs : register(t0);
StructuredBuffer<int4> ExpectedPrefixResults : register(t3);
RWStructuredBuffer<uint4> OutGroups : register(u1);
RWStructuredBuffer<uint> OutDivergent : register(u2);

static const UInt4 IdentityExpected = ~UInt4(0, 0, 0, 0);
static const UInt4 ZeroExpected = UInt4(0, 0, 0, 0);

static const UInt4 Inputs0And2Expected = UInt4(Int4(-6, -11, -21, -41));

uint4 laneMask(uint Lane, uint Bits) {
  uint Word = Lane / 32;
  return uint4(Word == 0 ? Bits : 0, Word == 1 ? Bits : 0, Word == 2 ? Bits : 0,
               Word == 3 ? Bits : 0);
}

#--- main.hlsl

#ifdef WAVE_SIZE
[WaveSize(WAVE_SIZE)]
#endif
[numthreads(128, 1, 1)]
void main(uint3 TID : SV_GroupThreadID) {
  uint Lane = WaveGetLaneIndex();
  UInt4 Value = UInt4(Int4(Inputs[Lane % 4]));

  uint4 FullMask = uint4(~0u, ~0u, ~0u, ~0u);
  UInt4 FullExpected = UInt4(Int4(ExpectedPrefixResults[min(Lane, 4u)]));
  bool FullPassed = check(Value, FullExpected, FullMask);

  uint4 ParityMask =
      Lane % 2 == 0 ? uint4(0x55555555, 0x55555555, 0x55555555, 0x55555555)
                    : uint4(0xAAAAAAAA, 0xAAAAAAAA, 0xAAAAAAAA, 0xAAAAAAAA);
  UInt4 ParityExpected = IdentityExpected;
  if (Lane == 2 || Lane == 3)
    ParityExpected = UInt4(Int4(Inputs[Lane - 2]));
  else if (Lane >= 4)
    ParityExpected = Lane % 2 == 0 ? Inputs0And2Expected : ZeroExpected;
  bool ParityPassed = check(Value, ParityExpected, ParityMask);

  uint BlockBitOffset = (Lane % 32) / 4 * 4;
  uint4 BlockMask = laneMask(Lane, 0xFu << BlockBitOffset);
  UInt4 BlockExpected = UInt4(Int4(ExpectedPrefixResults[Lane % 4]));
  bool BlockPassed = check(Value, BlockExpected, BlockMask);

  uint4 SingleMask = laneMask(Lane, 1u << (Lane % 32));
  bool SinglePassed = check(Value, IdentityExpected, SingleMask);

  OutGroups[TID.x] =
      uint4(FullPassed, ParityPassed, BlockPassed, SinglePassed);

  uint Passed = 1;
  if (Lane % 3 != 1) {
    UInt4 Expected = ZeroExpected;
    if (Lane == 0)
      Expected = IdentityExpected;
    else if (Lane == 2)
      Expected = UInt4(Int4(ExpectedPrefixResults[1]));
    else if (Lane == 3)
      Expected = Inputs0And2Expected;
    Passed = check(Value, Expected, FullMask);
  }
  OutDivergent[TID.x] = Passed;
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: Inputs
    Format: Int32
    Stride: 16
    Data: [
      -2, -3, -5, -9,
      -3, -5, -9, -17,
      -5, -9, -17, -33,
      0, 0, 0, 0
    ]
  - Name: ExpectedPrefixResults
    Format: Int32
    Stride: 16
    Data: [
      -1, -1, -1, -1,
      -2, -3, -5, -9,
      -4, -7, -13, -25,
      -8, -15, -29, -57,
      0, 0, 0, 0
    ]
  - Name: OutGroups
    Format: UInt32
    Stride: 16
    FillSize: 2048
  - Name: ExpectedGroups
    Format: UInt32
    Stride: 16
    FillSize: 2048
    FillValue: 1
  - Name: OutDivergent
    Format: UInt32
    Stride: 4
    FillSize: 512
  - Name: ExpectedDivergent
    Format: UInt32
    Stride: 4
    FillSize: 512
    FillValue: 1
Results:
  - Result: TestGroups
    Rule: BufferExact
    Actual: OutGroups
    Expected: ExpectedGroups
  - Result: TestDivergent
    Rule: BufferExact
    Actual: OutDivergent
    Expected: ExpectedDivergent
DescriptorSets:
  - Resources:
    - Name: Inputs
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: ExpectedPrefixResults
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 3
        Space: 0
      VulkanBinding:
        Binding: 3
    - Name: OutGroups
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: OutDivergent
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
...
