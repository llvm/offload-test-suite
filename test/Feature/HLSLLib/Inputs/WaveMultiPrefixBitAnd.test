#--- source.hlsl

// Checks signed and unsigned scalars, vectors, and matrices.

#if TYPE_BITS == 16
typedef uint16_t UInt;
typedef int16_t Int;
#elif TYPE_BITS == 64
typedef uint64_t UInt;
typedef int64_t Int;
#else
typedef uint UInt;
typedef int Int;
#endif

typedef vector<UInt, 4> UInt4;
typedef vector<Int, 4> Int4;
#if TEST_MATRIX
typedef matrix<UInt, 2, 3> UInt2x3;
typedef matrix<Int, 2, 3> Int2x3;
#endif

// Negative inputs keep the upper bits set for all tested integer widths.
StructuredBuffer<int4> Inputs : register(t0);
// Fixed expected outputs for lanes 0-4, excluding each lane's own input.
// Row 0: all ones. Row 1: input 0. Row 2: input 0 AND input 1.
// Row 3: input 0 AND input 1 AND input 2.
// Row 4: zero because input 3 is zero; later lanes also expect zero.
StructuredBuffer<int4> ExpectedPrefixResults : register(t3);
RWStructuredBuffer<uint4> OutGroups : register(u1);
RWStructuredBuffer<uint> OutDivergent : register(u2);

static const UInt4 IdentityExpected = ~UInt4(0, 0, 0, 0);
static const UInt4 ZeroExpected = UInt4(0, 0, 0, 0);

// Expected AND of input rows 0 and 2.
static const UInt4 Inputs0And2Expected = UInt4(Int4(-6, -11, -21, -41));

uint4 laneMask(uint Lane, uint Bits) {
  uint Word = Lane / 32;
  return uint4(Word == 0 ? Bits : 0, Word == 1 ? Bits : 0, Word == 2 ? Bits : 0,
               Word == 3 ? Bits : 0);
}

bool check(UInt4 Value, UInt4 Expected, uint4 Mask) {
  Int4 SignedValue = Int4(Value);
  Int4 SignedExpected = Int4(Expected);
#if TEST_MATRIX
  UInt2x3 UMatrix = UInt2x3(Value.xyz, Value.wxy);
  Int2x3 IMatrix = Int2x3(SignedValue.xyz, SignedValue.wxy);
  UInt2x3 UResult = WaveMultiPrefixBitAnd(UMatrix, Mask);
  Int2x3 IResult = WaveMultiPrefixBitAnd(IMatrix, Mask);
  UInt2x3 UExpected = UInt2x3(Expected.xyz, Expected.wxy);
  Int2x3 IExpected = Int2x3(SignedExpected.xyz, SignedExpected.wxy);
  bool Passed = true;
  for (uint Row = 0; Row < 2; ++Row)
    for (uint Column = 0; Column < 3; ++Column)
      Passed = Passed && UResult[Row][Column] == UExpected[Row][Column] &&
               IResult[Row][Column] == IExpected[Row][Column];
  return Passed;
#else
  UInt U1 = WaveMultiPrefixBitAnd(Value.x, Mask);
  Int I1 = WaveMultiPrefixBitAnd(SignedValue.x, Mask);
  vector<UInt, 2> U2 = WaveMultiPrefixBitAnd(Value.xy, Mask);
  vector<Int, 2> I2 = WaveMultiPrefixBitAnd(SignedValue.xy, Mask);
  vector<UInt, 3> U3 = WaveMultiPrefixBitAnd(Value.xyz, Mask);
  vector<Int, 3> I3 = WaveMultiPrefixBitAnd(SignedValue.xyz, Mask);
  UInt4 U4 = WaveMultiPrefixBitAnd(Value, Mask);
  Int4 I4 = WaveMultiPrefixBitAnd(SignedValue, Mask);

  bool Passed = U1 == Expected.x && I1 == SignedExpected.x;
  for (uint Component = 0; Component < 2; ++Component)
    Passed = Passed && U2[Component] == Expected[Component] &&
             I2[Component] == SignedExpected[Component];
  for (uint Component = 0; Component < 3; ++Component)
    Passed = Passed && U3[Component] == Expected[Component] &&
             I3[Component] == SignedExpected[Component];
  for (uint Component = 0; Component < 4; ++Component)
    Passed = Passed && U4[Component] == Expected[Component] &&
             I4[Component] == SignedExpected[Component];
  return Passed;
#endif
}

#ifdef WAVE_SIZE
[WaveSize(WAVE_SIZE)]
#endif
[numthreads(128, 1, 1)]
void main(uint3 TID : SV_GroupThreadID) {
  uint Lane = WaveGetLaneIndex();
  UInt4 Value = UInt4(Int4(Inputs[Lane % 4]));

  // Full wave: lane 3 supplies zero, so later lanes must return zero.
  uint4 FullMask = uint4(~0u, ~0u, ~0u, ~0u);
  UInt4 FullExpected = UInt4(Int4(ExpectedPrefixResults[min(Lane, 4u)]));
  bool FullPassed = check(Value, FullExpected, FullMask);

  // Even and odd lanes: only the odd group includes the zero inputs.
  uint4 ParityMask =
      Lane % 2 == 0 ? uint4(0x55555555, 0x55555555, 0x55555555, 0x55555555)
                    : uint4(0xAAAAAAAA, 0xAAAAAAAA, 0xAAAAAAAA, 0xAAAAAAAA);
  UInt4 ParityExpected = IdentityExpected;
  if (Lane == 2 || Lane == 3)
    ParityExpected = UInt4(Int4(Inputs[Lane - 2]));
  else if (Lane >= 4)
    ParityExpected = Lane % 2 == 0 ? Inputs0And2Expected : ZeroExpected;
  bool ParityPassed = check(Value, ParityExpected, ParityMask);

  // Four-lane groups: each group starts the same four-input sequence.
  uint BlockBitOffset = (Lane % 32) / 4 * 4;
  uint4 BlockMask = laneMask(Lane, 0xFu << BlockBitOffset);
  UInt4 BlockExpected = UInt4(Int4(ExpectedPrefixResults[Lane % 4]));
  bool BlockPassed = check(Value, BlockExpected, BlockMask);

  // Single lanes: no earlier lane belongs to the group.
  uint4 SingleMask = laneMask(Lane, 1u << (Lane % 32));
  bool SinglePassed = check(Value, IdentityExpected, SingleMask);

  OutGroups[TID.x] =
      uint4(FullPassed, ParityPassed, BlockPassed, SinglePassed);

  // Inactive lanes: exclude every third lane, starting at lane 1.
  // Lane 3 supplies zero, so later active lanes must return zero.
  uint Passed = 1;
  if (Lane % 3 != 1) {
    UInt4 Expected = ZeroExpected;
    if (Lane == 0)
      Expected = IdentityExpected;
    else if (Lane == 2)
      Expected = UInt4(Int4(ExpectedPrefixResults[1]));
    else if (Lane == 3)
      Expected = Inputs0And2Expected;
    Passed = check(Value, Expected, FullMask);
  }
  OutDivergent[TID.x] = Passed;
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: Inputs
    Format: Int32
    Stride: 16
    Data: [
      # Four inputs, repeated across the wave.
      -2, -3, -5, -9,
      -3, -5, -9, -17,
      -5, -9, -17, -33,
      0, 0, 0, 0
    ]
  - Name: ExpectedPrefixResults
    Format: Int32
    Stride: 16
    Data: [
      # Five prefix results, starting with the all-ones identity.
      -1, -1, -1, -1,
      -2, -3, -5, -9,
      -4, -7, -13, -25,
      -8, -15, -29, -57,
      0, 0, 0, 0
    ]
  - Name: OutGroups
    Format: UInt32
    Stride: 16
    FillSize: 2048
  - Name: ExpectedGroups
    Format: UInt32
    Stride: 16
    FillSize: 2048
    FillValue: 1
  - Name: OutDivergent
    Format: UInt32
    Stride: 4
    FillSize: 512
  - Name: ExpectedDivergent
    Format: UInt32
    Stride: 4
    FillSize: 512
    FillValue: 1
Results:
  - Result: TestGroups
    Rule: BufferExact
    Actual: OutGroups
    Expected: ExpectedGroups
  - Result: TestDivergent
    Rule: BufferExact
    Actual: OutDivergent
    Expected: ExpectedDivergent
DescriptorSets:
  - Resources:
    - Name: Inputs
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: ExpectedPrefixResults
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 3
        Space: 0
      VulkanBinding:
        Binding: 3
    - Name: OutGroups
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: OutDivergent
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
...
