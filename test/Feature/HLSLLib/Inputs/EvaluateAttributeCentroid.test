#--- vertex.hlsl
struct VSOutput {
  float4 Pos : SV_Position;
  TYPE S : ATTR0;
  vector<TYPE, 2> V2 : ATTR1;
  vector<TYPE, 3> V3 : ATTR2;
  vector<TYPE, 4> V4 : ATTR3;
};

VSOutput main(float2 Position : POSITION) {
  // Pixel coordinate of this vertex in the 1x1 render target.
  float2 P = float2(Position.x + 1, 1 - Position.y) / 2;
  VSOutput O;
  O.Pos = float4(Position, 0, 1);
  O.S = (TYPE)P.x;
  O.V2 = (vector<TYPE, 2>)P;
  O.V3 = (vector<TYPE, 3>)P.xyx;
  O.V4 = (vector<TYPE, 4>)P.xyxy;
  return O;
}

#--- pixel.hlsl
struct PSInput {
  float4 Pos : SV_Position;
  TYPE S : ATTR0;
  vector<TYPE, 2> V2 : ATTR1;
  vector<TYPE, 3> V3 : ATTR2;
  vector<TYPE, 4> V4 : ATTR3;
};

// Half results are widened to float (exact) so the buffer stays 32-bit.
RWStructuredBuffer<float4> Out : register(u0);

float4 main(PSInput I) : SV_Target {
  Out[0] = float4(EvaluateAttributeCentroid(I.S), 0, 0, 0);
  Out[1] = float4(EvaluateAttributeCentroid(I.V2), 0, 0);
  Out[2] = float4(EvaluateAttributeCentroid(I.V3), 0);
  Out[3] = EvaluateAttributeCentroid(I.V4);
  return 0;
}

#--- pipeline.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
Buffers:
  - Name: VertexData
    Format: Float32
    Stride: 8
    Data: [-1, -1, 3, -1, -1, 3]
  - Name: RenderTarget
    Format: Float32
    Channels: 4
    FillSize: 16
    OutputProps:
      Height: 1
      Width: 1
      Depth: 1
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 64
    FillValue: 100 # Any value the shader does not write fails.
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    Data: [0.5, 0, 0, 0,
           0.5, 0.5, 0, 0,
           0.5, 0.5, 0.5, 0,
           0.5, 0.5, 0.5, 0.5]
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 2
      Offset: 0
      Name: POSITION
  RenderTarget: RenderTarget
DescriptorSets:
  - Resources:
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
Results:
  - Result: Evaluate
    Rule: BufferFloatEpsilon
    Epsilon: 0.001
    Actual: Out
    Expected: ExpectedOut
...
#--- end

# Without MSAA the centroid is the pixel center, (0.5, 0.5).
