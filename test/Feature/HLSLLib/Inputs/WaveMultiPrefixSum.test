#--- source.hlsl

// Checks integer and floating-point scalars, vectors, and matrices.

#if TEST_FLOAT
#if TYPE_BITS == 16
typedef float16_t Element;
#elif TYPE_BITS == 64
typedef double Element;
#else
typedef float Element;
#endif
#else
#if TYPE_BITS == 16
typedef int16_t Element;
typedef uint16_t UnsignedElement;
#elif TYPE_BITS == 64
typedef int64_t Element;
typedef uint64_t UnsignedElement;
#else
typedef int Element;
typedef uint UnsignedElement;
#endif
typedef vector<UnsignedElement, 4> Unsigned4;
#if TEST_MATRIX
typedef matrix<UnsignedElement, 2, 3> Unsigned2x3;
#endif
#endif

typedef vector<Element, 4> Value4;
#if TEST_MATRIX
typedef matrix<Element, 2, 3> Value2x3;
#endif

// Select separate input and expected buffers for the tested element type.
#if TEST_FLOAT
#if TYPE_BITS == 64
StructuredBuffer<double4> Inputs : register(t3);
StructuredBuffer<double4> ExpectedPrefixResults : register(t9);
#else
StructuredBuffer<float4> Inputs : register(t2);
StructuredBuffer<float4> ExpectedPrefixResults : register(t8);
#endif
#else
#if TYPE_BITS == 64
StructuredBuffer<Value4> Inputs : register(t1);
StructuredBuffer<Value4> ExpectedPrefixResults : register(t7);
#else
StructuredBuffer<int4> Inputs : register(t0);
StructuredBuffer<int4> ExpectedPrefixResults : register(t6);
#endif
#endif
RWStructuredBuffer<uint4> OutGroups : register(u4);
RWStructuredBuffer<uint> OutDivergent : register(u5);

static const Value4 IdentityExpected = Value4(0, 0, 0, 0);

uint4 laneMask(uint Lane, uint Bits) {
  uint Word = Lane / 32;
  return uint4(Word == 0 ? Bits : 0, Word == 1 ? Bits : 0, Word == 2 ? Bits : 0,
               Word == 3 ? Bits : 0);
}

bool check(Value4 Value, Value4 Expected, uint4 Mask) {
#if TEST_MATRIX
  Value2x3 Matrix = Value2x3(Value.xyz, Value.wxy);
  Value2x3 Result = WaveMultiPrefixSum(Matrix, Mask);
  Value2x3 MatrixExpected = Value2x3(Expected.xyz, Expected.wxy);
#if !TEST_FLOAT
  Unsigned2x3 UResult = WaveMultiPrefixSum(Unsigned2x3(Matrix), Mask);
  Unsigned2x3 UExpected = Unsigned2x3(MatrixExpected);
#endif
  bool Passed = true;
  for (uint Row = 0; Row < 2; ++Row)
    for (uint Column = 0; Column < 3; ++Column) {
      Passed = Passed && Result[Row][Column] == MatrixExpected[Row][Column];
#if !TEST_FLOAT
      Passed = Passed && UResult[Row][Column] == UExpected[Row][Column];
#endif
    }
  return Passed;
#else
  Element R1 = WaveMultiPrefixSum(Value.x, Mask);
  vector<Element, 2> R2 = WaveMultiPrefixSum(Value.xy, Mask);
  vector<Element, 3> R3 = WaveMultiPrefixSum(Value.xyz, Mask);
  Value4 R4 = WaveMultiPrefixSum(Value, Mask);
#if !TEST_FLOAT
  Unsigned4 UValue = Unsigned4(Value);
  Unsigned4 UExpected = Unsigned4(Expected);
  UnsignedElement U1 = WaveMultiPrefixSum(UValue.x, Mask);
  vector<UnsignedElement, 2> U2 = WaveMultiPrefixSum(UValue.xy, Mask);
  vector<UnsignedElement, 3> U3 = WaveMultiPrefixSum(UValue.xyz, Mask);
  Unsigned4 U4 = WaveMultiPrefixSum(UValue, Mask);
#endif

  bool Passed = R1 == Expected.x;
#if !TEST_FLOAT
  Passed = Passed && U1 == UExpected.x;
#endif
  for (uint Component = 0; Component < 2; ++Component) {
    Passed = Passed && R2[Component] == Expected[Component];
#if !TEST_FLOAT
    Passed = Passed && U2[Component] == UExpected[Component];
#endif
  }
  for (uint Component = 0; Component < 3; ++Component) {
    Passed = Passed && R3[Component] == Expected[Component];
#if !TEST_FLOAT
    Passed = Passed && U3[Component] == UExpected[Component];
#endif
  }
  for (uint Component = 0; Component < 4; ++Component) {
    Passed = Passed && R4[Component] == Expected[Component];
#if !TEST_FLOAT
    Passed = Passed && U4[Component] == UExpected[Component];
#endif
  }
  return Passed;
#endif
}

#ifdef WAVE_SIZE
[WaveSize(WAVE_SIZE)]
#endif
[numthreads(128, 1, 1)]
void main(uint3 TID : SV_GroupThreadID) {
  uint Lane = WaveGetLaneIndex();
  Value4 Value = Value4(Inputs[Lane % 4]);

  // Full wave: include every earlier lane.
  // Rows 0-3 hold outputs before each input in a four-lane sequence.
  // Row 4 holds the sum of all four inputs.
  // Add this sum once for each complete sequence before the current lane.
  uint4 FullMask = uint4(~0u, ~0u, ~0u, ~0u);
  Value4 FullExpected = Value4(ExpectedPrefixResults[Lane % 4]) +
      Value4(ExpectedPrefixResults[4]) * Element(Lane / 4);
  bool FullPassed = check(Value, FullExpected, FullMask);

  // Even and odd lanes: each group uses only its own earlier lanes.
  uint4 ParityMask =
      Lane % 2 == 0 ? uint4(0x55555555, 0x55555555, 0x55555555, 0x55555555)
                    : uint4(0xAAAAAAAA, 0xAAAAAAAA, 0xAAAAAAAA, 0xAAAAAAAA);
  // Rows 5-8 hold outputs before the first two inputs of each parity group.
  // Rows 9 and 10 hold the sum of one even pair and one odd pair.
  // Add the pair sum once for each complete pair before the current lane.
  Value4 ParityExpected = Value4(ExpectedPrefixResults[5 + Lane % 4]) +
      Value4(ExpectedPrefixResults[9 + Lane % 2]) * Element(Lane / 4);
  bool ParityPassed = check(Value, ParityExpected, ParityMask);

  // Four-lane groups: each group starts the same four-input sequence.
  uint BlockBitOffset = (Lane % 32) / 4 * 4;
  uint4 BlockMask = laneMask(Lane, 0xFu << BlockBitOffset);
  Value4 BlockExpected = Value4(ExpectedPrefixResults[Lane % 4]);
  bool BlockPassed = check(Value, BlockExpected, BlockMask);

  // Single lanes: no earlier lane belongs to the group.
  uint4 SingleMask = laneMask(Lane, 1u << (Lane % 32));
  bool SinglePassed = check(Value, IdentityExpected, SingleMask);
  OutGroups[TID.x] =
      uint4(FullPassed, ParityPassed, BlockPassed, SinglePassed);

  // Inactive lanes: only even lanes call the builtin.
  // They expect the same result as the even group above.
  uint Passed = 1;
  if (Lane % 2 == 0)
    Passed = check(Value, ParityExpected, FullMask);
  OutDivergent[TID.x] = Passed;
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: IntegerInputs
    Format: Int32
    Stride: 16
    Data: [
      # Four inputs, repeated across the wave.
      -2, 3, -4, 5,
      3, -5, 9, -17,
      1, -1, 2, -2,
      0, 0, 0, 0
    ]
  - Name: IntegerExpectedPrefixResults
    Format: Int32
    Stride: 16
    Data: [
      # Rows 0-4: full-wave outputs for lanes 0-4, excluding each lane.
      0, 0, 0, 0,
      -2, 3, -4, 5,
      1, -2, 5, -12,
      2, -3, 7, -14,
      2, -3, 7, -14,
      # Rows 5-8: partial even/odd outputs, indexed by Lane % 4.
      0, 0, 0, 0,
      0, 0, 0, 0,
      -2, 3, -4, 5,
      3, -5, 9, -17,
      # Rows 9-10: sums for one complete pair in each parity group.
      -1, 2, -2, 3,
      3, -5, 9, -17
    ]
  - Name: Integer64Inputs
    Format: Int64
    Stride: 32
    Data: [
      # Four inputs, repeated across the wave.
      -4294967298, 4294967299, -4294967300, 4294967301,
      4294967303, -4294967305, 4294967307, -4294967309,
      1, -1, 2, -2,
      0, 0, 0, 0
    ]
  - Name: Integer64ExpectedPrefixResults
    Format: Int64
    Stride: 32
    Data: [
      # Rows 0-4: full-wave outputs for lanes 0-4, excluding each lane.
      0, 0, 0, 0,
      -4294967298, 4294967299, -4294967300, 4294967301,
      5, -6, 7, -8,
      6, -7, 9, -10,
      6, -7, 9, -10,
      # Rows 5-8: partial even/odd outputs, indexed by Lane % 4.
      0, 0, 0, 0,
      0, 0, 0, 0,
      -4294967298, 4294967299, -4294967300, 4294967301,
      4294967303, -4294967305, 4294967307, -4294967309,
      # Rows 9-10: sums for one complete pair in each parity group.
      -4294967297, 4294967298, -4294967298, 4294967299,
      4294967303, -4294967305, 4294967307, -4294967309
    ]
  - Name: FloatInputs
    Format: Float32
    Stride: 16
    Data: [
      # Four inputs, repeated across the wave.
      -1.5, 2.5, -3.5, 4.5,
      0.75, -1.25, 2.75, -3.25,
      1, -1, 2, -2,
      0, 0, 0, 0
    ]
  - Name: FloatExpectedPrefixResults
    Format: Float32
    Stride: 16
    Data: [
      # Rows 0-4: full-wave outputs for lanes 0-4, excluding each lane.
      0, 0, 0, 0,
      -1.5, 2.5, -3.5, 4.5,
      -0.75, 1.25, -0.75, 1.25,
      0.25, 0.25, 1.25, -0.75,
      0.25, 0.25, 1.25, -0.75,
      # Rows 5-8: partial even/odd outputs, indexed by Lane % 4.
      0, 0, 0, 0,
      0, 0, 0, 0,
      -1.5, 2.5, -3.5, 4.5,
      0.75, -1.25, 2.75, -3.25,
      # Rows 9-10: sums for one complete pair in each parity group.
      -0.5, 1.5, -1.5, 2.5,
      0.75, -1.25, 2.75, -3.25
    ]
  - Name: DoubleInputs
    Format: Float64
    Stride: 32
    Data: [
      # Four inputs, repeated across the wave.
      -4294967296.5, 4294967297.5, -4294967298.5, 4294967299.5,
      0.25, -0.5, 0.75, -1.0,
      1, -1, 2, -2,
      0, 0, 0, 0
    ]
  - Name: DoubleExpectedPrefixResults
    Format: Float64
    Stride: 32
    Data: [
      # Rows 0-4: full-wave outputs for lanes 0-4, excluding each lane.
      0, 0, 0, 0,
      -4294967296.5, 4294967297.5, -4294967298.5, 4294967299.5,
      -4294967296.25, 4294967297.0, -4294967297.75, 4294967298.5,
      -4294967295.25, 4294967296.0, -4294967295.75, 4294967296.5,
      -4294967295.25, 4294967296.0, -4294967295.75, 4294967296.5,
      # Rows 5-8: partial even/odd outputs, indexed by Lane % 4.
      0, 0, 0, 0,
      0, 0, 0, 0,
      -4294967296.5, 4294967297.5, -4294967298.5, 4294967299.5,
      0.25, -0.5, 0.75, -1.0,
      # Rows 9-10: sums for one complete pair in each parity group.
      -4294967295.5, 4294967296.5, -4294967296.5, 4294967297.5,
      0.25, -0.5, 0.75, -1.0
    ]
  - Name: OutGroups
    Format: UInt32
    Stride: 16
    FillSize: 2048
  - Name: ExpectedGroups
    Format: UInt32
    Stride: 16
    FillSize: 2048
    FillValue: 1
  - Name: OutDivergent
    Format: UInt32
    Stride: 4
    FillSize: 512
  - Name: ExpectedDivergent
    Format: UInt32
    Stride: 4
    FillSize: 512
    FillValue: 1
Results:
  - Result: TestGroups
    Rule: BufferExact
    Actual: OutGroups
    Expected: ExpectedGroups
  - Result: TestDivergent
    Rule: BufferExact
    Actual: OutDivergent
    Expected: ExpectedDivergent
DescriptorSets:
  - Resources:
    - Name: IntegerInputs
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Integer64Inputs
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: FloatInputs
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
    - Name: DoubleInputs
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 3
        Space: 0
      VulkanBinding:
        Binding: 3
    - Name: IntegerExpectedPrefixResults
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 6
        Space: 0
      VulkanBinding:
        Binding: 6
    - Name: Integer64ExpectedPrefixResults
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 7
        Space: 0
      VulkanBinding:
        Binding: 7
    - Name: FloatExpectedPrefixResults
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 8
        Space: 0
      VulkanBinding:
        Binding: 8
    - Name: DoubleExpectedPrefixResults
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 9
        Space: 0
      VulkanBinding:
        Binding: 9
    - Name: OutGroups
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 4
        Space: 0
      VulkanBinding:
        Binding: 4
    - Name: OutDivergent
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 5
        Space: 0
      VulkanBinding:
        Binding: 5
...
