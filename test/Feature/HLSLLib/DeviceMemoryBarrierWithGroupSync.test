#--- source.hlsl

// Tests DeviceMemoryBarrierWithGroupSync with UAV memory.
// Divergent calls are undefined and are not tested.

RWStructuredBuffer<uint> Counter : register(u0);
RWStructuredBuffer<uint> Out : register(u1);

[numthreads(512, 1, 1)]
void main(uint3 GTID : SV_GroupThreadID) {
  if (GTID.x == 511)
    Counter[0] = 1;

  DeviceMemoryBarrierWithGroupSync();

  if (GTID.x == 0)
    Out[0] = Counter[0];

  DeviceMemoryBarrierWithGroupSync();

  for (uint I = 0; I < 512; ++I) {
    if (GTID.x == I)
      Counter[0]++;

    DeviceMemoryBarrierWithGroupSync();
  }

  if (GTID.x == 256)
    Out[1] = Counter[0];
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: Counter
    Format: UInt32
    Stride: 4
    FillSize: 4
  - Name: Out
    Format: UInt32
    Stride: 4
    FillSize: 8
  - Name: ExpectedOut
    Format: UInt32
    Stride: 4
    Data: [ 1, 513 ]
Results:
  - Result: TestDeviceMemoryBarrierWithGroupSync
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: Counter
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
