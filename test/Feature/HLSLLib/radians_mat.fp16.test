#--- source.hlsl
StructuredBuffer<half4> In : register(t0);
RWStructuredBuffer<half4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  half3x2 r32 = radians(half3x2(In[0].xy, In[0].zw, In[1].xy));
  half2x4 r24 = radians(half2x4(In[1], In[2]));
  half3x1 r31 = radians(half3x1(In[0].x, In[2].x, In[2].y));
  half4x4 r44 = radians(half4x4(In[0], In[1], In[2], In[3]));

  Out[0]  = half4(r32[0], 0.0, 0.0);
  Out[1]  = half4(r32[1], 0.0, 0.0);
  Out[2]  = half4(r32[2], 0.0, 0.0);
  Out[3]  = r24[0];
  Out[4]  = r24[1];
  Out[5]  = half4(r31[0], 0.0, 0.0, 0.0);
  Out[6]  = half4(r31[1], 0.0, 0.0, 0.0);
  Out[7]  = half4(r31[2], 0.0, 0.0, 0.0);
  Out[8]  = r44[0];
  Out[9]  = r44[1];
  Out[10] = r44[2];
  Out[11] = r44[3];
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float16
    Stride: 8
    Data: [ 0x0000, 0x4F80, 0x51A0, 0x5380,
            0x55A0, 0x59A0, 0x5C38, 0x5DA0,
            0xD1A0, 0xD5A0, 0xD9A0, 0x4B80,
            0x4F80, 0x55A0, 0x4B80, 0x51A0 ]
    # In[0]: 0, 30, 45, 60 (0x5380=60)
    # In[1]: 90, 180, 270, 360
    # In[2]: -45, -90, -180, 15 (0x4B80=15)
    # In[3]: 30, 90, 15, 45
  - Name: Out
    Format: Float16
    Stride: 8
    FillSize: 96
  - Name: ExpectedOut
    Format: Float16
    Stride: 8
    Data: [ 0x0000, 0x3830, 0x0000, 0x0000,
            0x3A48, 0x3C30, 0x0000, 0x0000,
            0x3E48, 0x4248, 0x0000, 0x0000,
            0x3E48, 0x4248, 0x44B6, 0x4648,
            0xBA48, 0xBE48, 0xC248, 0x3430,
            0x0000, 0x0000, 0x0000, 0x0000,
            0xBA48, 0x0000, 0x0000, 0x0000,
            0xBE48, 0x0000, 0x0000, 0x0000,
            0x0000, 0x3830, 0x3A48, 0x3C30,
            0x3E48, 0x4248, 0x44B6, 0x4648,
            0xBA48, 0xBE48, 0xC248, 0x3430,
            0x3830, 0x3E48, 0x3430, 0x3A48 ]
    # 0=0x0000, pi/12~0x3430, pi/6~0x3830, pi/4~0x3A48, pi/3~0x3C30
    # pi/2~0x3E48, pi~0x4248, 3pi/2~0x44B6, 2pi~0x4648
    # negatives: -pi/4~0xBA48, -pi/2~0xBE48, -pi~0xC248
Results:
  - Result: Test1
    Rule: BufferFloatULP
    ULPT: 2
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# REQUIRES: Half
# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
