#--- source.hlsl
StructuredBuffer<float4> In : register(t0);
RWStructuredBuffer<float4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  float3x2 r32 = radians(float3x2(In[0].xy, In[0].zw, In[1].xy));
  float2x4 r24 = radians(float2x4(In[1], In[2]));
  float3x1 r31 = radians(float3x1(In[0].x, In[2].x, In[2].y));
  float4x4 r44 = radians(float4x4(In[0], In[1], In[2], In[3]));

  Out[0]  = float4(r32[0], 0.0, 0.0);
  Out[1]  = float4(r32[1], 0.0, 0.0);
  Out[2]  = float4(r32[2], 0.0, 0.0);
  Out[3]  = r24[0];
  Out[4]  = r24[1];
  Out[5]  = float4(r31[0], 0.0, 0.0, 0.0);
  Out[6]  = float4(r31[1], 0.0, 0.0, 0.0);
  Out[7]  = float4(r31[2], 0.0, 0.0, 0.0);
  Out[8]  = r44[0];
  Out[9]  = r44[1];
  Out[10] = r44[2];
  Out[11] = r44[3];
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float32
    Stride: 16
    Data: [   0.0,  30.0,  45.0,  60.0,
             90.0, 180.0, 270.0, 360.0,
            -45.0, -90.0,-180.0,  15.0,
            30.0, 90.0, 15.0, 45.0 ]
    # In[0]: 0, 30, 45, 60
    # In[1]: 90, 180, 270, 360
    # In[2]: -45, -90, -180, 15
    # In[3]: 30.0, 90.0, 15.0, 45.0
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 192
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    Data: [ 0.0, 0.5235988, 0.0, 0.0,
            0.7853982, 1.0471976, 0.0, 0.0,
            1.5707964, 3.1415927, 0.0, 0.0,
            1.5707964, 3.1415927, 4.712389, 6.2831855,
            -0.7853982, -1.5707964, -3.1415927, 0.2617994,
            0.0, 0.0, 0.0, 0.0,
            -0.7853982, 0.0, 0.0, 0.0,
            -1.5707964, 0.0, 0.0, 0.0,
            0.0, 0.5235988, 0.7853982, 1.0471976,
            1.5707964, 3.1415927, 4.712389, 6.2831855,
            -0.7853982, -1.5707964, -3.1415927, 0.2617994,
            0.5235988, 1.5707964, 0.2617994, 0.7853982 ]
Results:
  - Result: Test1
    Rule: BufferFloatULP
    ULPT: 2
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
