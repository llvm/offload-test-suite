            37.5, 49.0, 0.0, 0.0,
            -0.5, -3.5, 8.5, 15.5,
            -24.5, 35.5, 48.5, -63.5,
            2.5, -1.5, 0.0, 0.0,
            12.0, -23.5, -13.0, 103.0,
            1000501.0, -90085.0, 65664.0, 15001507.0,
            7.5, 3.25, 4.0, -5.25,
            60001.5, -60001.5, -60000.5, 60000.5,
            12.0, -23.5, -13.0, 103.0 ]
Results:
  - Result: Test
    Rule: BufferFloatULP
    ULPT: 1
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
