#--- source.hlsl

// Tests AllMemoryBarrierWithGroupSync with group-shared and UAV memory.
// Divergent calls are undefined and are not tested.

RWStructuredBuffer<uint> UavCounter : register(u0);
RWStructuredBuffer<uint> Out : register(u1);

groupshared uint GroupCounter;

[numthreads(512, 1, 1)]
void main(uint3 GTID : SV_GroupThreadID) {
  if (GTID.x == 511) {
    GroupCounter = 1;
    UavCounter[0] = 1;
  }

  AllMemoryBarrierWithGroupSync();

  if (GTID.x == 0) {
    Out[0] = GroupCounter;
    Out[1] = UavCounter[0];
  }

  AllMemoryBarrierWithGroupSync();

  for (uint I = 0; I < 512; ++I) {
    if (GTID.x == I) {
      GroupCounter = GroupCounter + 1;
      UavCounter[0] = UavCounter[0] + 1;
    }

    AllMemoryBarrierWithGroupSync();
  }

  if (GTID.x == 256) {
    Out[2] = GroupCounter;
    Out[3] = UavCounter[0];
  }
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: UavCounter
    Format: UInt32
    Stride: 4
    FillSize: 4
  - Name: Out
    Format: UInt32
    Stride: 4
    FillSize: 16
  - Name: ExpectedOut
    Format: UInt32
    Stride: 4
    Data: [ 1, 1, 513, 513 ]
Results:
  - Result: TestAllMemoryBarrierWithGroupSync
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: UavCounter
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
