#--- source.hlsl

RWStructuredBuffer<uint> Data : register(u0);
RWStructuredBuffer<uint> Out : register(u1);

// This is a compile-and-run smoke test. Full memory-order validation is out
// of scope because this barrier does not synchronize threads.
[numthreads(1, 1, 1)]
void main() {
  Data[0] = 1u;
  Barrier(Data, DEVICE_SCOPE);
  Out[0] = Data[0];
}

//--- pipeline.yaml
---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: Data
    Format: UInt32
    Stride: 4
    Data: [ 0 ]
  - Name: Out
    Format: UInt32
    Stride: 4
    FillSize: 4
  - Name: ExpectedOut
    Format: UInt32
    Stride: 4
    Data: [ 1 ]
Results:
  - Result: BarrierResourceNonSync
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: Data
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# Clang does not implement Barrier: https://github.com/llvm/llvm-project/issues/99234
# XFAIL: Clang
# REQUIRES: SM_6_8

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_8 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
