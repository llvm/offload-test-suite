#--- source.hlsl
StructuredBuffer<float4> Min : register(t0);
StructuredBuffer<float4> Max : register(t1);
StructuredBuffer<float4> X : register(t2);

RWStructuredBuffer<float4> Out : register(u3);

[numthreads(1,1,1)]
void main() {
  float3x2 F32 = smoothstep(float3x2(Min[0].xyz, Min[1].xyz),
                            float3x2(Max[0].xyz, Max[1].xyz),
                            float3x2(X[0].xyz, X[1].xyz));
  float2x4 F24 = smoothstep(float2x4(Min[2], Min[3]),
                            float2x4(Max[2], Max[3]),
                            float2x4(X[2], X[3]));
  float3x1 F31 = smoothstep(float3x1(Min[4].xyz),
                            float3x1(Max[4].xyz),
                            float3x1(X[4].xyz));
  float4x4 F44 = smoothstep(float4x4(Min[5], Min[6], Min[7], Min[8]),
                            float4x4(Max[5], Max[6], Max[7], Max[8]),
                            float4x4(X[5], X[6], X[7], X[8]));
  float2x2 F22Const = smoothstep(float2x2(-1.0, 0.0, -6.0, 2.5),
                                 float2x2(1.0, 8.0, -2.0, 4.5),
                                 float2x2(-0.5, 5.0, -8.0, 60000.0));

  Out[0] = float4(F32[0], F32[1]);
  Out[1] = float4(F32[2], 0.0, 0.0);
  Out[2] = F24[0];
  Out[3] = F24[1];
  Out[4] = float4(F31[0], F31[1], F31[2], 0.0);
  Out[5] = F44[0];
  Out[6] = F44[1];
  Out[7] = F44[2];
  Out[8] = F44[3];
  Out[9] = float4(F22Const[0], F22Const[1]);
}
//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: Min
    Format: Float32
    Stride: 16
    Data: [ 0.0, -1.0, 2.0, 0.0,
            -4.0, 0.5, -8.0, 0.0,
            0.0, -2.0, 1.0, -0.5,
            -60000.0, -16.0, 0.25, -1.0,
            -2.0, 0.0, -0.5, 0.0,
            -1.0, 0.0, -6.0, 2.5,
            0.0, -8.0, 1.0, -0.25,
            -3.0, 4.0, -2.0, 10.0,
            -16.0, 0.0, -1.5, -0.5 ]
  - Name: Max
    Format: Float32
    Stride: 16
    Data: [ 1.0, 1.0, 4.0, 0.0,
            -2.0, 1.5, 8.0, 0.0,
            4.0, 2.0, 3.0, 0.5,
            60000.0, 16.0, 0.75, 0.0,
            6.0, 2.0, 1.5, 0.0,
            1.0, 8.0, -2.0, 4.5,
            1.0, -4.0, 5.0, 0.75,
            1.0, 6.0, 0.0, 12.0,
            16.0, 0.5, -0.5, 0.0 ]
  - Name: X
    Format: Float32
    Stride: 16
    Data: [ 0.25, 0.0, 1.0, 0.0,
            -2.5, 1.5, 10.0, 0.0,
            0.5, -2.0, 2.25, -1.0,
            -60000.0, 12.0, 0.5, 60000.0,
            1.0, -60000.0, 1.0, 0.0,
            -0.5, 5.0, -8.0, 60000.0,
            0.0, -4.0, 3.0, 0.625,
            -2.5, 4.75, 1.0, 10.5,
            -20.0, 0.25, -0.75, 0.0 ]
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 160
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    Data: [ 0.15625, 0.5, 0.0, 0.84375,
            1.0, 1.0, 0.0, 0.0,
            0.04296875, 0.0, 0.68359375, 0.0,
            0.0, 0.95703125, 0.5, 1.0,
            0.31640625, 0.0, 0.84375, 0.0,
            0.15625, 0.68359375, 0.0, 1.0,
            0.0, 1.0, 0.5, 0.95703125,
            0.04296875, 0.31640625, 1.0, 0.15625,
            0.0, 0.5, 0.84375, 1.0,
            0.15625, 0.68359375, 0.0, 1.0 ]
Results:
  - Result: Test
    Rule: BufferFloatULP
    ULPT: 2
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: Min
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Max
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: X
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
    - Name: Out
