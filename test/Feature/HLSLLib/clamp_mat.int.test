#--- source.hlsl
StructuredBuffer<int4> X : register(t0);
StructuredBuffer<int4> Min : register(t1);
StructuredBuffer<int4> Max : register(t2);

RWStructuredBuffer<int4> Out : register(u3);

[numthreads(1,1,1)]
void main() {
  int3x2 I32 = clamp(int3x2(X[0].xyz, X[1].xyz),
                     int3x2(Min[0].xyz, Min[1].xyz),
                     int3x2(Max[0].xyz, Max[1].xyz));
  int2x4 I24 = clamp(int2x4(X[2], X[3]),
                     int2x4(Min[2], Min[3]),
                     int2x4(Max[2], Max[3]));
  int3x1 I31 = clamp(int3x1(X[4].xyz),
                     int3x1(Min[4].xyz),
                     int3x1(Max[4].xyz));
  int4x4 I44 = clamp(int4x4(X[5], X[6], X[7], X[8]),
                     int4x4(Min[5], Min[6], Min[7], Min[8]),
                     int4x4(Max[5], Max[6], Max[7], Max[8]));
  int2x2 I22Const = clamp(int2x2(-2147483648, 2, -30, 2147483647),
                          int2x2(-5, -1, -50, 0),
                          int2x2(50, 3, 60, 100));

  Out[0] = int4(I32[0], I32[1]);
  Out[1] = int4(I32[2], 0, 0);
  Out[2] = I24[0];
  Out[3] = I24[1];
  Out[4] = int4(I31[0], I31[1], I31[2], 0);
  Out[5] = I44[0];
  Out[6] = I44[1];
  Out[7] = I44[2];
  Out[8] = I44[3];
  Out[9] = int4(I22Const[0], I22Const[1]);
}
//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: X
    Format: Int32
    Stride: 16
    Data: [ 5, 9, 0, 0,
            4, 7, 12, 0,
            -3, -1, 0, 3,
            10, -8, 15, 0,
            -20, 2, 6, 0,
            -2147483648, 2, -30, 2147483647,
            -1, 100, -50, 25,
            3, -3, 7, -9,
            50, -25, 4, 9 ]
  - Name: Min
    Format: Int32
    Stride: 16
    Data: [ 1, 2, 3, 0,
            4, 0, 0, 0,
            -2, -4, -1, -1,
            11, -6, 0, 0,
            -10, 1, -3, 0,
            -5, -1, -50, 0,
            -1, 25, -40, 25,
            -2, -7, 0, 0,
            -25, -24, 4, 1 ]
  - Name: Max
    Format: Int32
    Stride: 16
    Data: [ 8, 6, 4, 0,
            10, 7, 10, 0,
            5, 6, 2, 2,
            20, 7, 12, 1,
            15, 2, 5, 0,
            50, 3, 60, 100,
            4, 99, 50, 26,
            3, 8, 7, 9,
            40, 30, 5, 8 ]
  - Name: Out
    Format: Int32
    Stride: 16
    FillSize: 160
  - Name: ExpectedOut
    Format: Int32
    Stride: 16
    Data: [ 5, 6, 3, 4,
            7, 10, 0, 0,
            -2, -1, 0, 2,
            11, -6, 12, 0,
            -10, 2, 5, 0,
            -5, 2, -30, 100,
            -1, 99, -40, 25,
            3, -3, 7, 0,
            40, -24, 4, 8,
            -5, 2, -30, 100 ]
Results:
  - Result: Test
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: X
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Min
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: Max
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 3
        Space: 0
      VulkanBinding:
        Binding: 3
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -HV 2021 -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
