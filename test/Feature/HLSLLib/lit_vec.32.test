#--- source.hlsl
StructuredBuffer<float4> NDotL : register(t0);
StructuredBuffer<float4> NDotH : register(t1);
StructuredBuffer<float4> M : register(t2);

RWStructuredBuffer<float4> Out : register(u3);

[numthreads(1,1,1)]
void main() {
  float4 L4 = NDotL[0];
  float4 H4 = NDotH[0];
  float4 M4 = M[0];
  float3 L3 = NDotL[1].xyz;
  float3 H3 = NDotH[1].xyz;
  float3 M3 = M[1].xyz;
  float2 L2 = NDotL[2].xy;
  float2 H2 = NDotH[2].xy;
  float2 M2 = M[2].xy;
  float1 L1 = NDotL[3].x;
  float1 H1 = NDotH[3].x;
  float1 M1 = M[3].x;

  uint I = 0;
  for (uint C = 0; C < 4; ++C)
    Out[I++] = lit(L4[C], H4[C], M4[C]);
  for (uint C = 0; C < 3; ++C)
    Out[I++] = lit(L3[C], H3[C], M3[C]);
  Out[I++] = lit(L2.x, H2.x, M2.x);
  Out[I++] = lit(L2.y, H2.y, M2.y);
  Out[I++] = lit(L1.x, H1.x, M1.x);

  // Use the vector returned by lit in swizzles and component-wise math.
  float4 A = lit(1.0, 0.5, 2.0);
  float4 B = lit(-1.0, 0.5, 2.0);
  Out[I++] = A.wzyx;
  Out[I++] = A + B;
  Out[I++] = float4(A.yz, B.yz);
}
//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: NDotL
    Format: Float32
    Stride: 16
    Data: [ 0.5, -0.5, 0.75, 1,
            2, 0, 0.25, 0,
            3, -0.25, 0, 0,
            0.5, 0, 0, 0 ]
  - Name: NDotH
    Format: Float32
    Stride: 16
    Data: [ 0.25, 0.5, -0.5, 0.5,
            4, 1.5, 0.5, 0,
            0.25, -0.25, 0, 0,
            16, 0, 0, 0 ]
  - Name: M
    Format: Float32
    Stride: 16
    Data: [ 2, 2, 3, 0,
            0.5, 1, 1, 0,
            0.5, 2, 0, 0,
            0.25, 0, 0, 0 ]
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 208
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    # lit returns (1, NDotL < 0 ? 0 : NDotL,
    #              (NDotL < 0 || NDotH < 0) ? 0 : pow(NDotH, M), 1).
    Data: [ 1, 0.5, 0.0625, 1,
            1, 0, 0, 1,
            1, 0.75, 0, 1,
            1, 1, 1, 1,
            1, 2, 2, 1,
            1, 0, 1.5, 1,
            1, 0.25, 0.5, 1,
            1, 3, 0.5, 1,
            1, 0, 0, 1,
            1, 0.5, 2, 1,
            1, 0.25, 1, 1,
            2, 1, 0.25, 2,
            1, 0.25, 0, 0 ]
Results:
  - Result: Test0
    Rule: BufferFloatEpsilon
    Epsilon: 0.0008
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: NDotL
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: NDotH
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: M
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 3
        Space: 0
      VulkanBinding:
        Binding: 3
...
#--- end

# Bug: https://github.com/microsoft/DirectXShaderCompiler/issues/9123
# XFAIL: DXC && Vulkan

# Bug: https://github.com/llvm/llvm-project/issues/235864
# XFAIL: Clang && (DirectX || Metal)

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
