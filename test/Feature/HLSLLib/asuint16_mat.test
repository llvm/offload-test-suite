# Unimplemented https://github.com/llvm/llvm-project/issues/184475
# XFAIL: Clang

# Bug: https://github.com/llvm/llvm-project/issues/186864
# XFAIL: Clang && Vulkan

# RUN: split-file %s %t
# RUN: %dxc_target  -T cs_6_5 -enable-16bit-types -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
