#--- source.hlsl
StructuredBuffer<uint16_t4> In0 : register(t0);
StructuredBuffer<int16_t4> In1 : register(t1);
StructuredBuffer<half4> In2 : register(t2);

RWStructuredBuffer<uint16_t4> Out0 : register(u3);
RWStructuredBuffer<uint16_t4> Out1 : register(u4);
RWStructuredBuffer<uint16_t4> Out2 : register(u5);

[numthreads(1,1,1)]
void main() {
  // uint -> uint matrices (identity bit-cast)
  uint16_t2x2 u22 = asuint16(uint16_t2x2(In0[0].xy, In0[0].zw));
  uint16_t3x2 u32 = asuint16(uint16_t3x2(In0[1].xyz, In0[2].xyz));
  uint16_t2x4 u24 = asuint16(uint16_t2x4(In0[3], In0[4]));
  uint16_t4x4 u44 = asuint16(uint16_t4x4(In0[5], In0[6], In0[7], In0[8]));
  uint16_t3x3 u33 = asuint16(uint16_t3x3(In0[9].xyz, In0[10].xyz, In0[11].xyz));
  uint16_t4x3 u43 = asuint16(uint16_t4x3(In0[12].xyz, In0[13].xyz,
                               In0[14].xyz, In0[15].xyz));

  Out0[0] = uint16_t4(u22[0], u22[1]);
  Out0[1] = uint16_t4(u32[0], u32[1]);
  Out0[2] = uint16_t4(u32[2], 0, 0);
  Out0[3] = u24[0];
  Out0[4] = u24[1];
  Out0[5] = u44[0];
  Out0[6] = u44[1];
  Out0[7] = u44[2];
  Out0[8] = u44[3];
  Out0[9]  = uint16_t4(u33[0], 0);
  Out0[10] = uint16_t4(u33[1], 0);
  Out0[11] = uint16_t4(u33[2], 0);
  Out0[12] = uint16_t4(u43[0], 0);
  Out0[13] = uint16_t4(u43[1], 0);
  Out0[14] = uint16_t4(u43[2], 0);
  Out0[15] = uint16_t4(u43[3], 0);

  uint16_t2x2 u22_const = asuint16(uint16_t2x2(0xffffu, 0u, 0x8000u, 100u));
  Out0[16] = uint16_t4(u22_const[0], u22_const[1]);

  uint16_t1x1 u11 = asuint16(uint16_t1x1(In0[0].x));
  Out0[17] = uint16_t4(u11[0], 0, 0, 0);

  uint16_t4x4 u44_const = asuint16(uint16_t4x4(0xffffu, 0u, 0x8000u, 100u,
                                     1u, 10u, 100u, 1000u,
                                     0u, 1u, 2u, 3u,
                                     10u, 100u, 1000u, 10000u));
  Out0[18] = u44_const[0];
  Out0[19] = u44_const[1];
  Out0[20] = u44_const[2];
  Out0[21] = u44_const[3];

  // int -> uint matrices
  uint16_t2x2 i22 = asuint16(int16_t2x2(In1[0].xy, In1[0].zw));
  uint16_t3x2 i32 = asuint16(int16_t3x2(In1[1].xyz, In1[2].xyz));
  uint16_t2x4 i24 = asuint16(int16_t2x4(In1[3], In1[4]));
  uint16_t4x4 i44 = asuint16(int16_t4x4(In1[5], In1[6], In1[7], In1[8]));
  uint16_t3x3 i33 = asuint16(int16_t3x3(In1[9].xyz, In1[10].xyz, In1[11].xyz));
  uint16_t4x3 i43 = asuint16(int16_t4x3(In1[12].xyz, In1[13].xyz,
                              In1[14].xyz, In1[15].xyz));

  Out1[0] = uint16_t4(i22[0], i22[1]);
  Out1[1] = uint16_t4(i32[0], i32[1]);
  Out1[2] = uint16_t4(i32[2], 0, 0);
  Out1[3] = i24[0];
  Out1[4] = i24[1];
  Out1[5] = i44[0];
  Out1[6] = i44[1];
  Out1[7] = i44[2];
  Out1[8] = i44[3];
  Out1[9]  = uint16_t4(i33[0], 0);
  Out1[10] = uint16_t4(i33[1], 0);
  Out1[11] = uint16_t4(i33[2], 0);
  Out1[12] = uint16_t4(i43[0], 0);
  Out1[13] = uint16_t4(i43[1], 0);
  Out1[14] = uint16_t4(i43[2], 0);
  Out1[15] = uint16_t4(i43[3], 0);

  uint16_t2x2 i22_const = asuint16(int16_t2x2(-1, 2, 0, 32767));
  Out1[16] = uint16_t4(i22_const[0], i22_const[1]);

  uint16_t1x1 i11 = asuint16(int16_t1x1(In1[0].x));
  Out1[17] = uint16_t4(i11[0], 0, 0, 0);

  uint16_t4x4 i44_const = asuint16(int16_t4x4(-1, 2, 0, 32767,
                                    -32768, 100, -100, 50,
                                    1, 2, 3, 4,
                                    -1, -2, -3, -4));
  Out1[18] = i44_const[0];
  Out1[19] = i44_const[1];
  Out1[20] = i44_const[2];
  Out1[21] = i44_const[3];

  // half -> uint16 matrices
  uint16_t2x2 f22 = asuint16(half2x2(In2[0].xy, In2[0].zw));
  uint16_t3x2 f32 = asuint16(half3x2(In2[1].xyz, In2[2].xyz));
  uint16_t2x4 f24 = asuint16(half2x4(In2[3], In2[4]));
  uint16_t4x4 f44 = asuint16(half4x4(In2[5], In2[6], In2[7], In2[8]));
  uint16_t3x3 f33 = asuint16(half3x3(In2[9].xyz, In2[10].xyz, In2[11].xyz));
  uint16_t4x3 f43 = asuint16(half4x3(In2[12].xyz, In2[13].xyz,
                                In2[14].xyz, In2[15].xyz));

  Out2[0] = uint16_t4(f22[0], f22[1]);
  Out2[1] = uint16_t4(f32[0], f32[1]);
  Out2[2] = uint16_t4(f32[2], 0, 0);
  Out2[3] = f24[0];
  Out2[4] = f24[1];
  Out2[5] = f44[0];
  Out2[6] = f44[1];
  Out2[7] = f44[2];
  Out2[8] = f44[3];
  Out2[9]  = uint16_t4(f33[0], 0);
  Out2[10] = uint16_t4(f33[1], 0);
  Out2[11] = uint16_t4(f33[2], 0);
  Out2[12] = uint16_t4(f43[0], 0);
  Out2[13] = uint16_t4(f43[1], 0);
  Out2[14] = uint16_t4(f43[2], 0);
  Out2[15] = uint16_t4(f43[3], 0);

  uint16_t2x2 f22_const = asuint16(half2x2(10.0, 0.0, 0.5, 1.0));
  Out2[16] = uint16_t4(f22_const[0], f22_const[1]);

  uint16_t1x1 f11 = asuint16(half1x1(In2[0].x));
  Out2[17] = uint16_t4(f11[0], 0, 0, 0);

  uint16_t4x4 f44_const = asuint16(half4x4(10.0, 0.0, 0.5, 1.0,
                                      2.0, 4.0, 8.0, 0.0,
                                      0.0, 0.5, 1.0, 2.0,
                                      4.0, 8.0, 10.0, 16.0));
  Out2[18] = f44_const[0];
  Out2[19] = f44_const[1];
  Out2[20] = f44_const[2];
  Out2[21] = f44_const[3];
}
//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In0
    Format: UInt16
    Stride: 8
    Data: [ 0xffff, 0, 0x8000, 100,
            1, 10, 100, 0,
            1000, 0x8000, 0xffff, 0,
            0, 1, 10, 100,
            0x8000, 0x8001, 0xfffe, 0xffff,
            0, 1, 2, 3,
            10, 100, 1000, 10000,
            0x8000, 0x7FFF, 0xffff, 0xfffe,
            50, 60, 70, 80,
