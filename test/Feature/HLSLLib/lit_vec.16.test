#--- source.hlsl
StructuredBuffer<half4> NDotL : register(t0);
StructuredBuffer<half4> NDotH : register(t1);
StructuredBuffer<half4> M : register(t2);

RWStructuredBuffer<half4> Out : register(u3);

[numthreads(1,1,1)]
void main() {
  half4 L4 = NDotL[0];
  half4 H4 = NDotH[0];
  half4 M4 = M[0];
  half3 L3 = NDotL[1].xyz;
  half3 H3 = NDotH[1].xyz;
  half3 M3 = M[1].xyz;
  half2 L2 = NDotL[2].xy;
  half2 H2 = NDotH[2].xy;
  half2 M2 = M[2].xy;
  half1 L1 = NDotL[3].x;
  half1 H1 = NDotH[3].x;
  half1 M1 = M[3].x;

  uint I = 0;
  for (uint C = 0; C < 4; ++C)
    Out[I++] = lit(L4[C], H4[C], M4[C]);
  for (uint C = 0; C < 3; ++C)
    Out[I++] = lit(L3[C], H3[C], M3[C]);
  Out[I++] = lit(L2.x, H2.x, M2.x);
  Out[I++] = lit(L2.y, H2.y, M2.y);
  Out[I++] = lit(L1.x, H1.x, M1.x);

  // Use the vector returned by lit in swizzles and component-wise math.
  half4 A = lit((half)1, (half)0.5, (half)2);
  half4 B = lit((half)-1, (half)0.5, (half)2);
  Out[I++] = A.wzyx;
  Out[I++] = A + B;
  Out[I++] = half4(A.yz, B.yz);
}
//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: NDotL
    Format: Float16
    Stride: 8
    Data: [ 0x3800, 0xb800, 0x3a00, 0x3c00,
            0x4000, 0x0000, 0x3400, 0x0000,
            0x4200, 0xb400, 0x0000, 0x0000,
            0x3800, 0x0000, 0x0000, 0x0000 ]
    # 0.5, -0.5, 0.75, 1
    # 2, 0, 0.25, 0
    # 3, -0.25, 0, 0
    # 0.5, 0, 0, 0
  - Name: NDotH
    Format: Float16
    Stride: 8
    Data: [ 0x3400, 0x3800, 0xb800, 0x3800,
            0x4400, 0x3e00, 0x3800, 0x0000,
            0x3400, 0xb400, 0x0000, 0x0000,
            0x4c00, 0x0000, 0x0000, 0x0000 ]
    # 0.25, 0.5, -0.5, 0.5
    # 4, 1.5, 0.5, 0
    # 0.25, -0.25, 0, 0
    # 16, 0, 0, 0
  - Name: M
    Format: Float16
    Stride: 8
    Data: [ 0x4000, 0x4000, 0x4200, 0x0000,
            0x3800, 0x3c00, 0x3c00, 0x0000,
            0x3800, 0x4000, 0x0000, 0x0000,
            0x3400, 0x0000, 0x0000, 0x0000 ]
    # 2, 2, 3, 0
    # 0.5, 1, 1, 0
    # 0.5, 2, 0, 0
    # 0.25, 0, 0, 0
  - Name: Out
    Format: Float16
    Stride: 8
    FillSize: 104
  - Name: ExpectedOut
    Format: Float16
    Stride: 8
    # lit returns (1, NDotL < 0 ? 0 : NDotL,
    #              (NDotL < 0 || NDotH < 0) ? 0 : pow(NDotH, M), 1).
    Data: [ 0x3c00, 0x3800, 0x2c00, 0x3c00,
            0x3c00, 0x0000, 0x0000, 0x3c00,
            0x3c00, 0x3a00, 0x0000, 0x3c00,
            0x3c00, 0x3c00, 0x3c00, 0x3c00,
            0x3c00, 0x4000, 0x4000, 0x3c00,
            0x3c00, 0x0000, 0x3e00, 0x3c00,
            0x3c00, 0x3400, 0x3800, 0x3c00,
            0x3c00, 0x4200, 0x3800, 0x3c00,
            0x3c00, 0x0000, 0x0000, 0x3c00,
            0x3c00, 0x3800, 0x4000, 0x3c00,
            0x3c00, 0x3400, 0x3c00, 0x3c00,
            0x4000, 0x3c00, 0x3400, 0x4000,
            0x3c00, 0x3400, 0x0000, 0x0000 ]
    # 1, 0.5, 0.0625, 1
    # 1, 0, 0, 1
    # 1, 0.75, 0, 1
    # 1, 1, 1, 1
    # 1, 2, 2, 1
    # 1, 0, 1.5, 1
    # 1, 0.25, 0.5, 1
    # 1, 3, 0.5, 1
    # 1, 0, 0, 1
    # 1, 0.5, 2, 1
    # 1, 0.25, 1, 1
    # 2, 1, 0.25, 2
    # 1, 0.25, 0, 0
Results:
  - Result: Test0
    Rule: BufferFloatEpsilon
    Epsilon: 0.003
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: NDotL
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: NDotH
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: M
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 3
        Space: 0
      VulkanBinding:
        Binding: 3
...
#--- end

# REQUIRES: Half

# Bug: https://github.com/microsoft/DirectXShaderCompiler/issues/9123
# XFAIL: DXC && Vulkan

# Bug: https://github.com/llvm/llvm-project/issues/235864
# XFAIL: Clang && (DirectX || Metal)

# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
