#--- source.hlsl
StructuredBuffer<float4> In : register(t0);
RWStructuredBuffer<float4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  // All inputs are exact powers-of-two fractions to ensure exact fp32 results.
  // frac(x) = x - floor(x); frac(-0.25) = 0.75, frac(-2.5) = 0.5, etc.
  float3x2 R32 = frac(float3x2(In[0].xy, In[0].zw, In[1].xy));
  float2x4 R24 = frac(float2x4(In[1], In[2]));
  float3x1 R31 = frac(float3x1(In[4].xyz));
  float4x4 R44 = frac(float4x4(In[5], In[6], In[7], In[8]));
  float2x2 R22 = frac(float2x2(-1.5, -0.5, 0.5, 1.5));

  Out[0] = float4(R32[0], R32[1]);
  Out[1] = float4(R32[2], 0.0, 0.0);
  Out[2] = R24[0];
  Out[3] = R24[1];
  Out[4] = float4(R31[0], R31[1], R31[2], 0.0);
  Out[5] = R44[0];
  Out[6] = R44[1];
  Out[7] = R44[2];
  Out[8] = R44[3];
  Out[9] = float4(R22[0], R22[1]);
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float32
    Stride: 16
    Data: [ -2.5, -1.5, -1.0, -0.5,
            -0.25, 0.0, 0.25, 0.5,
            0.75, 1.0, 1.25, 1.5,
            1.75, 2.0, 2.5, 0.0,
            -1.5, -0.5, 0.5, 1.5,
            -2.5, -1.5, -1.0, -0.5,
            -0.25, 0.0, 0.25, 0.5,
            0.75, 1.0, 1.25, 1.5,
            1.75, 2.0, 2.5, 0.0 ]
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 160
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    Data: [ 0.5, 0.5, 0.0, 0.5,
            0.75, 0.0, 0.0, 0.0,
            0.75, 0.0, 0.25, 0.5,
            0.75, 0.0, 0.25, 0.5,
            0.5, 0.5, 0.5, 0.0,
            0.5, 0.5, 0.0, 0.5,
            0.75, 0.0, 0.25, 0.5,
            0.75, 0.0, 0.25, 0.5,
            0.75, 0.0, 0.5, 0.0,
            0.5, 0.5, 0.5, 0.5 ]
Results:
  - Result: Test1
    Rule: BufferFloatEpsilon
    Epsilon: 0.0008
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
