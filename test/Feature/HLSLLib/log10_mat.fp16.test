#--- source.hlsl
StructuredBuffer<half4> In : register(t0);
RWStructuredBuffer<half4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  half3x2 r32 = log10(half3x2(In[0].xy, In[0].zw, In[1].xy));
  half2x4 r24 = log10(half2x4(In[1], In[2]));
  half3x1 r31 = log10(half3x1(In[0].x, In[1].x, In[2].x));
  half4x4 r44 = log10(half4x4(In[0], In[1], In[2], In[3]));

  Out[0]  = half4(r32[0], 0.0, 0.0);
  Out[1]  = half4(r32[1], 0.0, 0.0);
  Out[2]  = half4(r32[2], 0.0, 0.0);
  Out[3]  = r24[0];
  Out[4]  = r24[1];
  Out[5]  = half4(r31[0], 0.0, 0.0, 0.0);
  Out[6]  = half4(r31[1], 0.0, 0.0, 0.0);
  Out[7]  = half4(r31[2], 0.0, 0.0, 0.0);
  Out[8]  = r44[0];
  Out[9]  = r44[1];
  Out[10] = r44[2];
  Out[11] = r44[3];
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float16
    Stride: 8
    Data: [ 0x0000, 0x211F, 0x2E66, 0x3C00,
            0x4900, 0x5640, 0x63D0, 0x4253,
            0x4FE8, 0x3C00, 0x4900, 0x2E66,
            0x211F, 0x4253, 0x3C00, 0x2E66 ]
    # In[0]: 0, ~0.01, ~0.1, 1
    # In[1]: 10, 100, 1000, ~sqrt(10)(=3.162)
    # In[2]: ~sqrt(1000)(=31.62), 1, 10, ~0.1 (reuse)
    # In[3]: ~0.01, ~sqrt(10), 1, ~0.1
  - Name: Out
    Format: Float16
    Stride: 8
    FillSize: 96
  - Name: ExpectedOut
    Format: Float16
    Stride: 8
    Data: [ 0xFC00, 0xC000, 0x0000, 0x0000,
            0xBC00, 0x0000, 0x0000, 0x0000,
            0x3C00, 0x4000, 0x0000, 0x0000,
            0x3C00, 0x4000, 0x4200, 0x3800,
            0x3E00, 0x0000, 0x3C00, 0xBC00,
            0xFC00, 0x0000, 0x0000, 0x0000,
            0x3C00, 0x0000, 0x0000, 0x0000,
            0x3E00, 0x0000, 0x0000, 0x0000,
            0xFC00, 0xC000, 0xBC00, 0x0000,
            0x3C00, 0x4000, 0x4200, 0x3800,
            0x3E00, 0x0000, 0x3C00, 0xBC00,
            0xC000, 0x3800, 0x0000, 0xBC00 ]
    # log10(0)=-inf=0xFC00, log10(~0.01)~-2=0xC000, log10(~0.1)~-1=0xBC00, log10(1)=0
    # log10(10)=1=0x3C00, log10(100)=2=0x4000, log10(1000)=3=0x4200
    # log10(sqrt(10))~0.5=0x3800, log10(sqrt(1000))~1.5=0x3E00
Results:
  - Result: Test1
    Rule: BufferFloatULP
    ULPT: 4
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# REQUIRES: Half
# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
