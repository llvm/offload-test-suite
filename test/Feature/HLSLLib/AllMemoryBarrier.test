#--- source.hlsl

// Tests AllMemoryBarrier with group-shared and UAV memory.

RWStructuredBuffer<uint> UavData : register(u0);
RWStructuredBuffer<uint> Out : register(u1);

groupshared uint GroupData[4];

[numthreads(4, 1, 1)]
void main(uint3 GTID : SV_GroupThreadID) {
  uint Index = GTID.x;
  GroupData[Index] = Index + 1;
  UavData[Index] = Index + 5;

  AllMemoryBarrier();

  Out[Index] =
      GroupData[Index] == Index + 1 && UavData[Index] == Index + 5;
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: UavData
    Format: UInt32
    Stride: 4
    FillSize: 16
  - Name: Out
    Format: UInt32
    Stride: 4
    FillSize: 16
  - Name: ExpectedOut
    Format: UInt32
    Stride: 4
    Data: [ 1, 1, 1, 1 ]
Results:
  - Result: TestAllMemoryBarrier
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: UavData
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
