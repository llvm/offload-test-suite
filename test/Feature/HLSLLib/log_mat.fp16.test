#--- source.hlsl
StructuredBuffer<half4> In : register(t0);
RWStructuredBuffer<half4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  half3x2 r32 = log(half3x2(In[0].xy, In[0].zw, In[1].xy));
  half2x4 r24 = log(half2x4(In[1], In[2]));
  half3x1 r31 = log(half3x1(In[0].x, In[1].x, In[2].x));
  half4x4 r44 = log(half4x4(In[0], In[1], In[2], In[3]));

  Out[0]  = half4(r32[0], 0.0, 0.0);
  Out[1]  = half4(r32[1], 0.0, 0.0);
  Out[2]  = half4(r32[2], 0.0, 0.0);
  Out[3]  = r24[0];
  Out[4]  = r24[1];
  Out[5]  = half4(r31[0], 0.0, 0.0, 0.0);
  Out[6]  = half4(r31[1], 0.0, 0.0, 0.0);
  Out[7]  = half4(r31[2], 0.0, 0.0, 0.0);
  Out[8]  = r44[0];
  Out[9]  = r44[1];
  Out[10] = r44[2];
  Out[11] = r44[3];
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float16
    Stride: 8
    Data: [ 0x0000, 0x3400, 0x3800, 0x3C00,
            0x4000, 0x4170, 0x4400, 0x4900,
            0x5640, 0x3C00, 0x4400, 0x3800,
            0x3400, 0x4900, 0x3C00, 0x3800 ]
    # In[0]: 0 (-inf), 0.25, 0.5, 1
    # In[1]: 2, ~e(0x4170=2.71875), 4, 10
    # In[2]: 100, 1, 4, 0.5 (reuse)
    # In[3]: 0.25, 10, 1, 0.5
  - Name: Out
    Format: Float16
    Stride: 8
    FillSize: 96
  - Name: ExpectedOut
    Format: Float16
    Stride: 8
    Data: [ 0xFC00, 0xBD8C, 0x0000, 0x0000,
            0xB98C, 0x0000, 0x0000, 0x0000,
            0x398C, 0x3C00, 0x0000, 0x0000,
            0x398C, 0x3C00, 0x3D8C, 0x409B,
            0x449B, 0x0000, 0x3D8C, 0xB98C,
            0xFC00, 0x0000, 0x0000, 0x0000,
            0x398C, 0x0000, 0x0000, 0x0000,
            0x449B, 0x0000, 0x0000, 0x0000,
            0xFC00, 0xBD8C, 0xB98C, 0x0000,
            0x398C, 0x3C00, 0x3D8C, 0x409B,
            0x449B, 0x0000, 0x3D8C, 0xB98C,
            0xBD8C, 0x409B, 0x0000, 0xB98C ]
    # log(0)=-inf=0xFC00, log(0.25)~-1.386=0xBD8C, log(0.5)~-0.693=0xB98C
    # log(1)=0, log(2)~0.693=0x398C, log(~e)~1.0=0x3C00, log(4)~1.386=0x3D8C
    # log(10)~2.303=0x409B, log(100)~4.605=0x449B
Results:
  - Result: Test1
    Rule: BufferFloatULP
    ULPT: 2
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# REQUIRES: Half
# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
