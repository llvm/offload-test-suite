#--- vertex.hlsl
struct VSOutput {
  float4 Pos : SV_Position;
  half X : ATTR0;
};

VSOutput main(float2 Position : POSITION) {
  VSOutput O;
  O.Pos = float4(Position, 0, 1);
  // Pixel x coordinate of this vertex in the 1x1 render target.
  O.X = (half)((Position.x + 1) / 2);
  return O;
}

#--- pixel.hlsl
struct PSInput {
  float4 Pos : SV_Position;
  half X : ATTR0;
};

// The half result is widened to float (exact) so the buffer stays 32-bit.
RWStructuredBuffer<float> Out : register(u0);

float4 main(PSInput I) : SV_Target {
  Out[0] = EvaluateAttributeCentroid(I.X);
  return 0;
}

#--- pipeline.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
Buffers:
  - Name: VertexData
    Format: Float32
    Stride: 8
    Data: [-1, -1, 3, -1, -1, 3]
  - Name: RenderTarget
    Format: Float32
    Channels: 4
    FillSize: 16
    OutputProps:
      Height: 1
      Width: 1
      Depth: 1
  - Name: Out
    Format: Float32
    Stride: 4
    FillSize: 4
    FillValue: 100 # Any value the shader does not write fails.
  - Name: ExpectedOut
    Format: Float32
    Stride: 4
    Data: [0.5]
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 2
      Offset: 0
      Name: POSITION
  RenderTarget: RenderTarget
DescriptorSets:
  - Resources:
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
Results:
  - Result: Evaluate
    Rule: BufferFloatEpsilon
    Epsilon: 0.001
    Actual: Out
    Expected: ExpectedOut
...
#--- end

# A basic 16-bit check; the vector sizes are covered by the fp32 test. Without
# MSAA the centroid is the pixel center, (0.5, 0.5).

# Unimplemented https://github.com/llvm/llvm-project/issues/99110
# XFAIL: Clang

# DXC's SPIR-V backend emits InterpolateAt* on 16-bit floats, which is
# invalid SPIR-V.
# XFAIL: DXC && Vulkan

# REQUIRES: Half && (!Vulkan || (VulkanSampleRateShading && VulkanStorageInputOutput16))

# RUN: split-file %s %t
# RUN: %dxc_target -T vs_6_2 -enable-16bit-types -Fo %t-vertex.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_2 -enable-16bit-types -Fo %t-pixel.o %t/pixel.hlsl
# RUN: %offloader %t/pipeline.yaml %t-vertex.o %t-pixel.o
