#--- source.hlsl

StructuredBuffer<float> In0 : register(t0);
StructuredBuffer<float> In1 : register(t1);
RWStructuredBuffer<float> Out : register(u2);

[numthreads(1,1,1)]
void main() {
  vector<float, 5> Input0_5;
  for (uint I = 0; I < 5; ++I)
    Input0_5[I] = In0[0 + I];
  vector<float, 5> Input1_5;
  for (uint I = 0; I < 5; ++I)
    Input1_5[I] = In1[0 + I];
  vector<float, 5> Result5 = min(Input0_5, Input1_5);
  for (uint I = 0; I < 5; ++I)
    Out[0 + I] = Result5[I];

  vector<float, 8> Input0_8;
  for (uint I = 0; I < 8; ++I)
    Input0_8[I] = In0[5 + I];
  vector<float, 8> Input1_8;
  for (uint I = 0; I < 8; ++I)
    Input1_8[I] = In1[5 + I];
  vector<float, 8> Result8 = min(Input0_8, Input1_8);
  for (uint I = 0; I < 8; ++I)
    Out[5 + I] = Result8[I];

  vector<float, 16> Input0_16;
  for (uint I = 0; I < 16; ++I)
    Input0_16[I] = In0[13 + I];
  vector<float, 16> Input1_16;
  for (uint I = 0; I < 16; ++I)
    Input1_16[I] = In1[13 + I];
  vector<float, 16> Result16 = min(Input0_16, Input1_16);
  for (uint I = 0; I < 16; ++I)
    Out[13 + I] = Result16[I];
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In0
    Format: Float32
    Stride: 4
    Data: [-2, -1, -0.5, 0, 0.5,
           1, 2, -2, -1, -0.5, 0, 0.5, 1,
           2, -2, -1, -0.5, 0, 0.5, 1, 2, -2, -1, -0.5, 0, 0.5, 1, 2, -2]
  - Name: In1
    Format: Float32
    Stride: 4
    Data: [2, 1, 0.5, 0, -0.5,
           -1, -2, 2, 1, 0.5, 0, -0.5, -1,
           -2, 2, 1, 0.5, 0, -0.5, -1, -2, 2, 1, 0.5, 0, -0.5, -1, -2, 2]
  - Name: Out
    Format: Float32
    Stride: 4
    FillSize: 116
  - Name: ExpectedOut
    Format: Float32
    Stride: 4
    Data: [-2, -1, -0.5, 0, -0.5,
           -1, -2, -2, -1, -0.5, 0, -0.5, -1,
           -2, -2, -1, -0.5, 0, -0.5, -1, -2, -2, -1, -0.5, 0, -0.5, -1, -2, -2]
Results:
  - Result: Test
    Rule: BufferFloatEpsilon
    Epsilon: 0.008
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In0
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: In1
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
...
#--- end

# Unimplemented https://github.com/llvm/wg-hlsl/issues/467
# XFAIL: Vulkan

# RUN: split-file %s %t
# RUN: %dxc_target -T %if Clang %{cs_6_0%} %else %{cs_6_9%} -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
