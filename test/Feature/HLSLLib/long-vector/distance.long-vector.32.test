#--- source.hlsl

ByteAddressBuffer X : register(t0);
ByteAddressBuffer Y : register(t1);
RWByteAddressBuffer Out : register(u2);

[numthreads(1,1,1)]
void main() {
  Out.Store<float>(0, distance(X.Load<vector<float, 7> >(0), Y.Load<vector<float, 7> >(0)));
}

#--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: X
    Format: Float32
    Stride: 4
    Data: [1, -1, 1, -1, 2, -2, 2]
  - Name: Y
    Format: Float32
    Stride: 4
    Data: [-1, 1, -1, 1, -2, 2, -2]
  - Name: Out
    Format: Float32
    Stride: 4
    FillSize: 4
  - Name: ExpectedOut
    Format: Float32
    Stride: 4
    Data: [8]
Results:
  - Result: Test
    Rule: BufferFloatULP
    ULPT: 1
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: X
      Kind: ByteAddressBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Y
      Kind: ByteAddressBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: Out
      Kind: RWByteAddressBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
...
#--- end

# XFAIL: DXC

# REQUIRES: !Vulkan || VK_EXT_shader_long_vector
# REQUIRES: Clang || SM_6_9

# RUN: split-file %s %t
# RUN: %dxc_target -T %if Clang %{cs_6_0%} %else %{cs_6_9%} -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o