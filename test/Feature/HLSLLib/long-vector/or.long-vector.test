#--- source.hlsl

ByteAddressBuffer In0 : register(t0);
ByteAddressBuffer In1 : register(t1);
RWByteAddressBuffer Out : register(u2);

[numthreads(1,1,1)]
void main() {
  Out.Store<vector<bool, 8> >(0, or(In0.Load<vector<bool, 8> >(0),
                                  In1.Load<vector<bool, 8> >(0)));
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In0
    Format: Bool
    Stride: 4
    Data: [1, 0, 1, 0, 0, 1, 0, 1]
  - Name: In1
    Format: Bool
    Stride: 4
    Data: [1, 0, 0, 1, 1, 0, 0, 1]
  - Name: Out
    Format: Bool
    Stride: 4
    FillSize: 32
  - Name: ExpectedOut
    Format: Bool
    Stride: 4
    Data: [1, 0, 1, 1, 1, 1, 0, 1]
Results:
  - Result: Test
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In0
      Kind: ByteAddressBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: In1
      Kind: ByteAddressBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: Out
      Kind: RWByteAddressBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
...
#--- end

# Unimplemented https://github.com/microsoft/DirectXShaderCompiler/issues/8996
# XFAIL: Vulkan && DXC

# Bug https://github.com/llvm/offload-test-suite/issues/1506
# XFAIL: Metal && DXC

# REQUIRES: !Vulkan || VK_EXT_shader_long_vector
# REQUIRES: Clang || SM_6_9

# RUN: split-file %s %t
# RUN: %dxc_target -T %if Clang %{cs_6_0%} %else %{cs_6_9%} -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
