#--- source.hlsl

ByteAddressBuffer In : register(t0);
RWByteAddressBuffer Out : register(u1);

[numthreads(1,1,1)]
void main() {
  Out.Store<vector<float, 7> >(0, normalize(In.Load<vector<float, 7> >(0)));
}

#--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float32
    Stride: 4
    Data: [1, -1, 1, -1, 2, -2, 2]
  - Name: Out
    Format: Float32
    Stride: 4
    FillSize: 28
  - Name: ExpectedOut
    Format: Float32
    Stride: 4
    Data: [0.25, -0.25, 0.25, -0.25, 0.5, -0.5, 0.5]
Results:
  - Result: Test
    Rule: BufferFloatULP
    ULPT: 1
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: ByteAddressBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWByteAddressBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# Support explicitly disable for DXC
# XFAIL: DXC

# REQUIRES: !Vulkan || VK_EXT_shader_long_vector
# REQUIRES: Clang || SM_6_9

# RUN: split-file %s %t
# RUN: %dxc_target -T %if Clang %{cs_6_0%} %else %{cs_6_9%} -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o