#--- source.hlsl

ByteAddressBuffer In0 : register(t0);
RWByteAddressBuffer Out : register(u1);

[numthreads(1,1,1)]
void main() {
  Out.Store<vector<float, 8> >(0, round(In0.Load<vector<float, 8> >(0)));
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In0
    Format: Float32
    Stride: 4
    Data: [-2.75, -1.5, -0.25, 0, 0.25, 1.5, 2.75, -2.75]
  - Name: Out
    Format: Float32
    Stride: 4
    FillSize: 32
  - Name: ExpectedOut
    Format: Float32
    Stride: 4
    Data: [-3, -2, 0, 0, 0, 2, 3, -3]
Results:
  - Result: Test
    Rule: BufferFloatEpsilon
    Epsilon: 0.008
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In0
      Kind: ByteAddressBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWByteAddressBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# Unimplemented https://github.com/llvm/wg-hlsl/issues/467
# XFAIL: Vulkan && DXC

# Bug https://github.com/llvm/offload-test-suite/issues/1506
# Note We fail for DXC because today Clang scalairzed and does
# Not hit  IRErrorCodeUnsupportedInstruction on vector @dx.op.*
# XFAIL: Metal && DXC

# RUN: split-file %s %t
# RUN: %dxc_target -T %if Clang %{cs_6_0%} %else %{cs_6_9%} -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o

