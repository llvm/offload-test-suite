#--- source.hlsl

StructuredBuffer<half> In0 : register(t0);
RWStructuredBuffer<int16_t> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  vector<half, 5> Input0_5;
  for (uint I = 0; I < 5; ++I)
    Input0_5[I] = In0[0 + I];
  vector<int16_t, 5> Result5 = asint16(Input0_5);
  for (uint I = 0; I < 5; ++I)
    Out[0 + I] = Result5[I];

  vector<half, 8> Input0_8;
  for (uint I = 0; I < 8; ++I)
    Input0_8[I] = In0[5 + I];
  vector<int16_t, 8> Result8 = asint16(Input0_8);
  for (uint I = 0; I < 8; ++I)
    Out[5 + I] = Result8[I];

  vector<half, 16> Input0_16;
  for (uint I = 0; I < 16; ++I)
    Input0_16[I] = In0[13 + I];
  vector<int16_t, 16> Result16 = asint16(Input0_16);
  for (uint I = 0; I < 16; ++I)
    Out[13 + I] = Result16[I];
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In0
    Format: Float16
    Stride: 2
    Data: [0x0000, 0x3C00, 0xBC00, 0x4000, 0x3800,
          0x0000, 0x3C00, 0xBC00, 0x4000, 0x3800,
          0x0000, 0x3C00, 0xBC00, 0x4000, 0x3800,
          0x0000, 0x3C00, 0xBC00, 0x4000, 0x3800,
          0x0000, 0x3C00, 0xBC00, 0x4000, 0x3800,
          0x0000, 0x3C00, 0xBC00, 0x4000]
    #     [0, 1, -1, 2, 0.5,
    #      0, 1, -1, 2, 0.5, 
    #      0, 1, -1, 2, 0.5, 
    #      0, 1, -1, 2, 0.5, 
    #      0, 1, -1, 2, 0.5, 
    #      0, 1, -1, 2]
  - Name: Out
    Format: Int16
    Stride: 2
    FillSize: 58
  - Name: ExpectedOut
    Format: Int16
    Stride: 2
    Data: [0, 15360, -17408, 16384, 14336,
           0, 15360, -17408, 16384, 14336, 0, 15360, -17408,
           16384, 14336, 0, 15360, -17408, 16384, 14336, 0, 15360, -17408, 16384, 14336, 0, 15360, -17408, 16384]
Results:
  - Result: Test
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In0
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# Unimplemented https://github.com/llvm/wg-hlsl/issues/467
# XFAIL: Vulkan

# REQUIRES: Int16
# REQUIRES: Half

# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -T %if Clang %{cs_6_2%} %else %{cs_6_9%} -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
