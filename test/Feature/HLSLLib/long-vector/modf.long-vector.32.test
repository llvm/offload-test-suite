#--- source.hlsl

ByteAddressBuffer In : register(t0);
RWByteAddressBuffer Out : register(u1);
RWByteAddressBuffer ExtraOut : register(u2);

[numthreads(1,1,1)]
void main() {
  vector<float, 16> Extra;
  Out.Store<vector<float, 16> >(0, modf(In.Load<vector<float, 16> >(0), Extra));
  ExtraOut.Store<vector<float, 16> >(0, Extra);
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float32
    Stride: 4
    Data: [-2.75, -1.5, -0.25, 0, 0.25, 1.5, 2.75, -2.75, -1.5, -0.25, 0, 0.25, 1.5, 2.75, -2.75, -1.5]
  - Name: Out
    Format: Float32
    Stride: 4
    FillSize: 64
  - Name: ExtraOut
    Format: Float32
    Stride: 4
    FillSize: 64
  - Name: ExpectedOut
    Format: Float32
    Stride: 4
    Data: [-0.75, -0.5, -0.25, 0, 0.25, 0.5, 0.75, -0.75, -0.5, -0.25, 0, 0.25, 0.5, 0.75, -0.75, -0.5]
  - Name: ExpectedExtraOut
    Format: Float32
    Stride: 4
    Data: [-2, -1, -0.0, 0, 0, 1, 2, -2, -1, -0.0, 0, 0, 1, 2, -2, -1]
Results:
  - Result: ReturnValue
    Rule: BufferFloatEpsilon
    Epsilon: 0.008
    Actual: Out
    Expected: ExpectedOut
  - Result: OutParameter
    Rule: BufferFloatEpsilon
    Epsilon: 0.008
    Actual: ExtraOut
    Expected: ExpectedExtraOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: ByteAddressBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWByteAddressBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: ExtraOut
      Kind: RWByteAddressBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
...
#--- end

