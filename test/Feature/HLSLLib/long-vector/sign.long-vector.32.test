#--- source.hlsl

ByteAddressBuffer In0 : register(t0);
RWByteAddressBuffer Out : register(u1);

[numthreads(1,1,1)]
void main() {
  Out.Store<vector<int, 8> >(0, sign(In0.Load<vector<int, 8> >(0)));
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In0
    Format: Int32
    Stride: 4
    Data: [-2147483648, -10, -1, 0, 1, 10, 2147483647, -2147483648]
  - Name: Out
    Format: Int32
    Stride: 4
    FillSize: 32
  - Name: ExpectedOut
    Format: Int32
    Stride: 4
    Data: [-1, -1, -1, 0, 1, 1, 1, -1]
Results:
  - Result: Test
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In0
      Kind: ByteAddressBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWByteAddressBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# Unimplemented https://github.com/llvm/wg-hlsl/issues/467
# XFAIL: Vulkan

# Bug https://github.com/llvm/offload-test-suite/issues/1506
# Note We fail for DXC because today Clang scalairzed and does
# Not hit  IRErrorCodeUnsupportedInstruction on vector @dx.op.*
# XFAIL: Metal && DXC

# RUN: split-file %s %t
# RUN: %dxc_target -T %if Clang %{cs_6_0%} %else %{cs_6_9%} -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o

