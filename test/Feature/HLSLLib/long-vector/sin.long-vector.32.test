#--- source.hlsl

ByteAddressBuffer In0 : register(t0);
RWByteAddressBuffer Out : register(u1);

[numthreads(1,1,1)]
void main() {
  Out.Store<vector<float, 16> >(0, sin(In0.Load<vector<float, 16> >(0)));
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In0
    Format: Float32
    Stride: 4
    Data: [-2, -1, -0.5, 0, 0.5, 1, 2, -2, -1, -0.5, 0, 0.5, 1, 2, -2, -1]
  - Name: Out
    Format: Float32
    Stride: 4
    FillSize: 64
  - Name: ExpectedOut
    Format: Float32
    Stride: 4
    Data: [-0.909297427, -0.841470985, -0.479425539, 0, 0.479425539, 0.841470985, 0.909297427, -0.909297427, -0.841470985, -0.479425539, 0, 0.479425539, 0.841470985, 0.909297427, -0.909297427, -0.841470985]
Results:
  - Result: Test
    Rule: BufferFloatULP
    ULPT: 9 # Most Targets needed at most 4. WARP needs a wider range.
    ZeroTolerance: 0.001
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In0
      Kind: ByteAddressBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWByteAddressBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# Unimplemented https://github.com/microsoft/DirectXShaderCompiler/issues/8996
# XFAIL: Vulkan && DXC

# Bug https://github.com/llvm/offload-test-suite/issues/1506
# XFAIL: Metal && DXC

# REQUIRES: !Vulkan || VK_EXT_shader_long_vector
# REQUIRES: Clang || SM_6_9

# RUN: split-file %s %t
# RUN: %dxc_target -T %if Clang %{cs_6_0 %long_vector_flags%} %else %{cs_6_9%} -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
# RUN: %if Clang && Vulkan %{ %dxc_target %long_vector_flags -T cs_6_0 -Fc - %t/source.hlsl | FileCheck %s --check-prefix=SPIRV %}

# Check for the 16-component type, since the buffer comparison also passes on
# split code. Sin itself is still split into 4-component pieces:
# https://github.com/llvm/llvm-project/issues/244302
# SPIRV-DAG: OpCapability LongVectorEXT
# SPIRV-DAG: OpExtension "SPV_EXT_long_vector"
# SPIRV-DAG: %[[#FLOAT:]] = OpTypeFloat 32
# SPIRV-DAG: %[[#C16:]] = OpConstant %[[#]] 16{{ *$}}
# SPIRV-DAG: %[[#]] = OpTypeVectorIdEXT %[[#FLOAT]] %[[#C16]]

