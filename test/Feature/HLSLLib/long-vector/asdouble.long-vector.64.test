#--- source.hlsl

ByteAddressBuffer In0 : register(t0);
ByteAddressBuffer In1 : register(t1);
RWByteAddressBuffer Out : register(u2);

[numthreads(1,1,1)]
void main() {
  Out.Store<vector<double, 8> >(0, asdouble(In0.Load<vector<uint, 8> >(0),
      In1.Load<vector<uint, 8> >(0)));
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In0
    Format: UInt32
    Stride: 4
    Data: [0, 0, 0, 0, 0, 0, 0, 0]
  - Name: In1
    Format: UInt32
    Stride: 4
    Data: [0, 1072693248, 3220176896, 1073741824, 1071644672, 0, 1072693248, 3220176896]
  - Name: Out
    Format: Float64
    Stride: 8
    FillSize: 64
  - Name: ExpectedOut
    Format: Float64
    Stride: 8
    Data: [0, 1, -1, 2, 0.5, 0, 1, -1]
Results:
  - Result: Test
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In0
      Kind: ByteAddressBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: In1
      Kind: ByteAddressBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: Out
      Kind: RWByteAddressBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
...
#--- end

# Unimplemented https://github.com/llvm/wg-hlsl/issues/467
# XFAIL: Vulkan

# Unimplemented https://github.com/llvm/llvm-project/issues/220614
# XFAIL: Clang

# Bug https://github.com/llvm/offload-test-suite/issues/1506
# Note We fail for DXC because today Clang scalairzed and does
# Not hit  IRErrorCodeUnsupportedInstruction on vector @dx.op.*
# XFAIL: Metal && DXC

#REQUIRES: Double

# RUN: split-file %s %t
# RUN: %dxc_target -T %if Clang %{cs_6_0%} %else %{cs_6_9%} -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o

