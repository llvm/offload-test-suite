#--- source.hlsl

ByteAddressBuffer In0 : register(t0);
RWByteAddressBuffer Out : register(u1);

[numthreads(1,1,1)]
void main() {
  Out.Store<vector<float, 5>>(0, f16tof32(In0.Load<vector<uint, 5>>(0)));
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In0
    Format: UInt32
    Stride: 4
    Data: [0, 15360, 49152, 13653, 31743]
  - Name: Out
    Format: Float32
    Stride: 4
    FillSize: 20
  - Name: ExpectedOut
    Format: Float32
    Stride: 4
    Data: [0, 1, -2, 0.333251953, 65504]
Results:
  - Result: Test
    Rule: BufferFloatEpsilon
    Epsilon: 0.008
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In0
      Kind: ByteAddressBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWByteAddressBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# Unimplemented https://github.com/llvm/wg-hlsl/issues/467
# XFAIL: Vulkan && DXC

# RUN: split-file %s %t
# RUN: %dxc_target -T %if Clang %{cs_6_0%} %else %{cs_6_9%} -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o

