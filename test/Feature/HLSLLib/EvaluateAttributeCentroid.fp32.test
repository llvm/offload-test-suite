#--- vertex.hlsl
struct VSOutput {
  float4 Pos : SV_Position;
  float S : ATTR0;
  float2 V2 : ATTR1;
  float3 V3 : ATTR2;
  float4 V4 : ATTR3;
};

VSOutput main(float2 Position : POSITION) {
  // Pixel coordinate of this vertex in the 1x1 render target.
  float2 P = float2(Position.x + 1, 1 - Position.y) / 2;
  VSOutput O;
  O.Pos = float4(Position, 0, 1);
  O.S = P.x + 1;
  O.V2 = P + float2(2, 3);
  O.V3 = P.xyx + float3(4, 5, 6);
  O.V4 = P.xyxy + float4(7, 8, 9, 10);
  return O;
}

#--- pixel.hlsl
struct PSInput {
  float4 Pos : SV_Position;
  float S : ATTR0;
  float2 V2 : ATTR1;
  float3 V3 : ATTR2;
  float4 V4 : ATTR3;
};

RWStructuredBuffer<float4> Out : register(u0);

float4 main(PSInput I) : SV_Target {
  Out[0] = float4(EvaluateAttributeCentroid(I.S), 0, 0, 0);
  Out[1] = float4(EvaluateAttributeCentroid(I.V2), 0, 0);
  Out[2] = float4(EvaluateAttributeCentroid(I.V3), 0);
  Out[3] = EvaluateAttributeCentroid(I.V4);
  return 0;
}

#--- pipeline.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
Buffers:
  - Name: VertexData
    Format: Float32
    Stride: 8
    Data: [-1, -1, 3, -1, -1, 3]
  - Name: RenderTarget
    Format: Float32
    Channels: 4
    FillSize: 16
    OutputProps:
      Height: 1
      Width: 1
      Depth: 1
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 64
    FillValue: 100 # Any value the shader does not write fails.
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    Data: [1.5, 0, 0, 0,
           2.5, 3.5, 0, 0,
           4.5, 5.5, 6.5, 0,
           7.5, 8.5, 9.5, 10.5]
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 2
      Offset: 0
      Name: POSITION
  RenderTarget: RenderTarget
DescriptorSets:
  - Resources:
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
Results:
  - Result: Evaluate
    Rule: BufferFloatEpsilon
    Epsilon: 0.001
    Actual: Out
    Expected: ExpectedOut
...
#--- end

# Without MSAA the centroid is the pixel center, (0.5, 0.5).

# Unimplemented https://github.com/llvm/llvm-project/issues/99110
# XFAIL: Clang

# REQUIRES: !Vulkan || VulkanSampleRateShading

# RUN: split-file %s %t
# RUN: %dxc_target -T vs_6_0 -Fo %t-vertex.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_0 -Fo %t-pixel.o %t/pixel.hlsl
# RUN: %offloader %t/pipeline.yaml %t-vertex.o %t-pixel.o
