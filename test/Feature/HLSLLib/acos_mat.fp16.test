#--- source.hlsl
StructuredBuffer<half4> In : register(t0);
RWStructuredBuffer<half4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  half3x2 r32 = acos(half3x2(In[0].xy, In[0].zw, In[1].xy));
  half2x4 r24 = acos(half2x4(In[1], In[2]));
  half3x1 r31 = acos(half3x1(In[0].x, In[1].x, In[2].x));
  half4x4 r44 = acos(half4x4(In[0], In[1], In[2], In[3]));

  Out[0]  = half4(r32[0], 0.0, 0.0);
  Out[1]  = half4(r32[1], 0.0, 0.0);
  Out[2]  = half4(r32[2], 0.0, 0.0);
  Out[3]  = r24[0];
  Out[4]  = r24[1];
  Out[5]  = half4(r31[0], 0.0, 0.0, 0.0);
  Out[6]  = half4(r31[1], 0.0, 0.0, 0.0);
  Out[7]  = half4(r31[2], 0.0, 0.0, 0.0);
  Out[8]  = r44[0];
  Out[9]  = r44[1];
  Out[10] = r44[2];
  Out[11] = r44[3];
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float16
    Stride: 8
    Data: [ 0xBC00, 0xBAEE, 0xB9A8, 0xB800,
            0x0000, 0x3800, 0x39A8, 0x3AEE,
            0x3C00, 0xB800, 0x39A8, 0xBAEE,
            0xBAEE, 0x3AEE, 0xB800, 0xB9A8 ]
    # In[0]: -1, ~-sqrt3/2, ~-sqrt2/2, -0.5
    # In[1]: 0, 0.5, ~sqrt2/2, ~sqrt3/2
    # In[2]: 1, -0.5, ~sqrt2/2, ~-sqrt3/2
    # In[3]: ~-sqrt3/2, ~sqrt3/2, -0.5, ~-sqrt2/2
  - Name: Out
    Format: Float16
    Stride: 8
    FillSize: 96
  - Name: ExpectedOut
    Format: Float16
    Stride: 8
    Data: [ 0x4248, 0x413D, 0x0000, 0x0000,
            0x40B6, 0x4030, 0x0000, 0x0000,
            0x3E48, 0x3C30, 0x0000, 0x0000,
            0x3E48, 0x3C30, 0x3A49, 0x3830,
            0x0000, 0x4030, 0x3A49, 0x413D,
            0x4248, 0x0000, 0x0000, 0x0000,
            0x3E48, 0x0000, 0x0000, 0x0000,
            0x0000, 0x0000, 0x0000, 0x0000,
            0x4248, 0x413D, 0x40B6, 0x4030,
            0x3E48, 0x3C30, 0x3A49, 0x3830,
            0x0000, 0x4030, 0x3A49, 0x413D,
            0x413D, 0x3830, 0x4030, 0x40B6 ]
    # acos(-1)=pi~0x4248, acos(-sqrt3/2)=5pi/6~0x413D, acos(-sqrt2/2)=3pi/4~0x40B6
    # acos(-0.5)=2pi/3~0x4030, acos(0)=pi/2~0x3E48, acos(0.5)=pi/3~0x3C30
    # acos(sqrt2/2)=pi/4~0x3A49, acos(sqrt3/2)=pi/6~0x3830, acos(1)=0=0x0000
Results:
  - Result: Test1
    Rule: BufferFloatULP
    ULPT: 2
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# REQUIRES: Half
# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
