# REQUIRES: Int64 && WaveMultiPrefix

# DXC emits SPIR-V subgroup operations with unsupported matrix types.
# Bug: https://github.com/microsoft/DirectXShaderCompiler/issues/7093
# XFAIL: DXC && Vulkan

# The Metal shader converter does not support 64-bit wave operations.
# Bug: https://github.com/llvm/offload-test-suite/issues/959
# XFAIL: Metal && (Clang || DXC)

# RUN: split-file %S/Inputs/WaveMultiPrefixProduct.test %t
# RUN: %dxc_target -T cs_6_5 -DTYPE_BITS=64 -DMATRIX_ROWS=3 -DMATRIX_COLS=2 \
# RUN:   -Fo %t.o %t/matrix.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
# RUN: %dxc_target -T cs_6_5 -DTYPE_BITS=64 -DMATRIX_ROWS=2 -DMATRIX_COLS=3 \
# RUN:   -Fo %t.o %t/matrix.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
# RUN: %dxc_target -T cs_6_5 -DTYPE_BITS=64 -DMATRIX_ROWS=3 -DMATRIX_COLS=1 \
# RUN:   -Fo %t.o %t/matrix.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
# RUN: %dxc_target -T cs_6_5 -DTYPE_BITS=64 -DMATRIX_ROWS=4 -DMATRIX_COLS=4 \
# RUN:   -Fo %t.o %t/matrix.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
