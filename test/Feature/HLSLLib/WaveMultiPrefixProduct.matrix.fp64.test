# REQUIRES: Double && WaveMultiPrefix

# DXC emits SPIR-V subgroup operations with unsupported matrix types.
# Bug: https://github.com/microsoft/DirectXShaderCompiler/issues/7093
# XFAIL: DXC && Vulkan

# Bug: https://github.com/llvm/offload-test-suite/issues/1720
# XFAIL: WARP && DirectX && !arm64

# RUN: split-file %S/Inputs/WaveMultiPrefixProduct.test %t
# RUN: %dxc_target -T cs_6_5 -DTYPE_BITS=64 -DTEST_FLOAT=1 \
# RUN:   -DTEST_MATRIX=1 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
