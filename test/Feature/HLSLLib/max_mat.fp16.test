#--- source.hlsl
StructuredBuffer<half4> X : register(t0);
StructuredBuffer<half4> Y : register(t1);

RWStructuredBuffer<half4> Out : register(u2);

[numthreads(1,1,1)]
void main() {
  half3x2 M32 = max(half3x2(X[0].xyz, X[1].xyz),
                    half3x2(Y[0].xyz, Y[1].xyz));
  half2x4 M24 = max(half2x4(X[2], X[3]),
                    half2x4(Y[2], Y[3]));
  half3x1 M31 = max(half3x1(X[4].xyz),
                    half3x1(Y[4].xyz));
  half4x4 M44 = max(half4x4(X[5], X[6], X[7], X[8]),
                    half4x4(Y[5], Y[6], Y[7], Y[8]));
  half2x2 M22Const = max(half2x2(-60000.0, 2.5, 30.0, 60000.0),
                         half2x2(0.0, 2.6, -50.0, 0.0));

  Out[0] = half4(M32[0], M32[1]);
  Out[1] = half4(M32[2], 0.0, 0.0);
  Out[2] = M24[0];
  Out[3] = M24[1];
  Out[4] = half4(M31[0], M31[1], M31[2], 0.0);
  Out[5] = M44[0];
  Out[6] = M44[1];
  Out[7] = M44[2];
  Out[8] = M44[3];
  Out[9] = half4(M22Const[0], M22Const[1]);
}
//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: X
    Format: Float16
    Stride: 8
    Data: [ 0x4500, 0x4800, 0x4880, 0x0000,
            0x4400, 0x4700, 0x0000, 0x0000,
            0x4900, 0x4a00, 0x4200, 0x4b80,
            0x4600, 0x4d00, 0x4980, 0x4700,
            0x4000, 0x4a80, 0x4500, 0x0000,
            0xfb53, 0x4100, 0x4f80, 0x7b53,
            0xbc00, 0x5640, 0xd240, 0x4e60,
            0x4200, 0xc200, 0x4780, 0xc200,
            0x5240, 0xce40, 0x4480, 0x4880 ]
    # 3x2: 5, 8, 9, _, 4, 7, 0, _
    # 2x4: 10, 12, 3, 15, 6, 20, 11, 7
    # 3x1: 2, 13, 5, _
    # 4x4: -60000, 2.5, 30, 60000, -1, 100, -50, 25.5,
    #      3, -3, 7.5, -3, 50, -25, 4.5, 9
  - Name: Y
    Format: Float16
    Stride: 8
    Data: [ 0x4400, 0x4000, 0x4900, 0x0000,
            0x4400, 0x0000, 0x4600, 0x0000,
            0x4980, 0x4a00, 0x4000, 0x4700,
            0x4500, 0x4c80, 0x4b00, 0x4800,
            0x4880, 0x4a00, 0x4500, 0x0000,
            0x0000, 0x4133, 0xd240, 0x0000,
            0xc000, 0x5630, 0x5240, 0x4e66,
            0x4200, 0x4400, 0x4766, 0xc200,
            0xd240, 0xce00, 0x449a, 0x4800 ]
    # 3x2: 4, 2, 10, _, 4, 0, 6, _
    # 2x4: 11, 12, 2, 7, 5, 18, 14, 8
    # 3x1: 9, 12, 5, _
    # 4x4: 0, 2.6, -50, 0, -2, 99, 50, 25.6,
    #      3, 4, 7.4, -3, -50, -24, 4.6, 8
  - Name: Out
    Format: Float16
    Stride: 8
    FillSize: 80
  - Name: ExpectedOut
    Format: Float16
    Stride: 8
    Data: [ 0x4500, 0x4800, 0x4900, 0x4400,
            0x4700, 0x4600, 0x0000, 0x0000,
            0x4980, 0x4a00, 0x4200, 0x4b80,
            0x4600, 0x4d00, 0x4b00, 0x4800,
            0x4880, 0x4a80, 0x4500, 0x0000,
            0x0000, 0x4133, 0x4f80, 0x7b53,
            0xbc00, 0x5640, 0x5240, 0x4e66,
            0x4200, 0x4400, 0x4780, 0xc200,
            0x5240, 0xce00, 0x449a, 0x4880,
            0x0000, 0x4133, 0x4f80, 0x7b53 ]
    # 3x2: 5, 8, 10, 4, 7, 6, _, _
    # 2x4: 11, 12, 3, 15, 6, 20, 14, 8
    # 3x1: 9, 13, 5, _
    # 4x4: 0, 2.6, 30, 60000, -1, 100, 50, 25.6,
    #      3, 4, 7.5, -3, 50, -24, 4.6, 9
    # 2x2 const: 0, 2.6, 30, 60000
Results:
  - Result: Test
    Rule: BufferFloatEpsilon
    Epsilon: 0
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: X
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Y
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
#--- end

# Unimplemented https://github.com/llvm/llvm-project/issues/184511
# XFAIL: Clang

# REQUIRES: Half
# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
