#--- source.hlsl

StructuredBuffer<float4> In : register(t0);

RWStructuredBuffer<float4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  Out[0] = float4(tan(In[0].x), tan(In[0].yzw));
  Out[1] = tan(In[1]);
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float32
    Stride: 16
    Data: [ nan, -inf, -0x1.e7d42cp-127, 0x1.e7d42cp-127, inf, nan, nan, nan ]
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 32
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    Data: [ nan, nan, -0x1.e7d42cp-127, 0x1.e7d42cp-127, nan, nan, nan, nan ]
    # tan(x)~x for tiny x, so tan(+-denorm)=+-denorm
Results:
  - Result: Test1
    Rule: BufferFloatEpsilon
    Epsilon: 0.0008
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -Gis -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
