# REQUIRES: Int64 && WaveMultiPrefix

# DXC emits SPIR-V subgroup operations with unsupported matrix types.
# Bug: https://github.com/microsoft/DirectXShaderCompiler/issues/7093
# XFAIL: DXC && Vulkan

# The Metal shader converter does not support 64-bit wave operations.
# Bug: https://github.com/llvm/offload-test-suite/issues/959
# XFAIL: Metal && (Clang || DXC)

# RUN: split-file %S/Inputs/WaveMultiPrefixBitXor.test %t
# RUN: %dxc_target -T cs_6_5 -DTYPE_BITS=64 -DTEST_MATRIX=1 -Fo %t.o \
# RUN:   %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
