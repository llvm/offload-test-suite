# REQUIRES: (!DirectX || WaveMultiPrefix)

# Unimplemented for SPIR-V:
# Clang: https://github.com/llvm/llvm-project/issues/240510
# DXC: https://github.com/microsoft/DirectXShaderCompiler/issues/9127
# XFAIL: Vulkan

# DXC and Clang return incorrect counts on Metal with inactive lanes.
# Bug: https://github.com/llvm/offload-test-suite/issues/1712
# XFAIL: Metal

# RUN: split-file %S/Inputs/WaveMultiPrefixCountBits.test %t
# RUN: %dxc_target -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
