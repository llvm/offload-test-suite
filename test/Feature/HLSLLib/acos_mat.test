#--- source.hlsl
StructuredBuffer<float4> In : register(t0);
RWStructuredBuffer<float4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  float3x2 R32 = acos(float3x2(In[0].xy, In[0].zw, In[1].xy));
  float2x4 R24 = acos(float2x4(In[1], In[2]));
  float3x1 R31 = acos(float3x1(In[4].xyz));
  float4x4 R44 = acos(float4x4(In[5], In[6], In[7], In[8]));
  float2x2 R22 = acos(float2x2(-1.0, -0.5, 0.5, 1.0));

  Out[0] = float4(R32[0], R32[1]);
  Out[1] = float4(R32[2], 0.0, 0.0);
  Out[2] = R24[0];
  Out[3] = R24[1];
  Out[4] = float4(R31[0], R31[1], R31[2], 0.0);
  Out[5] = R44[0];
  Out[6] = R44[1];
  Out[7] = R44[2];
  Out[8] = R44[3];
  Out[9] = float4(R22[0], R22[1]);
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float32
    Stride: 16
    Data: [ -1.0, -0.86603, -0.70711, -0.5,
            0.0, 0.5, 0.70711, 0.86603,
            1.0, -0.5, 0.70711, -0.86603,
            -0.86603, 0.86603, -0.5, -0.70711,
            -1.0, -0.5, 0.5, 1.0,
            -1.0, -0.86603, -0.70711, -0.5,
            0.0, 0.5, 0.70711, 0.86603,
            1.0, -0.5, 0.70711, -0.86603,
            -0.86603, 0.86603, -0.5, -0.70711 ]
    # 3x2: -1, -sqrt(3)/2, -1/sqrt(2), -0.5, 0, 0.5, _, _
    # 2x4: 0, 0.5, 1/sqrt(2), sqrt(3)/2, 1, -0.5, 1/sqrt(2), -sqrt(3)/2
    # 3x1: -1, -0.5, 0.5, _
    # 4x4: -1, -sqrt(3)/2, -1/sqrt(2), -0.5, 0, 0.5, 1/sqrt(2), sqrt(3)/2,
    #       1, -0.5, 1/sqrt(2), -sqrt(3)/2, -sqrt(3)/2, sqrt(3)/2, -0.5, -1/sqrt(2)
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 160
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    Data: [ 3.14159, 2.61799, 2.35619, 2.0944,
            1.5708, 1.0472, 0.0, 0.0,
            1.5708, 1.0472, 0.7854, 0.5236,
            0.0, 2.0944, 0.7854, 2.61799,
            3.14159, 2.0944, 1.0472, 0.0,
            3.14159, 2.61799, 2.35619, 2.0944,
            1.5708, 1.0472, 0.7854, 0.5236,
            0.0, 2.0944, 0.7854, 2.61799,
            2.61799, 0.5236, 2.0944, 2.35619,
            3.14159, 2.0944, 1.0472, 0.0 ]
Results:
  - Result: Test1
    Rule: BufferFloatEpsilon
    Epsilon: 0.0008
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
