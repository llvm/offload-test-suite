#--- source.hlsl
StructuredBuffer<float4> In : register(t0);
RWStructuredBuffer<float4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  float3x2 R32 = exp(float3x2(In[0].xyz, In[1].xyz));
  float2x4 R24 = exp(float2x4(In[2], In[3]));
  float3x1 R31 = exp(float3x1(In[4].xyz));
  float4x4 R44 = exp(float4x4(In[0], In[1], In[2], In[3]));
  float2x2 R22Const = exp(float2x2(-1.0, 0.0, 1.0, 2.0));

  Out[0] = float4(R32[0], R32[1]);
  Out[1] = float4(R32[2], 0.0, 0.0);
  Out[2] = R24[0];
  Out[3] = R24[1];
  Out[4] = float4(R31[0], R31[1], R31[2], 0.0);
  Out[5] = R44[0];
  Out[6] = R44[1];
  Out[7] = R44[2];
  Out[8] = R44[3];
  Out[9] = float4(R22Const[0], R22Const[1]);
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float32
    Stride: 16
    Data: [ -10.0, -2.0, -1.0, 0.0,
            0.5, 1.0, 2.0, 4.0,
            3.0, 0.5, 5.0, 2.0,
            -2.0, 4.0, 0.5, -1.0,
            -1.0, 0.0, 1.0, 0.0 ]
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 160
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    Data: [ 4.539993e-05, 0.13533528, 0.36787945, 1.6487212,
            2.7182817, 7.389056, 0.0, 0.0,
            20.085537, 1.6487212, 148.4131622, 7.389056,
            0.13533528, 54.59815, 1.6487212, 0.36787945,
            0.36787945, 1.0, 2.7182817, 0.0,
            4.539993e-05, 0.13533528, 0.36787945, 1.0,
            1.6487212, 2.7182817, 7.389056, 54.59815,
            20.085537, 1.6487212, 148.4131622, 7.389056,
            0.13533528, 54.59815, 1.6487212, 0.36787945,
            0.36787945, 1.0, 2.7182817, 7.389056 ]
Results:
  - Result: Test1
    Rule: BufferFloatULP
    ULPT: 2
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
