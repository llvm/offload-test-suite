#--- source.hlsl
StructuredBuffer<float4> In : register(t0);
RWStructuredBuffer<float4> Out : register(u1);
RWStructuredBuffer<float4> ExpOut : register(u2);

[numthreads(1,1,1)]
void main() {
  float4 E4;
  Out[0] = frexp(In[0], E4);
  ExpOut[0] = E4;

  float3 E3;
  float E1;
  Out[1] = float4(frexp(In[1].xyz, E3), frexp(In[1].w, E1));
  ExpOut[1] = float4(E3, E1);

  float2 E2a, E2b;
  Out[2] = float4(frexp(In[2].xy, E2a), frexp(In[2].zw, E2b));
  ExpOut[2] = float4(E2a, E2b);

  float4 E4b;
  Out[3] = frexp(In[3], E4b);
  ExpOut[3] = E4b;
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float32
    Stride: 16
    Data: [ 0.125, 0.25, 0.5, 1,
            2, 4, 8, 10,
            -0.375, 0.1, 1000.5, -12345.678,
            0, 5.5, -2.25, 0.00001 ]
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 64
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    Data: [ 0.5, 0.5, 0.5, 0.5,
            0.5, 0.5, 0.5, 0.625,
            -0.75, 0.8, 0.9770508, -0.75352037,
            0, 0.6875, -0.5625, 0.65536 ]
  - Name: ExpOut
    Format: Float32
    Stride: 16
    FillSize: 64
  - Name: ExpectedExpOut
    Format: Float32
    Stride: 16
    Data: [ -2, -1, 0, 1,
            2, 3, 4, 4,
            -1, -3, 10, 14,
            0, 3, 2, -16 ]
Results:
  - Result: Mantissa
    Rule: BufferFloatULP
    ULPT: 1
    Actual: Out
    Expected: ExpectedOut
  - Result: Exponent
    Rule: BufferFloatULP
    ULPT: 0
    Actual: ExpOut
    Expected: ExpectedExpOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: ExpOut
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
#--- end

# Unimplemented https://github.com/llvm/llvm-project/issues/99119
# XFAIL: Clang

# DXC loses the sign of the mantissa for negative inputs when targeting
# DirectX or Metal.
# XFAIL: DXC && DirectX
# XFAIL: DXC && Metal

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_3 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
