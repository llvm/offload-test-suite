#--- source.hlsl
StructuredBuffer<float4> In : register(t0);
RWStructuredBuffer<float4> MantissaOut : register(u1);
RWStructuredBuffer<float4> ExponentOut : register(u2);

[numthreads(1,1,1)]
void main() {
  float E1;
  float2 E2a, E2b;
  float3 E3;
  float4 E4a, E4b, E4c;

  MantissaOut[0] = frexp(In[0], E4a);
  ExponentOut[0] = E4a;

  MantissaOut[1] = float4(frexp(In[1].xyz, E3), frexp(In[1].w, E1));
  ExponentOut[1] = float4(E3, E1);

  MantissaOut[2] = float4(frexp(In[2].xy, E2a), frexp(In[2].zw, E2b));
  ExponentOut[2] = float4(E2a, E2b);

  MantissaOut[3] = frexp(In[3], E4b);
  ExponentOut[3] = E4b;

  MantissaOut[4] = frexp(float4(0.125, 4, 1000.5, 0.00001), E4c);
  ExponentOut[4] = E4c;
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float32
    Stride: 16
    Data: [ 0.125, 0.25, 0.5, 1,
            2, 4, 8, 10,
            -0.375, 0.1, 1000.5, -12345.678,
            0, 5.5, -2.25, 0.00001 ]
  - Name: MantissaOut
    Format: Float32
    Stride: 16
    FillSize: 80
  - Name: ExpectedMantissaOut
    Format: Float32
    Stride: 16
    Data: [ 0.5, 0.5, 0.5, 0.5,
            0.5, 0.5, 0.5, 0.625,
            -0.75, 0.8, 0.9770508, -0.75352037,
            0, 0.6875, -0.5625, 0.65536,
            0.5, 0.5, 0.9770508, 0.65536 ]
  - Name: ExponentOut
    Format: Float32
    Stride: 16
    FillSize: 80
  - Name: ExpectedExponentOut
    Format: Float32
    Stride: 16
    Data: [ -2, -1, 0, 1,
            2, 3, 4, 4,
            -1, -3, 10, 14,
            0, 3, 2, -16,
            -2, 3, 10, -16 ]
Results:
  - Result: Mantissa
    Rule: BufferExact
    Actual: MantissaOut
    Expected: ExpectedMantissaOut
  - Result: Exponent
    Rule: BufferExact
    Actual: ExponentOut
    Expected: ExpectedExponentOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: MantissaOut
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: ExponentOut
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
#--- end

# Unimplemented https://github.com/llvm/llvm-project/issues/99119
# XFAIL: Clang

# Bug https://github.com/microsoft/DirectXShaderCompiler/issues/9155
# XFAIL: DXC && DirectX
# XFAIL: DXC && Metal

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_3 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
