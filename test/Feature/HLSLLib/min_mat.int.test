#--- source.hlsl
StructuredBuffer<int4> X : register(t0);
StructuredBuffer<int4> Y : register(t1);

RWStructuredBuffer<int4> Out : register(u2);

[numthreads(1,1,1)]
void main() {
  int3x2 I32 = min(int3x2(X[0].xyz, X[1].xyz),
                   int3x2(Y[0].xyz, Y[1].xyz));
  int2x4 I24 = min(int2x4(X[2], X[3]),
                   int2x4(Y[2], Y[3]));
  int3x1 I31 = min(int3x1(X[4].xyz),
                   int3x1(Y[4].xyz));
  int4x4 I44 = min(int4x4(X[5], X[6], X[7], X[8]),
                   int4x4(Y[5], Y[6], Y[7], Y[8]));
  int2x2 I22Const = min(int2x2(-2147483648, 2, 30, 2147483647),
                        int2x2(0, 3, -50, 0));

  Out[0] = int4(I32[0], I32[1]);
  Out[1] = int4(I32[2], 0, 0);
  Out[2] = I24[0];
  Out[3] = I24[1];
  Out[4] = int4(I31[0], I31[1], I31[2], 0);
  Out[5] = I44[0];
  Out[6] = I44[1];
  Out[7] = I44[2];
  Out[8] = I44[3];
  Out[9] = int4(I22Const[0], I22Const[1]);
}
//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: X
    Format: Int32
    Stride: 16
    Data: [ 5, 8, 9, 0,
            4, 7, 0, 0,
            10, 12, 3, 15,
            6, 20, 11, 7,
            2, 13, 5, 0,
            -2147483648, 2, 30, 2147483647,
            -1, 100, -50, 25,
            3, -3, 8, -3,
            50, -25, 4, 9 ]
  - Name: Y
    Format: Int32
    Stride: 16
    Data: [ 4, 2, 10, 0,
            4, 0, 6, 0,
            11, 12, 2, 7,
            5, 18, 14, 8,
            9, 12, 5, 0,
            0, 3, -50, 0,
            -2, 99, 50, 26,
            3, 4, 7, -3,
            -50, -24, 5, 8 ]
  - Name: Out
    Format: Int32
    Stride: 16
    FillSize: 160
  - Name: ExpectedOut
    Format: Int32
    Stride: 16
    Data: [ 4, 2, 9, 4,
            0, 0, 0, 0,
            10, 12, 2, 7,
            5, 18, 11, 7,
            2, 12, 5, 0,
            -2147483648, 2, -50, 0,
            -2, 99, -50, 25,
            3, -3, 7, -3,
            -50, -25, 4, 8,
            -2147483648, 2, -50, 0 ]
Results:
  - Result: Test
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: X
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Y
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
#--- end

# RUN: split-file %s %t
# RUN: %dxc_target -HV 202x -T cs_6_0 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
