#--- source.hlsl

StructuredBuffer<int16_t4> In : register(t0);
RWStructuredBuffer<uint> Out : register(u1);

[numthreads(1, 1, 1)]
void main() {
  int16_t4 UnpackedVals = In[0];
  uint8_t4_packed PackedVals = pack_clamp_u8(UnpackedVals);
  Out[0] = PackedVals;
  Out[1] = pack_clamp_u8(In[1]);
  Out[2] = pack_clamp_u8(int16_t4(3, 5, 7, 11));
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Int16
    Stride: 2
    Data: [ -1, 0, 255, 256, 0, 1, 16, 42 ]
  - Name: Out
    Format: UInt32
    Stride: 4
    FillSize: 12
  - Name: ExpectedOut
    Format: UInt32
    Stride: 4
    Data: [ 4294901760, 705691904, 185009411 ] # First values clamped to 0 0 255 255, others untouched
Results:
  - Result: Test1
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

