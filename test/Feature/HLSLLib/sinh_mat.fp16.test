#--- source.hlsl
StructuredBuffer<half4> In : register(t0);
RWStructuredBuffer<half4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  half3x2 r32 = sinh(half3x2(In[0].xy, In[0].zw, In[1].xy));
  half2x4 r24 = sinh(half2x4(In[1], In[2]));
  half3x1 r31 = sinh(half3x1(In[0].x, In[1].x, In[2].x));
  half4x4 r44 = sinh(half4x4(In[0], In[1], In[2], In[3]));

  Out[0]  = half4(r32[0], 0.0, 0.0);
  Out[1]  = half4(r32[1], 0.0, 0.0);
  Out[2]  = half4(r32[2], 0.0, 0.0);
  Out[3]  = r24[0];
  Out[4]  = r24[1];
  Out[5]  = half4(r31[0], 0.0, 0.0, 0.0);
  Out[6]  = half4(r31[1], 0.0, 0.0, 0.0);
  Out[7]  = half4(r31[2], 0.0, 0.0, 0.0);
  Out[8]  = r44[0];
  Out[9]  = r44[1];
  Out[10] = r44[2];
  Out[11] = r44[3];
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float16
    Stride: 8
    Data: [ 0xD5A0, 0xC000, 0xBC00, 0xB800,
            0xB400, 0x0000, 0x3400, 0x3800,
            0x3C00, 0x4000, 0x55A0, 0xB400,
            0xC000, 0x3800, 0x4000, 0xBC00 ]
    # In[0]: -90, -2, -1, -0.5
    # In[1]: -0.25, 0, 0.25, 0.5
    # In[2]: 1, 2, 90, -0.25 (reuse)
    # In[3]: -2, 0.5, 2, -1
  - Name: Out
    Format: Float16
    Stride: 8
    FillSize: 96
  - Name: ExpectedOut
    Format: Float16
    Stride: 8
    Data: [ 0xFC00, 0xC341, 0x0000, 0x0000,
            0xBCB3, 0xB82B, 0x0000, 0x0000,
            0xB40B, 0x0000, 0x0000, 0x0000,
            0xB40B, 0x0000, 0x340B, 0x382B,
            0x3CB3, 0x4341, 0x7C00, 0xB40B,
            0xFC00, 0x0000, 0x0000, 0x0000,
            0xB40B, 0x0000, 0x0000, 0x0000,
            0x3CB3, 0x0000, 0x0000, 0x0000,
            0xFC00, 0xC341, 0xBCB3, 0xB82B,
            0xB40B, 0x0000, 0x340B, 0x382B,
            0x3CB3, 0x4341, 0x7C00, 0xB40B,
            0xC341, 0x382B, 0x4341, 0xBCB3 ]
    # sinh(-90)=-inf=0xFC00, sinh(-2)~-3.627=0xC341, sinh(-1)~-1.175=0xBCB3
    # sinh(-0.5)~-0.521=0xB82B, sinh(-0.25)~-0.253=0xB40B, sinh(0)=0
    # sinh(0.25)~0.253=0x340B, sinh(0.5)~0.521=0x382B, sinh(1)~1.175=0x3CB3
    # sinh(2)~3.627=0x4341, sinh(90)=+inf=0x7C00
Results:
  - Result: Test1
    Rule: BufferFloatULP
    ULPT: 2
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# REQUIRES: Half
# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
