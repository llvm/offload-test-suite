#--- source.hlsl
StructuredBuffer<half4> In : register(t0);
RWStructuredBuffer<half4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  half3x2 r32 = rcp(half3x2(In[0].xy, In[0].zw, In[1].xy));
  half2x4 r24 = rcp(half2x4(In[1], In[2]));
  half3x1 r31 = rcp(half3x1(In[0].x, In[1].x, In[2].x));
  half4x4 r44 = rcp(half4x4(In[0], In[1], In[2], In[3]));

  Out[0]  = half4(r32[0], 0.0, 0.0);
  Out[1]  = half4(r32[1], 0.0, 0.0);
  Out[2]  = half4(r32[2], 0.0, 0.0);
  Out[3]  = r24[0];
  Out[4]  = r24[1];
  Out[5]  = half4(r31[0], 0.0, 0.0, 0.0);
  Out[6]  = half4(r31[1], 0.0, 0.0, 0.0);
  Out[7]  = half4(r31[2], 0.0, 0.0, 0.0);
  Out[8]  = r44[0];
  Out[9]  = r44[1];
  Out[10] = r44[2];
  Out[11] = r44[3];
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float16
    Stride: 8
    Data: [ 0xC000, 0xBC00, 0xB800, 0x0000,
            0x3800, 0x3C00, 0x4000, 0x4400,
            0x4900, 0xBC00, 0x3800, 0xC000,
            0xBC00, 0x4000, 0x4900, 0xB800 ]
    # In[0]: -2, -1, -0.5, 0
    # In[1]: 0.5, 1, 2, 4
    # In[2]: 10, -1, 0.5, -2
    # In[3]: -1, 2, 10, -0.5
  - Name: Out
    Format: Float16
    Stride: 8
    FillSize: 96
  - Name: ExpectedOut
    Format: Float16
    Stride: 8
    Data: [ 0xB800, 0xBC00, 0x0000, 0x0000,
            0xC000, 0x7C00, 0x0000, 0x0000,
            0x4000, 0x3C00, 0x0000, 0x0000,
            0x4000, 0x3C00, 0x3800, 0x3400,
            0x2E66, 0xBC00, 0x4000, 0xB800,
            0xB800, 0x0000, 0x0000, 0x0000,
            0x4000, 0x0000, 0x0000, 0x0000,
            0x2E66, 0x0000, 0x0000, 0x0000,
            0xB800, 0xBC00, 0xC000, 0x7C00,
            0x4000, 0x3C00, 0x3800, 0x3400,
            0x2E66, 0xBC00, 0x4000, 0xB800,
            0xBC00, 0x3800, 0x2E66, 0xC000 ]
    # rcp(-2)=-0.5=0xB800, rcp(-1)=-1=0xBC00, rcp(-0.5)=-2=0xC000, rcp(0)=+inf=0x7C00
    # rcp(0.5)=2=0x4000, rcp(1)=1=0x3C00, rcp(2)=0.5=0x3800, rcp(4)=0.25=0x3400
    # rcp(10)~0.1~0x2E66
Results:
  - Result: Test1
    Rule: BufferFloatEpsilon
    Epsilon: 0.0008
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# REQUIRES: Half
# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
