#--- source.hlsl
StructuredBuffer<float4> In : register(t0);
RWStructuredBuffer<float4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  float3x2 R32 = tan(float3x2(In[0].xyz, In[1].xyz));
  float2x4 R24 = tan(float2x4(In[2], In[3]));
  float3x1 R31 = tan(float3x1(In[4].xyz));
  float4x4 R44 = tan(float4x4(In[5], In[6], In[7], In[8]));
  float2x2 R22 = tan(float2x2(0.0, 0.52359878, 0.78539816, 1.04719755)); // 0, pi/6, pi/4, pi/3

  Out[0] = float4(R32[0], R32[1]);
  Out[1] = float4(R32[2], 0.0, 0.0);
  Out[2] = R24[0];
  Out[3] = R24[1];
  Out[4] = float4(R31[0], R31[1], R31[2], 0.0);
  Out[5] = R44[0];
  Out[6] = R44[1];
  Out[7] = R44[2];
  Out[8] = R44[3];
  Out[9] = float4(R22[0], R22[1]);
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float32
    Stride: 16
    Data: [ -1.04719755, -0.78539816, -0.52359878, 0.0,
            -0.26179939, 0.0, 0.26179939, 0.0,
            0.0, 0.26179939, 0.52359878, 0.78539816,
            1.04719755, -1.04719755, 0.26179939, -0.26179939,
            -1.04719755, 0.0, 1.04719755, 0.0,
            -1.04719755, -0.78539816, -0.52359878, -0.26179939,
            0.0, 0.26179939, 0.52359878, 0.78539816,
            1.04719755, -1.04719755, 0.26179939, -0.26179939,
            -0.78539816, 0.78539816, -1.04719755, -0.52359878 ]
    # 3x2: -pi/3, -pi/4, -pi/6, _, -pi/12, 0, pi/12, _
    # 2x4: 0, pi/12, pi/6, pi/4, pi/3, -pi/3, pi/12, -pi/12
    # 3x1: -pi/3, 0, pi/3, _
    # 4x4: -pi/3, -pi/4, -pi/6, -pi/12, 0, pi/12, pi/6, pi/4,
    #      pi/3, -pi/3, pi/12, -pi/12, -pi/4, pi/4, -pi/3, -pi/6
  - Name: Out
    Format: Float32
    Stride: 16
    FillSize: 160
  - Name: ExpectedOut
    Format: Float32
    Stride: 16
    Data: [ -1.73205, -1.0, -0.57735, -0.26795,
            0.0, 0.26795, 0.0, 0.0,
            0.0, 0.26795, 0.57735, 1.0,
            1.73205, -1.73205, 0.26795, -0.26795,
            -1.73205, 0.0, 1.73205, 0.0,
            -1.73205, -1.0, -0.57735, -0.26795,
            0.0, 0.26795, 0.57735, 1.0,
            1.73205, -1.73205, 0.26795, -0.26795,
            -1.0, 1.0, -1.73205, -0.57735,
            0.0, 0.57735, 1.0, 1.73205 ]
    # 3x2: -sqrt(3), -1, -1/sqrt(3), sqrt(3)-2, 0, 2-sqrt(3), _, _
    # 2x4: 0, 2-sqrt(3), 1/sqrt(3), 1, sqrt(3), -sqrt(3), 2-sqrt(3), sqrt(3)-2
    # 3x1: -sqrt(3), 0, sqrt(3), _
    # 4x4: -sqrt(3), -1, -1/sqrt(3), sqrt(3)-2, 0, 2-sqrt(3), 1/sqrt(3), 1,
    #      sqrt(3), -sqrt(3), 2-sqrt(3), sqrt(3)-2, -1, 1, -sqrt(3), -1/sqrt(3)
Results:
  - Result: Test1
    Rule: BufferFloatEpsilon
    Epsilon: 0.0008
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
#--- end

# Unimplemented https://github.com/llvm/llvm-project/issues/184520
# XFAIL: Clang

# RUN: split-file %s %t
# RUN: %dxc_target -HV 202x -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
