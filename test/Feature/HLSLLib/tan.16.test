#--- source.hlsl

StructuredBuffer<half4> In : register(t0);

RWStructuredBuffer<half4> Out : register(u1);

[numthreads(1,1,1)]
void main() {
  Out[0] = tan(In[0]);
  half4 Tmp = {tan(In[1].xyz), tan(In[1].w)};
  Out[1] = Tmp;
  half4 Tmp2 = {tan(In[2].xy), tan(In[2].zw)};
  Out[2] = Tmp2;
}

//--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Float16
    Stride: 8
    Data: [ 0xBC30, 0xBA48, 0xB830, 0xB430,
            0x0000, 0x3430, 0x3830, 0x3A48,
            0x3C30, 0xBC30, 0x3430, 0xB430 ]
    # -pi/3, -pi/4, -pi/6, -pi/12
    # 0, pi/12, pi/6, pi/4
    # pi/3, -pi/3, pi/12, -pi/12
  - Name: Out
    Format: Float16
    Stride: 8
    FillSize: 24
  - Name: ExpectedOut
    Format: Float16
    Stride: 8
    Data: [ 0xBEEE, 0xBC00, 0xB89E, 0xB44A,
            0x0000, 0x344A, 0x389E, 0x3C00,
            0x3EEE, 0xBEEE, 0x344A, 0xB44A ]
    # -sqrt3, -1, -1/sqrt3, sqrt3-2
    # 0, 2-sqrt3, sqrt3/3, 1
    # sqrt3, -sqrt3, sqrt3/3, sqrt3-2
Results:
  - Result: Test1
    Rule: BufferFloatEpsilon
    Epsilon: 0.003
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# REQUIRES: Half
# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
