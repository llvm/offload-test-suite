            0x3800, 0x4400, 0x3e00, 0x0000,
            0x3800, 0x3d00, 0x4000, 0xc000,
            0x3400, 0x4800, 0xb400, 0x3c00,
            0x4c00, 0x3800, 0x3800, 0x0000,
            0x3800, 0x4000, 0x4400, 0x3c00,
            0x3800, 0xbc00, 0x3400, 0x3c00,
            0x3400, 0xbc00, 0x4000, 0x4400,
            0x4880, 0x4000, 0x3800, 0x3800 ]
    # 0.25, 0.5, -0.5, 0
