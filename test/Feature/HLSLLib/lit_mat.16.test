# REQUIRES: Half

# Bug: https://github.com/microsoft/DirectXShaderCompiler/issues/9123
# XFAIL: DXC && Vulkan

# Bug: https://github.com/llvm/llvm-project/issues/235864
# XFAIL: Clang && (DirectX || Metal)

# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
