            0x0000, 0x3800, 0x3c00, 0x0000,
            0x3c00, 0x4000, 0x4000, 0x3c00,
            0x3800, 0x3400, 0x4000, 0x4900,
            0x3400, 0x3c00, 0x4400, 0x0000,
            0x3c00, 0x3800, 0x3800, 0x3c00,
            0x4200, 0x4000, 0x3800, 0x5640,
            0x4000, 0x3c00, 0xbc00, 0xb800,
            0x3400, 0x3c00, 0x0000, 0x4800 ]
    # 2, 2, 3, 0
    # 0, 0.5, 1, 0
    # 1, 2, 2, 1
    # 0.5, 0.25, 2, 10
    # 0.25, 1, 4, 0
    # 1, 0.5, 0.5, 1
    # 3, 2, 0.5, 100
    # 2, 1, -1, -0.5
    # 0.25, 1, 0, 8
  - Name: Out
    Format: Float16
