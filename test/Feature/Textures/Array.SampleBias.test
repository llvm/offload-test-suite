#--- vertex.hlsl
struct VSInput {
  float3 Pos : POSITION;
};

struct VSOutput {
  float4 Pos : SV_POSITION;
};

VSOutput mainVS(VSInput input) {
  VSOutput output;
  output.Pos = float4(input.Pos, 1.0f);
  return output;
}

#--- pixel.hlsl
[[vk::binding(0, 0)]] Texture2DArray<float4> Tex : register(t0);
[[vk::binding(1, 0)]] SamplerState Samp : register(s0); // Mag=Nearest, Min=Linear
[[vk::binding(2, 0)]] RWBuffer<float4> Out : register(u0);

float4 mainPS(float4 Pos : SV_POSITION) : SV_Target {
  // The UVs have a derivative of exactly 0.5, so LOD = log2(0.5 * 2) = 0.0
  // before the bias. The slice count does not enter that calculation.
  uint2 GTid = (uint2)Pos.xy;
  float2 uv = 0.5 + float2(GTid.xy) * 0.5;

  // Mip selection is nearest, so a bias of 1.0 lands exactly on mip 1 while a
  // small positive bias would round back to mip 0. A negative bias keeps LOD
  // below 0 and so magnifies.
  float4 r0 = Tex.SampleBias(Samp, float3(uv, 0), -0.1); // slice 0 mip 0
  float4 r1 = Tex.SampleBias(Samp, float3(uv, 0), 1.0);  // slice 0 mip 1

  // The same pair on slice 1. r3 is the key case: the mip 1 it lands on must
  // be slice 1's own, not slice 0's.
  float4 r2 = Tex.SampleBias(Samp, float3(uv, 1), -0.1); // slice 1 mip 0
  float4 r3 = Tex.SampleBias(Samp, float3(uv, 1), 1.0);  // slice 1 mip 1

  // The LOD clamp argument is a *minimum* LOD: it raises a magnifying LOD of
  // -0.1 up to 1.0, reaching slice 1's mip 1 despite the negative bias.
  float4 r4 = Tex.SampleBias(Samp, float3(uv, 1), -0.1, int2(0, 0), 1.0);

  // A texel offset shifts the sample within the selected slice. uv is the
  // centre, so Nearest lands on texel (1,1); offsetting by (-1,-1) moves it to
  // texel (0,0) of that same slice.
  float4 r5 = Tex.SampleBias(Samp, float3(uv, 0), -0.1, int2(-1, -1));
  float4 r6 = Tex.SampleBias(Samp, float3(uv, 1), -0.1, int2(-1, -1));

  if (all(GTid.xy == 0)) {
    Out[0] = r0;
    Out[1] = r1;
    Out[2] = r2;
    Out[3] = r3;
    Out[4] = r4;
    Out[5] = r5;
    Out[6] = r6;
  }
  return float4(0, 0, 0, 0);
}

//--- pipeline.yaml
---
Shaders:
  - Stage: Vertex
    Entry: mainVS
  - Stage: Pixel
    Entry: mainPS

Buffers:
  # Slice-major, with the complete mip chain of each slice before the next:
  # slice 0 mip 0 (4 texels) then slice 0 mip 1 (1 texel), then the same for
  # slice 1.
  - Name: Tex
    Format: Float32
    Channels: 4
    OutputProps: { Width: 2, Height: 2, Depth: 1, MipLevels: 2, ArraySlices: 2 }
    Data: [ 1.0, 0.0, 0.0, 1.0,   # slice 0 mip 0 (0,0) Red
            0.0, 1.0, 0.0, 1.0,   # slice 0 mip 0 (1,0) Green
            0.0, 0.0, 1.0, 1.0,   # slice 0 mip 0 (0,1) Blue
            1.0, 1.0, 1.0, 1.0,   # slice 0 mip 0 (1,1) White
            0.5, 0.5, 0.5, 1.0,   # slice 0 mip 1     Grey
            0.0, 1.0, 1.0, 1.0,   # slice 1 mip 0 (0,0) Cyan
            1.0, 0.0, 1.0, 1.0,   # slice 1 mip 0 (1,0) Magenta
            1.0, 1.0, 0.0, 1.0,   # slice 1 mip 0 (0,1) Yellow
            0.0, 0.0, 0.0, 1.0,   # slice 1 mip 0 (1,1) Black
            0.2, 0.4, 0.6, 1.0 ]  # slice 1 mip 1

  - Name: Out
    Format: Float32
    Channels: 4
    FillSize: 112 # 7 * sizeof(float4)

  - Name: Expected
    Format: Float32
    Channels: 4
    Data: [ 1.0, 1.0, 1.0, 1.0,   # [0] slice 0 mip 0, Nearest -> White
            0.5, 0.5, 0.5, 1.0,   # [1] slice 0 mip 1 -> Grey
            0.0, 0.0, 0.0, 1.0,   # [2] slice 1 mip 0, Nearest -> Black
            0.2, 0.4, 0.6, 1.0,   # [3] slice 1 mip 1 -- not slice 0's Grey
            0.2, 0.4, 0.6, 1.0,   # [4] slice 1 mip 1 via the LOD clamp
            1.0, 0.0, 0.0, 1.0,   # [5] slice 0 offset (-1,-1) -> Red
            0.0, 1.0, 1.0, 1.0 ]  # [6] slice 1 offset (-1,-1) -> Cyan

  - Name: RT
    Format: Float32
    Channels: 4
    FillSize: 64
    OutputProps: { Width: 2, Height: 2, Depth: 1 }

  - Name: VB
    Format: Float32
    Channels: 3
    Data: [-1.0, -1.0, 0.0,
            3.0, -1.0, 0.0,
           -1.0,  3.0, 0.0]

Bindings:
  VertexBuffer: VB
  VertexAttributes:
    - Format: Float32
      Channels: 3
      Offset: 0
      Name: POSITION
  RenderTarget: RT

Samplers:
  - Name: Samp
    MinFilter: Linear
    MagFilter: Nearest
    Address: Clamp

Results:
  - Result: ArraySampleBiasTest
    Rule: BufferFloatULP
    Actual: Out
    Expected: Expected
    ULPT: 1

DescriptorSets:
  - Resources:
    - Name: Tex
      Kind: Texture2DArray
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 0 }
    - Name: Samp
      Kind: Sampler
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 1 }
    - Name: Out
      Kind: RWBuffer
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 2 }
...
#--- end

# Unimplemented: https://github.com/llvm/llvm-project/issues/143523
# XFAIL: Clang && DirectX

# Unimplemented: https://github.com/llvm/offload-test-suite/issues/1466
# XFAIL: Metal

# RUN: split-file %s %t
# RUN: %dxc_target -T vs_6_0 -E mainVS -Fo %t-vs.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_0 -E mainPS -Fo %t-ps.o %t/pixel.hlsl
# RUN: %offloader %t/pipeline.yaml %t-vs.o %t-ps.o
