#--- vertex.hlsl
struct VSInput {
  float3 Pos : POSITION;
};

struct VSOutput {
  float4 Pos : SV_POSITION;
};

VSOutput mainVS(VSInput input) {
  VSOutput output;
  output.Pos = float4(input.Pos, 1.0f);
  return output;
}

#--- pixel.hlsl
[[vk::binding(0, 0)]] Texture2DArray<float4> Tex2D : register(t0);
[[vk::binding(1, 0)]] SamplerState Samp : register(s0);
[[vk::binding(2, 0)]] RWBuffer<float> Out : register(u0);
[[vk::binding(3, 0)]] Texture1DArray<float4> Tex1D : register(t1);

float4 mainPS(float4 Pos : SV_POSITION) : SV_Target {
  uint2 GTid = (uint2)Pos.xy;

  // CalculateLevelOfDetail takes a float2: there is no slice argument, because
  // the array dimension plays no part in the LOD computation.

  // Derivative = 0.5, texture size = 4 -> LOD = log2(0.5 * 4) = 1.0
  float2 uv0 = 0.25 + float2(GTid.xy) * 0.5;

  // Derivative = 2.0, texture size = 4 -> LOD = log2(2.0 * 4) = 3.0.
  // The texture has three mips (0, 1, 2), so the clamped form reports 2.0
  // while the unclamped form reports the true 3.0.
  float2 uv1 = 0.25 + float2(GTid.xy) * 2.0;

  float lod0 = Tex2D.CalculateLevelOfDetail(Samp, uv0);
  float lod1 = Tex2D.CalculateLevelOfDetail(Samp, uv1);
  float lod2 = Tex2D.CalculateLevelOfDetailUnclamped(Samp, uv0);
  float lod3 = Tex2D.CalculateLevelOfDetailUnclamped(Samp, uv1);

  // Texture1DArray::CalculateLevelOfDetail
  float u0 = 0.25 + float(GTid.x) * 0.5;
  float u1 = 0.25 + float(GTid.x) * 2.0;
  float lod4 = Tex1D.CalculateLevelOfDetail(Samp, u0);
  float lod5 = Tex1D.CalculateLevelOfDetail(Samp, u1);
  float lod6 = Tex1D.CalculateLevelOfDetailUnclamped(Samp, u0);
  float lod7 = Tex1D.CalculateLevelOfDetailUnclamped(Samp, u1);

  if (all(GTid.xy == 0)) {
    Out[0] = lod0;
    Out[1] = lod1;
    Out[2] = lod2;
    Out[3] = lod3;
    Out[4] = lod4;
    Out[5] = lod5;
    Out[6] = lod6;
    Out[7] = lod7;
  }
  return float4(0, 0, 0, 0);
}

//--- pipeline.yaml
---
Shaders:
  - Stage: Vertex
    Entry: mainVS
  - Stage: Pixel
    Entry: mainPS

Buffers:
  # Four slices of a 4x4 texture with three mips. The contents are irrelevant
  # here; only the dimensions and the mip count feed the LOD.
  # Per slice: 16 + 4 + 1 = 21 texels, so 21 * 4 slices * sizeof(float4).
  - Name: Tex2D
    Format: Float32
    Channels: 4
    OutputProps: { Width: 4, Height: 4, Depth: 1, MipLevels: 3, ArraySlices: 4 }
    FillSize: 1344 # 21 * 4 * 16

  - Name: Tex1D
    Format: Float32
    Channels: 4
    OutputProps: { Width: 4, Height: 1, Depth: 1, MipLevels: 3, ArraySlices: 4 }
    FillSize: 448 # (4 + 2 + 1) * 4 * 16

  - Name: Out
    Format: Float32
    Channels: 1
    FillSize: 32 # 8 * sizeof(float)

  - Name: Expected
    Format: Float32
    Channels: 1
    # Identical to the Texture2D and Texture1D cases: the slice count does not enter the LOD.
    Data: [ 1.0, 2.0, 1.0, 3.0,  # 2D
            1.0, 2.0, 1.0, 3.0 ] # 1D

  - Name: RT
    Format: Float32
    Channels: 4
    FillSize: 64
    OutputProps: { Width: 2, Height: 2, Depth: 1 }

  - Name: VB
    Format: Float32
    Channels: 3
    Data: [-1.0, -1.0, 0.0,
            3.0, -1.0, 0.0,
           -1.0,  3.0, 0.0]

Bindings:
  VertexBuffer: VB
  VertexAttributes:
    - Format: Float32
      Channels: 3
      Offset: 0
      Name: POSITION
  RenderTarget: RT

Samplers:
  - Name: Samp
    MinFilter: Linear
    MagFilter: Linear
    Address: Clamp

Results:
  - Result: ArrayLODTest
    Rule: BufferFloatULP
    Actual: Out
    Expected: Expected
    ULPT: 1

DescriptorSets:
  - Resources:
    - Name: Tex2D
      Kind: Texture2DArray
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 0 }
    - Name: Samp
      Kind: Sampler
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 1 }
    - Name: Out
      Kind: RWBuffer
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 2 }
    - Name: Tex1D
      Kind: Texture1DArray
      DirectXBinding: { Register: 1, Space: 0 }
      VulkanBinding: { Binding: 3 }
...
#--- end

# Unimplemented: https://github.com/llvm/llvm-project/issues/143523
# XFAIL: Clang && DirectX

# Unimplemented: https://github.com/llvm/offload-test-suite/issues/1466
# XFAIL: Metal

# RUN: split-file %s %t
# RUN: %dxc_target -T vs_6_6 -E mainVS -Fo %t-vs.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_6 -E mainPS -Fo %t-ps.o %t/pixel.hlsl
# RUN: %offloader %t/pipeline.yaml %t-vs.o %t-ps.o
