#--- source.hlsl
[[vk::binding(0, 0)]] RWTexture2DArray<float> Out : register(u0);

[numthreads(5, 3, 2)]
void main(uint3 TID : SV_DispatchThreadID) {
  Out[TID] = TID.z * 100.0 + TID.y * 10.0 + TID.x;
}

//--- pipeline.yaml
---
Shaders:
  - Stage: Compute
    Entry: main

Buffers:
  # A 5-texel row of R32Float is 20 bytes, not a multiple of
  # D3D12_TEXTURE_DATA_PITCH_ALIGNMENT (256), so upload and readback must use
  # the padded per-subresource footprint.
  - Name: Out
    Format: Float32
    Channels: 1
    FillSize: 120 # 5 * 3 * 2 * sizeof(float)
    OutputProps: { Width: 5, Height: 3, Depth: 1, ArraySlices: 2 }

  - Name: Expected
    Format: Float32
    Channels: 1
    OutputProps: { Width: 5, Height: 3, Depth: 1, ArraySlices: 2 }
    Data: [ # --- Slice 0 ---
              0.0,   1.0,   2.0,   3.0,   4.0,
             10.0,  11.0,  12.0,  13.0,  14.0,
             20.0,  21.0,  22.0,  23.0,  24.0,
            # --- Slice 1 ---
            100.0, 101.0, 102.0, 103.0, 104.0,
            110.0, 111.0, 112.0, 113.0, 114.0,
            120.0, 121.0, 122.0, 123.0, 124.0 ]

DescriptorSets:
  - Resources:
    - Name: Out
      Kind: RWTexture2DArray
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 0 }

Results:
  - Result: UnalignedRowPitchTest
    Rule: BufferExact
    Actual: Out
    Expected: Expected
...
#--- end

# Unimplemented: https://github.com/llvm/offload-test-suite/issues/1466
# XFAIL: Metal

# Bug: https://github.com/llvm/llvm-project/issues/217777
# XFAIL: Clang && DirectX

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_0 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
