#--- source.hlsl

// Load on textures with double and double2 elements. Readable decimal
// fractions have distinct high words and nonzero low words, so a lost or
// swapped 32-bit word changes the result.

Texture1D<double> Tex1D : register(t0);
Texture2D<double2> Tex2D : register(t1);
Texture3D<double> Tex3D : register(t2);
RWTexture1D<double2> RWTex1D : register(u0);
RWTexture2D<double> RWTex2D : register(u1);
RWTexture3D<double2> RWTex3D : register(u2);
RWStructuredBuffer<double> OutS : register(u3);
RWStructuredBuffer<double2> OutV : register(u4);

[numthreads(1, 1, 1)]
void main() {
  // Texture1D::Load(int2): (x, mip)
  OutS[0] = Tex1D.Load(int2(0, 0));
  OutS[1] = Tex1D.Load(int2(1, 0));
  // (0) + (1) = (1)
  OutS[2] = Tex1D.Load(int2(0, 0), 1);

  // Texture3D::Load(int4): (x, y, z, mip)
  OutS[3] = Tex3D.Load(int4(0, 0, 0, 0));
  OutS[4] = Tex3D.Load(int4(1, 1, 1, 0));
  // (0,0,0) + (1,0,1) = (1,0,1)
  OutS[5] = Tex3D.Load(int4(0, 0, 0, 0), int3(1, 0, 1));

  // RWTexture2D::Load(int2)
  OutS[6] = RWTex2D.Load(int2(0, 1));
  OutS[7] = RWTex2D.Load(int2(1, 1));

  // Texture2D::Load(int3): (x, y, mip)
  OutV[0] = Tex2D.Load(int3(0, 0, 0));
  OutV[1] = Tex2D.Load(int3(1, 1, 0));
  // (1,1) + (-1,0) = (0,1)
  OutV[2] = Tex2D.Load(int3(1, 1, 0), int2(-1, 0));

  // RWTexture1D::Load(int)
  OutV[3] = RWTex1D.Load(0);
  OutV[4] = RWTex1D.Load(1);

  // RWTexture3D::Load(int3)
  OutV[5] = RWTex3D.Load(int3(0, 0, 0));
  OutV[6] = RWTex3D.Load(int3(1, 1, 1));
}

//--- pipeline.yaml
---
Shaders:
  - Stage: Compute
    Entry: main

Buffers:
  - Name: Tex1D
    Format: Float64
    Channels: 1
    OutputProps: { Width: 2, Height: 1, Depth: 1 }
    Data: [ 1.1,    # (0)
            -1.2 ]  # (1)

  - Name: Tex2D
    Format: Float64
    Channels: 2
    OutputProps: { Width: 2, Height: 2, Depth: 1 }
    Data: [ 2.1, -12.1,   # (0,0)
            -2.2, 12.2,   # (1,0)
            2.3, -12.3,   # (0,1)
            -2.4, 12.4 ]  # (1,1)

  - Name: Tex3D
    Format: Float64
    Channels: 1
    OutputProps: { Width: 2, Height: 2, Depth: 2 }
    Data: [ 3.1,    # (0,0,0)
            -3.2,   # (1,0,0)
            3.3,    # (0,1,0)
            -3.4,   # (1,1,0)
            3.6,    # (0,0,1)
            -3.7,   # (1,0,1)
            3.8,    # (0,1,1)
            -3.9 ]  # (1,1,1)

  - Name: RWTex1D
    Format: Float64
    Channels: 2
    OutputProps: { Width: 2, Height: 1, Depth: 1 }
    Data: [ 4.1, -14.1,   # (0)
            -4.2, 14.2 ]  # (1)

  - Name: RWTex2D
    Format: Float64
    Channels: 1
    OutputProps: { Width: 2, Height: 2, Depth: 1 }
    Data: [ 5.1,    # (0,0)
            -5.2,   # (1,0)
            5.3,    # (0,1)
            -5.4 ]  # (1,1)

  - Name: RWTex3D
    Format: Float64
    Channels: 2
    OutputProps: { Width: 2, Height: 2, Depth: 2 }
    Data: [ 6.1, -16.1,   # (0,0,0)
            -6.2, 16.2,   # (1,0,0)
            6.3, -16.3,   # (0,1,0)
            -6.4, 16.4,   # (1,1,0)
            6.6, -16.6,   # (0,0,1)
            -6.7, 16.7,   # (1,0,1)
            6.8, -16.8,   # (0,1,1)
            -6.9, 16.9 ]  # (1,1,1)

  - Name: OutS
    Format: Float64
    Stride: 8
    FillSize: 64

  - Name: ExpectedS
    Format: Float64
    Stride: 8
    Data: [ 1.1,    # [0] Tex1D (0)
            -1.2,   # [1] Tex1D (1)
            -1.2,   # [2] Tex1D offset -> (1)
            3.1,    # [3] Tex3D (0,0,0)
            -3.9,   # [4] Tex3D (1,1,1)
            -3.7,   # [5] Tex3D offset -> (1,0,1)
            5.3,    # [6] RWTex2D (0,1)
            -5.4 ]  # [7] RWTex2D (1,1)

  - Name: OutV
    Format: Float64
    Stride: 16
    FillSize: 112

  - Name: ExpectedV
    Format: Float64
    Stride: 16
    Data: [ 2.1, -12.1,   # [0] Tex2D (0,0)
            -2.4, 12.4,   # [1] Tex2D (1,1)
            2.3, -12.3,   # [2] Tex2D offset -> (0,1)
            4.1, -14.1,   # [3] RWTex1D (0)
            -4.2, 14.2,   # [4] RWTex1D (1)
            6.1, -16.1,   # [5] RWTex3D (0,0,0)
            -6.9, 16.9 ]  # [6] RWTex3D (1,1,1)

DescriptorSets:
  - Resources:
    - Name: Tex1D
      Kind: Texture1D
      DirectXBinding: { Register: 0, Space: 0 }
    - Name: Tex2D
      Kind: Texture2D
      DirectXBinding: { Register: 1, Space: 0 }
    - Name: Tex3D
      Kind: Texture3D
      DirectXBinding: { Register: 2, Space: 0 }
    - Name: RWTex1D
      Kind: RWTexture1D
      DirectXBinding: { Register: 0, Space: 0 }
    - Name: RWTex2D
      Kind: RWTexture2D
      DirectXBinding: { Register: 1, Space: 0 }
    - Name: RWTex3D
      Kind: RWTexture3D
      DirectXBinding: { Register: 2, Space: 0 }
    - Name: OutS
      Kind: RWStructuredBuffer
      DirectXBinding: { Register: 3, Space: 0 }
    - Name: OutV
      Kind: RWStructuredBuffer
      DirectXBinding: { Register: 4, Space: 0 }

Results:
  - Result: ScalarLoad
    Rule: BufferExact
    Actual: OutS
    Expected: ExpectedS
  - Result: VectorLoad
    Rule: BufferExact
    Actual: OutV
    Expected: ExpectedV
...
#--- end

# Bug https://github.com/llvm/llvm-project/issues/235930
# XFAIL: Clang && (DirectX || Metal)

# REQUIRES: Double
# UNSUPPORTED: Vulkan
# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
