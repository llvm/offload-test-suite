#--- source.hlsl
[[vk::binding(0, 0)]] Texture2DArray<float4> Tex : register(t0);
[[vk::binding(1, 0)]] RWBuffer<float4> Out : register(u0);
[[vk::binding(0, 1)]] SamplerState Samp : register(s0);

[numthreads(1, 1, 1)]
void main() {
  // Texture2DArray::Gather takes a float3 location. Gathering at the centre of
  // a 2x2 slice collects that slice's four texels in the order
  // [ (0,1), (1,1), (1,0), (0,0) ] -- all four must come from the named slice.
  float3 Centre0 = float3(0.5, 0.5, 0);
  float3 Centre1 = float3(0.5, 0.5, 1);

  // Slice 0 red channels are   [0.1 0.2 / 0.3 0.4] laid out row-major.
  // Gather order gives         [ (0,1)=0.3, (1,1)=0.4, (1,0)=0.2, (0,0)=0.1 ].
  Out[0] = Tex.Gather(Samp, Centre0);
  Out[1] = Tex.GatherRed(Samp, Centre0);   // equivalent to Gather
  Out[2] = Tex.GatherGreen(Samp, Centre0);

  // Slice 1 holds a disjoint set of values, so a gather that strayed across
  // slices would show up here immediately.
  Out[3] = Tex.GatherRed(Samp, Centre1);
  Out[4] = Tex.GatherGreen(Samp, Centre1);
}

//--- pipeline.yaml
---
Shaders:
  - Stage: Compute
    Entry: main

Buffers:
  # 2x2 across 2 slices, slice-major. Red and green channels carry distinct
  # values per texel so the gather order and the slice are both observable.
  - Name: Tex
    Format: Float32
    Channels: 4
    OutputProps: { Width: 2, Height: 2, Depth: 1, ArraySlices: 2 }
    Data: [ # --- Slice 0 ---
            0.1, 0.5, 0.0, 1.0,   # (0,0) r=0.1 g=0.5
            0.2, 0.6, 0.0, 1.0,   # (1,0) r=0.2 g=0.6
            0.3, 0.7, 0.0, 1.0,   # (0,1) r=0.3 g=0.7
            0.4, 0.8, 0.0, 1.0,   # (1,1) r=0.4 g=0.8
            # --- Slice 1 ---
            0.9, 0.15, 0.0, 1.0,  # (0,0)
            0.8, 0.25, 0.0, 1.0,  # (1,0)
            0.7, 0.35, 0.0, 1.0,  # (0,1)
            0.6, 0.45, 0.0, 1.0 ] # (1,1)

  - Name: Out
    Format: Float32
    Channels: 4
    FillSize: 80 # 5 * sizeof(float4)

  # Gather returns [ (0,1), (1,1), (1,0), (0,0) ] of the selected channel.
  - Name: Expected
    Format: Float32
    Channels: 4
    Data: [ 0.3, 0.4, 0.2, 0.1,     # [0] slice 0 red
            0.3, 0.4, 0.2, 0.1,     # [1] slice 0 red (GatherRed)
            0.7, 0.8, 0.6, 0.5,     # [2] slice 0 green
            0.7, 0.6, 0.8, 0.9,     # [3] slice 1 red
            0.35, 0.45, 0.25, 0.15 ] # [4] slice 1 green

Samplers:
  - Name: Samp
    MinFilter: Nearest
    MagFilter: Nearest
    Address: Clamp

Results:
  - Result: ArrayGatherTest
    Rule: BufferFloatEpsilon
    Actual: Out
    Expected: Expected
    Epsilon: 0.001

DescriptorSets:
  - Resources:
    - Name: Tex
      Kind: Texture2DArray
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 0 }
    - Name: Out
      Kind: RWBuffer
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 1 }
  - Resources:
    - Name: Samp
      Kind: Sampler
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 0 }
...
#--- end

# Unimplemented: https://github.com/llvm/offload-test-suite/issues/1466
# XFAIL: Metal

# Unimplemented: https://github.com/llvm/wg-hlsl/issues/409
# XFAIL: Clang && DirectX

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_0 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
