#--- compute.hlsl
[[vk::binding(0, 0)]] Texture2D<float4> Tex1 : register(t0);
[[vk::binding(1, 0)]] Texture2D<float4> Tex2 : register(t1);
[[vk::binding(3, 0)]] Texture2D<float4> Tex3 : register(t2); // 4x4 with 3 mips
[[vk::binding(2, 0)]] RWBuffer<float> Out : register(u0);
[[vk::binding(4, 0)]] RWTexture2D<float4> RWTex2D : register(u1); // 8x2
[[vk::binding(5, 0)]] TextureCube<float4> TexCube : register(t3); // 4x4, 3 mips
[[vk::binding(6, 0)]] Texture1D<float4> Tex1D : register(t4); // 4 texels, 3 mips
[[vk::binding(7, 0)]] RWTexture1D<float4> RWTex1D : register(u2); // 8 texels

[numthreads(1, 1, 1)]
void main() {
  float width, height, levels;
  uint uwidth, uheight, ulevels;
  
  // Tex1 (4x8, 1 mip)
  Tex1.GetDimensions(0, width, height, levels);
  Out[0] = width;
  Out[1] = height;
  Out[2] = levels;
  
  Tex1.GetDimensions(uwidth, uheight);
  Out[3] = (float)uwidth;
  Out[4] = (float)uheight;

  // Tex2 (16x32, 1 mip)
  Tex2.GetDimensions(0, uwidth, uheight, ulevels);
  Out[5] = (float)uwidth;
  Out[6] = (float)uheight;
  Out[7] = (float)ulevels;
  
  float w, h;
  Tex2.GetDimensions(w, h);
  Out[8] = w;
  Out[9] = h;

  // Tex3 (4x4, 3 mips)
  // Mip 0: 4x4
  Tex3.GetDimensions(0, width, height, levels);
  Out[10] = width;
  Out[11] = height;
  Out[12] = levels;

  // Mip 1: 2x2
  Tex3.GetDimensions(1, uwidth, uheight, ulevels);
  Out[13] = (float)uwidth;
  Out[14] = (float)uheight;
  
  // Mip 2: 1x1
  Tex3.GetDimensions(2, w, h, levels);
  Out[15] = w;
  Out[16] = h;

  // RWTexture2D (8x2). A UAV has a single mip level, so its GetDimensions has
  // no mip or level parameters at all -- just the two extents.
  RWTex2D.GetDimensions(uwidth, uheight);
  Out[17] = (float)uwidth;
  Out[18] = (float)uheight;

  // TexCube (4x4 faces, 3 mips). A cube reports its face dimensions and has
  // no element count: the six faces are not an array dimension.
  TexCube.GetDimensions(0, width, height, levels);
  Out[19] = width;
  Out[20] = height;
  Out[21] = levels;

  // Mip 1 halves the face extents; the face count is not a texel dimension so
  // nothing else changes.
  TexCube.GetDimensions(1, uwidth, uheight, ulevels);
  Out[22] = (float)uwidth;
  Out[23] = (float)uheight;

  TexCube.GetDimensions(w, h);
  Out[24] = w;
  Out[25] = h;

  // Texture1D (4 texels, 3 mips).
  Tex1D.GetDimensions(0, width, levels);
  Out[26] = width;
  Out[27] = levels;

  Tex1D.GetDimensions(1, uwidth, ulevels);
  Out[28] = (float)uwidth;
  Out[29] = (float)ulevels;

  Tex1D.GetDimensions(2, width, levels);
  Out[30] = width;
  Out[31] = levels;

  Tex1D.GetDimensions(uwidth);
  Out[32] = (float)uwidth;

  Tex1D.GetDimensions(width);
  Out[33] = width;

  // RWTexture1D (8 texels).
  RWTex1D.GetDimensions(uwidth);
  Out[34] = (float)uwidth;

  RWTex1D.GetDimensions(width);
  Out[35] = width;
}

//--- pipeline.yaml
---
Shaders:
  - Stage: Compute
    Entry: main

Buffers:
  - Name: Tex1
    Format: Float32
    Channels: 4
    OutputProps: { Width: 4, Height: 8, Depth: 1 }
    FillSize: 512 # 4*8*4*4

  - Name: Tex2
    Format: Float32
    Channels: 4
    OutputProps: { Width: 16, Height: 32, Depth: 1 }
    FillSize: 8192 # 16*32*4*4

  - Name: Tex3
    Format: Float32
    Channels: 4
    OutputProps: { Width: 4, Height: 4, Depth: 1, MipLevels: 3 }
    FillSize: 336 # (16 + 4 + 1) * 4 * 4 = 21 * 16 = 336

  - Name: RWTex2D
    Format: Float32
    Channels: 4
    OutputProps: { Width: 8, Height: 2, Depth: 1 }
    FillSize: 256 # 8 * 2 * 4 * 4

  # 4x4 faces with 3 mips across 6 faces: (16 + 4 + 1) * 6 texels of float4.
  - Name: TexCube
    Format: Float32
    Channels: 4
    OutputProps: { Width: 4, Height: 4, Depth: 1, MipLevels: 3, ArraySlices: 6 }
    FillSize: 2016 # 21 * 6 * 4 * 4

  - Name: Tex1D
    Format: Float32
    Channels: 4
    OutputProps: { Width: 4, Height: 1, Depth: 1, MipLevels: 3 }
    FillSize: 112 # (4 + 2 + 1) * sizeof(float4)

  - Name: RWTex1D
    Format: Float32
    Channels: 4
    OutputProps: { Width: 8, Height: 1, Depth: 1 }
    FillSize: 128 # 8 * sizeof(float4)

  - Name: Out
    Format: Float32
    Channels: 1
    FillSize: 144 # 36 * sizeof(float)

  - Name: Expected
    Format: Float32
    Channels: 1
    Data: [ 4.0, 8.0, 1.0, 4.0, 8.0,     # Tex1
            16.0, 32.0, 1.0, 16.0, 32.0, # Tex2
            4.0, 4.0, 3.0,               # Tex3 Mip 0
            2.0, 2.0,                    # Tex3 Mip 1
            1.0, 1.0,                    # Tex3 Mip 2
            8.0, 2.0,                    # RWTex2D
            4.0, 4.0, 3.0,               # TexCube Mip 0 (w, h, levels)
            2.0, 2.0,                    # TexCube Mip 1
            4.0, 4.0,                    # TexCube (w, h)
            4.0, 3.0,                    # Tex1D Mip 0 (w, levels)
            2.0, 3.0,                    # Tex1D Mip 1
            1.0, 3.0,                    # Tex1D Mip 2
            4.0, 4.0,                    # Tex1D width (uint, float)
            8.0, 8.0 ]                   # RWTex1D width (uint, float)

DescriptorSets:
  - Resources:
    - Name: Tex1
      Kind: Texture2D
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 0 }
    - Name: Tex2
      Kind: Texture2D
      DirectXBinding: { Register: 1, Space: 0 }
      VulkanBinding: { Binding: 1 }
    - Name: Tex3
      Kind: Texture2D
      DirectXBinding: { Register: 2, Space: 0 }
      VulkanBinding: { Binding: 3 }
    - Name: Out
      Kind: RWBuffer
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 2 }
    - Name: RWTex2D
      Kind: RWTexture2D
      DirectXBinding: { Register: 1, Space: 0 }
      VulkanBinding: { Binding: 4 }
    - Name: TexCube
      Kind: TextureCube
      DirectXBinding: { Register: 3, Space: 0 }
      VulkanBinding: { Binding: 5 }
    - Name: Tex1D
      Kind: Texture1D
      DirectXBinding: { Register: 4, Space: 0 }
      VulkanBinding: { Binding: 6 }
    - Name: RWTex1D
      Kind: RWTexture1D
      DirectXBinding: { Register: 2, Space: 0 }
      VulkanBinding: { Binding: 7 }

Results:
  - Result: GetDimensionsTest
    Rule: BufferExact
    Actual: Out
    Expected: Expected
...
#--- end

# Unimplemented: Metal: https://github.com/llvm/llvm-project/issues/101558
# XFAIL: Metal
# XFAIL: Clang && DirectX

# Bug https://github.com/llvm/llvm-project/issues/197837
# XFAIL: Clang && Vulkan

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_0 -Fo %t.o %t/compute.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
