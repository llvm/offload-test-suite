#--- source.hlsl
[[vk::binding(0, 0)]] Texture2DArray<float4> Tex : register(t0);
[[vk::binding(1, 0)]] RWBuffer<float> Out : register(u0);
[[vk::binding(2, 0)]] RWTexture2DArray<float4> RWTex : register(u1); // 8x2, 4 slices
[[vk::binding(3, 0)]] TextureCubeArray<float4> TexCubeArr : register(t1);

[numthreads(1, 1, 1)]
void main() {
  uint Width, Height, Elements, Levels;

  // Texture2DArray::GetDimensions reports the slice count as `Elements`, so
  // this reads back through the shader what the harness created from
  // `ArraySlices`.
  Tex.GetDimensions(Width, Height, Elements);
  Out[0] = (float)Width;    // 4
  Out[1] = (float)Height;   // 2
  Out[2] = (float)Elements; // 3

  // With an explicit mip level the extents halve, but the slice count must
  // not: layers are not a texel dimension.
  Tex.GetDimensions(0, Width, Height, Elements, Levels);
  Out[3] = (float)Width;    // 4
  Out[4] = (float)Height;   // 2
  Out[5] = (float)Elements; // 3
  Out[6] = (float)Levels;   // 2

  Tex.GetDimensions(1, Width, Height, Elements, Levels);
  Out[7] = (float)Width;     // 2
  Out[8] = (float)Height;    // 1
  Out[9] = (float)Elements;  // 3 -- unchanged by the mip level
  Out[10] = (float)Levels;   // 2

  // RWTexture2DArray (8x2 with 4 slices). A UAV has a single mip level, so
  // this overload reports only the extents and the slice count -- but the
  // slice count is still reported, and is still the layer count rather than
  // anything derived from the extents.
  RWTex.GetDimensions(Width, Height, Elements);
  Out[11] = (float)Width;    // 8
  Out[12] = (float)Height;   // 2
  Out[13] = (float)Elements; // 4

  // A cube array is the other array texture kind. Its `Elements` counts
  // *cubes*, not layers: this resource is 12 layers, which is 2 cubes, so it
  // must report 2 rather than 12. That is the same units distinction as
  // D3D12_SRV_DIMENSION_TEXTURECUBEARRAY's NumCubes.
  TexCubeArr.GetDimensions(Width, Height, Elements);
  Out[14] = (float)Width;    // 4
  Out[15] = (float)Height;   // 4
  Out[16] = (float)Elements; // 2 -- cubes, not the 12 layers

  TexCubeArr.GetDimensions(0, Width, Height, Elements, Levels);
  Out[17] = (float)Width;    // 4
  Out[18] = (float)Height;   // 4
  Out[19] = (float)Elements; // 2
  Out[20] = (float)Levels;   // 1
}

//--- pipeline.yaml
---
Shaders:
  - Stage: Compute
    Entry: main

Buffers:
  # 4x2 with 2 mips across 3 slices. Contents are irrelevant here; only the
  # dimensions are queried.
  # Per slice: mip 0 (4x2 = 8) + mip 1 (2x1 = 2) = 10 texels.
  # 10 * 3 slices * sizeof(float4) = 480 bytes.
  - Name: Tex
    Format: Float32
    Channels: 4
    FillSize: 480
    OutputProps: { Width: 4, Height: 2, Depth: 1, MipLevels: 2, ArraySlices: 3 }

  - Name: RWTex
    Format: Float32
    Channels: 4
    OutputProps: { Width: 8, Height: 2, Depth: 1, ArraySlices: 4 }
    FillSize: 1024 # 8*2*4 slices*4 channels*4 bytes

  # 4x4 faces, 2 cubes = 12 layers, 1 mip. Contents are irrelevant here too.
  - Name: TexCubeArr
    Format: Float32
    Channels: 4
    FillSize: 3072 # 16 texels * 12 layers * sizeof(float4)
    OutputProps: { Width: 4, Height: 4, Depth: 1, ArraySlices: 12 }

  - Name: Out
    Format: Float32
    Channels: 1
    FillSize: 84 # 21 * sizeof(float)

  - Name: Expected
    Format: Float32
    Channels: 1
    Data: [ 4.0, 2.0, 3.0,            # GetDimensions(w, h, elements)
            4.0, 2.0, 3.0, 2.0,       # mip 0: w, h, elements, levels
            2.0, 1.0, 3.0, 2.0,       # mip 1: extents halve, elements do not
            8.0, 2.0, 4.0,            # RWTexture2DArray: w, h, elements
            4.0, 4.0, 2.0,            # cube array: w, h, cubes (not 12 layers)
            4.0, 4.0, 2.0, 1.0 ]      # cube array: w, h, cubes, levels

Results:
  - Result: ArrayGetDimensionsTest
    Rule: BufferExact
    Actual: Out
    Expected: Expected

DescriptorSets:
  - Resources:
    - Name: Tex
      Kind: Texture2DArray
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 0 }
    - Name: RWTex
      Kind: RWTexture2DArray
      DirectXBinding: { Register: 1, Space: 0 }
      VulkanBinding: { Binding: 2 }
    - Name: TexCubeArr
      Kind: TextureCubeArray
      DirectXBinding: { Register: 1, Space: 0 }
      VulkanBinding: { Binding: 3 }
    - Name: Out
      Kind: RWBuffer
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 1 }
...
#--- end

# Unimplemented: https://github.com/llvm/offload-test-suite/issues/1466
# XFAIL: Metal

# Unimplemented: https://github.com/llvm/wg-hlsl/issues/347
# XFAIL: Clang

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_0 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
