#--- source.hlsl

// Load on textures with two-component 64-bit integer elements. Every
// component has a nonzero high word that differs between components and
// texels and a nonzero low word, so a lost or swapped word changes the result.

Texture1D<int64_t2> Tex1D : register(t0);
Texture2D<uint64_t2> Tex2D : register(t1);
Texture3D<int64_t2> Tex3D : register(t2);
RWTexture1D<uint64_t2> RWTex1D : register(u3);
RWTexture2D<int64_t2> RWTex2D : register(u4);
RWTexture3D<uint64_t2> RWTex3D : register(u5);
RWStructuredBuffer<int64_t2> OutS : register(u6);
RWStructuredBuffer<uint64_t2> OutU : register(u7);

[numthreads(1, 1, 1)]
void main() {
  // Texture1D::Load(int2): (x, mip)
  OutS[0] = Tex1D.Load(int2(0, 0));
  OutS[1] = Tex1D.Load(int2(1, 0));
  // (0) + (1) = (1)
  OutS[2] = Tex1D.Load(int2(0, 0), 1);

  // Texture3D::Load(int4): (x, y, z, mip)
  OutS[3] = Tex3D.Load(int4(0, 0, 0, 0));
  OutS[4] = Tex3D.Load(int4(1, 1, 1, 0));
  // (0,0,0) + (1,0,1) = (1,0,1)
  OutS[5] = Tex3D.Load(int4(0, 0, 0, 0), int3(1, 0, 1));

  // RWTexture2D::Load(int2)
  OutS[6] = RWTex2D.Load(int2(0, 1));
  OutS[7] = RWTex2D.Load(int2(1, 1));

  // Texture2D::Load(int3): (x, y, mip)
  OutU[0] = Tex2D.Load(int3(0, 0, 0));
  OutU[1] = Tex2D.Load(int3(1, 1, 0));
  // (1,1) + (-1,0) = (0,1)
  OutU[2] = Tex2D.Load(int3(1, 1, 0), int2(-1, 0));

  // RWTexture1D::Load(int)
  OutU[3] = RWTex1D.Load(0);
  OutU[4] = RWTex1D.Load(1);

  // RWTexture3D::Load(int3)
  OutU[5] = RWTex3D.Load(int3(0, 0, 0));
  OutU[6] = RWTex3D.Load(int3(1, 1, 1));
}

//--- pipeline.yaml
---
Shaders:
  - Stage: Compute
    Entry: main

Buffers:
  - Name: Tex1D
    Format: Int64
    Channels: 2
    OutputProps: { Width: 2, Height: 1, Depth: 1 }
    Data: [ 0x0000011080000210, -0x0000031080000410,   # (0)
            -0x0000011180000211, 0x0000031180000411 ]  # (1)

  - Name: Tex2D
    Format: UInt64
    Channels: 2
    OutputProps: { Width: 2, Height: 2, Depth: 1 }
    Data: [ 0xC000012080000220, 0xC000032080000420,    # (0,0)
            0xC000012180000221, 0xC000032180000421,    # (1,0)
            0xC000012280000222, 0xC000032280000422,    # (0,1)
            0xC000012380000223, 0xC000032380000423 ]   # (1,1)

  - Name: Tex3D
    Format: Int64
    Channels: 2
    OutputProps: { Width: 2, Height: 2, Depth: 2 }
    Data: [ 0x0000013080000230, -0x0000033080000430,   # (0,0,0)
            -0x0000013180000231, 0x0000033180000431,   # (1,0,0)
            0x0000013280000232, -0x0000033280000432,   # (0,1,0)
            -0x0000013380000233, 0x0000033380000433,   # (1,1,0)
            0x0000013480000234, -0x0000033480000434,   # (0,0,1)
            -0x0000013580000235, 0x0000033580000435,   # (1,0,1)
            0x0000013680000236, -0x0000033680000436,   # (0,1,1)
            -0x0000013780000237, 0x0000033780000437 ]  # (1,1,1)

  - Name: RWTex1D
    Format: UInt64
    Channels: 2
    OutputProps: { Width: 2, Height: 1, Depth: 1 }
    Data: [ 0xC000014080000240, 0xC000034080000440,    # (0)
            0xC000014180000241, 0xC000034180000441 ]   # (1)

  - Name: RWTex2D
