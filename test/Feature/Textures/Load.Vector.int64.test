    Channels: 2
    OutputProps: { Width: 2, Height: 2, Depth: 1 }
    Data: [ 0x0000015080000250, -0x0000035080000450,   # (0,0)
            -0x0000015180000251, 0x0000035180000451,   # (1,0)
            0x0000015280000252, -0x0000035280000452,   # (0,1)
            -0x0000015380000253, 0x0000035380000453 ]  # (1,1)

  - Name: RWTex3D
    Format: UInt64
    Channels: 2
    OutputProps: { Width: 2, Height: 2, Depth: 2 }
    Data: [ 0xC000016080000260, 0xC000036080000460,    # (0,0,0)
            0xC000016180000261, 0xC000036180000461,    # (1,0,0)
            0xC000016280000262, 0xC000036280000462,    # (0,1,0)
            0xC000016380000263, 0xC000036380000463,    # (1,1,0)
            0xC000016480000264, 0xC000036480000464,    # (0,0,1)
            0xC000016580000265, 0xC000036580000465,    # (1,0,1)
            0xC000016680000266, 0xC000036680000466,    # (0,1,1)
            0xC000016780000267, 0xC000036780000467 ]   # (1,1,1)

  - Name: OutS
    Format: Int64
    Stride: 16
    FillSize: 128

  - Name: ExpectedS
    Format: Int64
    Stride: 16
    Data: [ 0x0000011080000210, -0x0000031080000410,   # [0] Tex1D (0)
            -0x0000011180000211, 0x0000031180000411,   # [1] Tex1D (1)
            -0x0000011180000211, 0x0000031180000411,   # [2] Tex1D offset -> (1)
            0x0000013080000230, -0x0000033080000430,   # [3] Tex3D (0,0,0)
            -0x0000013780000237, 0x0000033780000437,   # [4] Tex3D (1,1,1)
            -0x0000013580000235, 0x0000033580000435,   # [5] Tex3D offset -> (1,0,1)
            0x0000015280000252, -0x0000035280000452,   # [6] RWTex2D (0,1)
            -0x0000015380000253, 0x0000035380000453 ]  # [7] RWTex2D (1,1)

  - Name: OutU
    Format: UInt64
    Stride: 16
    FillSize: 112

  - Name: ExpectedU
    Format: UInt64
    Stride: 16
    Data: [ 0xC000012080000220, 0xC000032080000420,    # [0] Tex2D (0,0)
            0xC000012380000223, 0xC000032380000423,    # [1] Tex2D (1,1)
            0xC000012280000222, 0xC000032280000422,    # [2] Tex2D offset -> (0,1)
            0xC000014080000240, 0xC000034080000440,    # [3] RWTex1D (0)
            0xC000014180000241, 0xC000034180000441,    # [4] RWTex1D (1)
            0xC000016080000260, 0xC000036080000460,    # [5] RWTex3D (0,0,0)
            0xC000016780000267, 0xC000036780000467 ]   # [6] RWTex3D (1,1,1)

DescriptorSets:
  - Resources:
    - Name: Tex1D
      Kind: Texture1D
      DirectXBinding: { Register: 0, Space: 0 }
      VulkanBinding: { Binding: 0 }
    - Name: Tex2D
      Kind: Texture2D
      DirectXBinding: { Register: 1, Space: 0 }
      VulkanBinding: { Binding: 1 }
    - Name: Tex3D
      Kind: Texture3D
      DirectXBinding: { Register: 2, Space: 0 }
      VulkanBinding: { Binding: 2 }
    - Name: RWTex1D
      Kind: RWTexture1D
      DirectXBinding: { Register: 3, Space: 0 }
      VulkanBinding: { Binding: 3 }
    - Name: RWTex2D
      Kind: RWTexture2D
      DirectXBinding: { Register: 4, Space: 0 }
      VulkanBinding: { Binding: 4 }
    - Name: RWTex3D
      Kind: RWTexture3D
      DirectXBinding: { Register: 5, Space: 0 }
      VulkanBinding: { Binding: 5 }
    - Name: OutS
      Kind: RWStructuredBuffer
      DirectXBinding: { Register: 6, Space: 0 }
      VulkanBinding: { Binding: 6 }
    - Name: OutU
      Kind: RWStructuredBuffer
      DirectXBinding: { Register: 7, Space: 0 }
      VulkanBinding: { Binding: 7 }

Results:
  - Result: SignedLoad
    Rule: BufferExact
    Actual: OutS
    Expected: ExpectedS
  - Result: UnsignedLoad
    Rule: BufferExact
    Actual: OutU
    Expected: ExpectedU
...
#--- end

# Bug https://github.com/llvm/llvm-project/issues/235930
# XFAIL: Clang && (DirectX || Metal)

# Bug https://github.com/microsoft/DirectXShaderCompiler/issues/8615
# XFAIL: DXC && Vulkan

# REQUIRES: Int64
# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_5 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
