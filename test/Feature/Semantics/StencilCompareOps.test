#--- end

# Shader references 0, 1, 2 are compared against a stencil clear value of 1,
# giving every comparison function a distinct pass/reject pattern:
#   Never 000, Less 100, Equal 010, LessEqual 110,
#   Greater 001, NotEqual 101, GreaterEqual 011, Always 111.
# REQUIRES: !DirectX || ShaderStencilRef
# REQUIRES: !Vulkan || VK_EXT_shader_stencil_export
# Clang does not yet lower SV_StencilRef.
# XFAIL: Clang

# RUN: split-file %s %t
# RUN: %dxc_target -T vs_6_0 -Fo %t-vertex.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_0 -Fo %t-pixel.o %t/pixel.hlsl
# RUN: %offloader %t/never.yaml %t-vertex.o %t-pixel.o
# RUN: %offloader %t/less.yaml %t-vertex.o %t-pixel.o
# RUN: %offloader %t/equal.yaml %t-vertex.o %t-pixel.o
# RUN: %offloader %t/lessequal.yaml %t-vertex.o %t-pixel.o
# RUN: %offloader %t/greater.yaml %t-vertex.o %t-pixel.o
# RUN: %offloader %t/notequal.yaml %t-vertex.o %t-pixel.o
# RUN: %offloader %t/greaterequal.yaml %t-vertex.o %t-pixel.o
# RUN: %offloader %t/always.yaml %t-vertex.o %t-pixel.o
