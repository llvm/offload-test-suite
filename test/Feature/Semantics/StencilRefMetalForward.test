# REQUIRES: Metal, DXC

# Repeat StencilRef.test's red/black case without reversing the winding.
# A pass here with a failure there would indicate face-dependent behavior.
# RUN: split-file %S/StencilRef.test %t
# RUN: %dxc_target -T vs_6_0 -Fo %t-vertex.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_0 -Fo %t-pixel.o %t/pixel.hlsl
# RUN: %offloader %t/pipeline.yaml %t-vertex.o %t-pixel.o
