# Verifies that SV_StartInstanceLocation reflects the FirstInstance value
# passed to the draw call.
#
# A single full-screen triangle is drawn with InstanceCount=1 and
# FirstInstance=7. The VS reads SV_StartInstanceLocation and forwards it
# to the PS, which writes it to a readback buffer.
# Expected output: [7].

#--- vertex.hlsl
struct VSOutput {
    float4 position : SV_POSITION;
    float startInstanceLocation : START_INSTANCE;
};

VSOutput main(float4 pos : POSITION, uint sil : SV_StartInstanceLocation) {
    VSOutput o;
    o.position = pos;
    o.startInstanceLocation = float(sil);
    return o;
}

#--- pixel.hlsl
struct PSInput {
    float4 position : SV_POSITION;
    float startInstanceLocation : START_INSTANCE;
};

RWStructuredBuffer<uint> Output : register(u0);

float4 main(PSInput input) : SV_TARGET {
    Output[0] = (uint)input.startInstanceLocation;
    return float4(1.0, 0.0, 0.0, 1.0);
}

#--- pipeline.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
DispatchParameters:
  VertexCount: 3
  InstanceCount: 1
  FirstInstance: 7
Buffers:
  # Oversized triangle that covers the entire 1x1 render target.
  - Name: VertexData
    Format: Float32
    Stride: 16
    Data: [ -1.0, -1.0, 0.0, 1.0,
             3.0, -1.0, 0.0, 1.0,
            -1.0,  3.0, 0.0, 1.0 ]
  - Name: RenderTarget
    Format: Float32
    Channels: 4
    FillSize: 16   # 1x1 @ 16 bytes per pixel
    OutputProps:
      Height: 1
      Width: 1
      Depth: 1
  - Name: Output
    Format: Hex32
    Stride: 4
    FillSize: 4
    FillValue: 0xFF
  - Name: Output_Expected
    Format: Hex32
    Stride: 4
    Data: [ 7 ]
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 4
      Offset: 0
      Name: POSITION
  RenderTarget: RenderTarget
DescriptorSets:
  - Resources:
    - Name: Output
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
Results:
  - Result: StartInstanceLocation
    Rule: BufferExact
    Actual: Output
    Expected: Output_Expected
...
#--- end

# SV_StartInstanceLocation: https://github.com/llvm/llvm-project/issues/212577
# Not yet implemented in the Clang-DXC SPIRV or DXIL backend.
# XFAIL: Clang

# Driver bug https://gitlab.freedesktop.org/mesa/mesa/-/work_items/15865,
# Lavapipe (llvmpipe) intermittently crashes (0xc0000005 / SIGSEGV, no output).
# UNSUPPORTED: Lavapipe

# RUN: split-file %s %t
# RUN: %dxc_target -T vs_6_1 -Fo %t-vertex.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_1 -Fo %t-pixel.o %t/pixel.hlsl
# RUN: %offloader %t/pipeline.yaml %t-vertex.o %t-pixel.o
