# REQUIRES: Metal, DXC

# Control: both pixels must be red when stencil testing is disabled,
# independently of whether the converted shader exports SV_StencilRef.
# RUN: split-file %S/StencilRef.test %t
# RUN: %dxc_target -T vs_6_0 -Fo %t-vertex.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_0 -Fo %t-pixel.o %t/pixel.hlsl
# RUN: %offloader %t/disabled.yaml %t-vertex.o %t-pixel.o
