#--- vertex.hlsl
struct VSInput {
  float4 position : POSITION;
  float4 color : COLOR;
  float depth : DEPTH;
};

struct VSOutput {
  float4 position : SV_Position;
  float4 color : COLOR;
  float depth : DEPTH;
};

VSOutput main(VSInput input) {
  VSOutput output;
  output.position = input.position;
  output.position.z = input.color.r > 0.5 ? RED_Z : GREEN_Z;
  output.color = input.color;
  output.depth = input.depth;
  return output;
}

#--- pixel.hlsl
struct PSInput {
  noperspective centroid float4 position : SV_Position;
  float4 color : COLOR;
  float depth : DEPTH;
};

#ifdef IGNORE_DEPTH
float4 main(PSInput input) : SV_Target { return input.color; }
#else
struct PSOutput {
  float4 color : SV_Target;
  float depth : DEPTH_SEMANTIC;
};

PSOutput main(PSInput input) {
  PSOutput output;
  output.color = input.color;
  output.depth = input.depth;
  return output;
}
#endif

#--- pipeline.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
Buffers:
  - Name: VertexData
    Format: Float32
    Stride: 36
    Data: [
       0,  3, 0, 1,  1, 0, 0, 1,  0.25,
       3, -3, 0, 1,  1, 0, 0, 1,  0.25,
      -3, -3, 0, 1,  1, 0, 0, 1,  0.25,
       0,  3, 0, 1,  0, 1, 0, 1,  0.75,
       3, -3, 0, 1,  0, 1, 0, 1,  0.75,
      -3, -3, 0, 1,  0, 1, 0, 1,  0.75,
    ]
  - Name: Output
    Format: Float32
    Channels: 4
    FillSize: 16
    OutputProps:
      Width: 1
      Height: 1
      Depth: 1
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 4
      Offset: 0
      Name: POSITION
    - Format: Float32
      Channels: 4
      Offset: 16
      Name: COLOR
    - Format: Float32
      Channels: 1
      Offset: 32
      Name: DEPTH
  RenderTarget: Output
DescriptorSets: []
...
#--- end

# Draw red before green. Shader depths (0.25, 0.75) make red win, while
# rasterized depths make green win. Conservative outputs obey their promises:
# LessEqual:    0.25 <= 0.9,  0.75 <= 0.8
# GreaterEqual: 0.25 >= 0.1,  0.75 >= 0.05
# Centroid SV_Position satisfies conservative-depth validation while keeping
# the vertex/pixel signatures aligned for DirectX stage linkage.

# Unimplimented: https://github.com/llvm/llvm-project/issues/136978
# Unimplimented: https://github.com/llvm/llvm-project/issues/212551
# Unimplimented: https://github.com/llvm/llvm-project/issues/212560
# XFAIL: Clang

# Driver bug https://gitlab.freedesktop.org/mesa/mesa/-/work_items/15865,
# Lavapipe (llvmpipe) intermittently crashes (0xc0000005 / SIGSEGV, no output).
# UNSUPPORTED: Lavapipe

# RUN: split-file %s %t
# RUN: %dxc_target -T vs_6_0 -DRED_Z=0.9 -DGREEN_Z=0.1 -Fo %t-depth-vs.o %t/vertex.hlsl
# RUN: %dxc_target -T vs_6_0 -DRED_Z=0.9 -DGREEN_Z=0.8 -Fo %t-less-vs.o %t/vertex.hlsl
# RUN: %dxc_target -T vs_6_0 -DRED_Z=0.1 -DGREEN_Z=0.05 -Fo %t-greater-vs.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_0 -DDEPTH_SEMANTIC=SV_Depth -Fo %t-depth-ps.o %t/pixel.hlsl
# RUN: %dxc_target -T ps_6_0 -DDEPTH_SEMANTIC=SV_DepthLessEqual -Fo %t-less-ps.o %t/pixel.hlsl
# RUN: %dxc_target -T ps_6_0 -DDEPTH_SEMANTIC=SV_DepthGreaterEqual -Fo %t-greater-ps.o %t/pixel.hlsl
# RUN: %dxc_target -T ps_6_0 -DIGNORE_DEPTH -Fo %t-control-ps.o %t/pixel.hlsl
# RUN: %offloader %t/pipeline.yaml %t-depth-vs.o %t-depth-ps.o | FileCheck %s --check-prefix=SHADER-DEPTH
# RUN: %offloader %t/pipeline.yaml %t-less-vs.o %t-less-ps.o | FileCheck %s --check-prefix=SHADER-DEPTH
# RUN: %offloader %t/pipeline.yaml %t-greater-vs.o %t-greater-ps.o | FileCheck %s --check-prefix=SHADER-DEPTH
# RUN: %offloader %t/pipeline.yaml %t-depth-vs.o %t-control-ps.o | FileCheck %s --check-prefix=RASTER-DEPTH
# RUN: %offloader %t/pipeline.yaml %t-less-vs.o %t-control-ps.o | FileCheck %s --check-prefix=RASTER-DEPTH
# RUN: %offloader %t/pipeline.yaml %t-greater-vs.o %t-control-ps.o | FileCheck %s --check-prefix=RASTER-DEPTH

# SHADER-DEPTH: Name: Output
# SHADER-DEPTH: Data: [ 1, 0, 0, 1 ]
# RASTER-DEPTH: Name: Output
# RASTER-DEPTH: Data: [ 0, 1, 0, 1 ]
