#--- vertex.hlsl
float4 main(float4 position : POSITION) : SV_POSITION {
#ifdef REVERSE_WINDING
  position.x = -position.x;
#endif
  return position;
}

#--- pixel.hlsl
#ifndef REFERENCE_BASE
#define REFERENCE_BASE 1
#endif
#ifndef REFERENCE_STEP
#define REFERENCE_STEP 1
#endif

struct PSOutput {
  float4 color : SV_Target;
  uint reference : SV_StencilRef;
};

PSOutput main(float4 position : SV_Position) {
  PSOutput output;
  output.color = float4(1, 0, 0, 1);
  output.reference = REFERENCE_BASE + (position.x < 1 ? 0 : REFERENCE_STEP);
  return output;
}

#--- pipeline.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
StencilState:
  Enabled: true
  ClearValue: 1
  ComparisonOp: Equal
Buffers:
  - Name: VertexData
    Format: Float32
    Stride: 16
    Data: [
       0,  3, 0.5, 1,
       3, -3, 0.5, 1,
      -3, -3, 0.5, 1,
    ]
  - Name: Output
    Format: Float32
    Channels: 4
    FillSize: 32
    OutputProps:
      Width: 2
      Height: 1
      Depth: 1
  - Name: Output_Expected
    Format: Float32
    Channels: 4
    Data: [ 1, 0, 0, 1, 0, 0, 0, 0 ]
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 4
      Offset: 0
      Name: POSITION
  RenderTarget: Output
DescriptorSets: []
Results:
  - Result: StencilEqual
    Rule: BufferExact
    Actual: Output
    Expected: Output_Expected
...
#--- disabled.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
StencilState:
  Enabled: false
  ClearValue: 1
  ComparisonOp: Equal
Buffers:
  - Name: VertexData
    Format: Float32
    Stride: 16
    Data: [
       0,  3, 0.5, 1,
       3, -3, 0.5, 1,
      -3, -3, 0.5, 1,
    ]
  - Name: Output
    Format: Float32
    Channels: 4
    FillSize: 32
    OutputProps:
      Width: 2
      Height: 1
      Depth: 1
  - Name: Output_Expected
    Format: Float32
    Channels: 4
    Data: [ 1, 0, 0, 1, 1, 0, 0, 1 ]
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 4
      Offset: 0
      Name: POSITION
  RenderTarget: Output
DescriptorSets: []
Results:
  - Result: StencilDisabled
    Rule: BufferExact
    Actual: Output
    Expected: Output_Expected
...
#--- defaults.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
StencilState:
  Enabled: true
Buffers:
  - Name: VertexData
    Format: Float32
    Stride: 16
    Data: [
       0,  3, 0.5, 1,
       3, -3, 0.5, 1,
      -3, -3, 0.5, 1,
    ]
  - Name: Output
    Format: Float32
    Channels: 4
    FillSize: 32
    OutputProps:
      Width: 2
      Height: 1
      Depth: 1
  - Name: Output_Expected
    Format: Float32
    Channels: 4
    Data: [ 1, 0, 0, 1, 0, 0, 0, 0 ]
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 4
      Offset: 0
      Name: POSITION
  RenderTarget: Output
DescriptorSets: []
Results:
  - Result: StencilDefaults
    Rule: BufferExact
    Actual: Output
    Expected: Output_Expected
...
#--- max.yaml
---
Shaders:
  - Stage: Vertex
    Entry: main
  - Stage: Pixel
    Entry: main
StencilState:
  Enabled: true
  ClearValue: 255
  ComparisonOp: Equal
Buffers:
  - Name: VertexData
    Format: Float32
    Stride: 16
    Data: [
       0,  3, 0.5, 1,
       3, -3, 0.5, 1,
      -3, -3, 0.5, 1,
    ]
  - Name: Output
    Format: Float32
    Channels: 4
    FillSize: 32
    OutputProps:
      Width: 2
      Height: 1
      Depth: 1
  - Name: Output_Expected
    Format: Float32
    Channels: 4
    Data: [ 1, 0, 0, 1, 0, 0, 0, 0 ]
Bindings:
  VertexBuffer: VertexData
  VertexAttributes:
    - Format: Float32
      Channels: 4
      Offset: 0
      Name: POSITION
  RenderTarget: Output
DescriptorSets: []
Results:
  - Result: StencilMaxClearValue
    Rule: BufferExact
    Actual: Output
    Expected: Output_Expected
...
#--- end

# Shader references 1 and 2 are compared against a stencil clear value of 1.
# Equal accepts only the first pixel; ignoring SV_StencilRef (the
# fixed-function reference is 0) rejects both. Comparison-function coverage
# lives in StencilCompareOps.test; this test covers back faces (reversed
# winding), disabled stencil, StencilState defaults, and the maximum 8-bit
# reference (the max case uses references 255 and 254).
# REQUIRES: ShaderStencilRef

# Unimplimented: https://github.com/llvm/llvm-project/issues/136980
# XFAIL: Clang

# Bug: https://github.com/microsoft/DirectXShaderCompiler/issues/9038
# XFAIL: DXC && Vulkan && !Lavapipe

# Unimplimented: https://github.com/llvm/offload-test-suite/issues/1607
# XFAIL: Metal

# RUN: split-file %s %t
# RUN: %dxc_target -T vs_6_0 -Fo %t-vertex.o %t/vertex.hlsl
# RUN: %dxc_target -T vs_6_0 -DREVERSE_WINDING -Fo %t-reversed.o %t/vertex.hlsl
# RUN: %dxc_target -T ps_6_0 -Fo %t-pixel.o %t/pixel.hlsl
# RUN: %dxc_target -T ps_6_0 -DREFERENCE_BASE=0 -Fo %t-defaults.o %t/pixel.hlsl
# RUN: %dxc_target -T ps_6_0 -DREFERENCE_BASE=255 -DREFERENCE_STEP=-1 -Fo %t-max.o %t/pixel.hlsl
# RUN: %offloader %t/pipeline.yaml %t-reversed.o %t-pixel.o
# RUN: %offloader %t/disabled.yaml %t-vertex.o %t-pixel.o
# RUN: %offloader %t/defaults.yaml %t-vertex.o %t-defaults.o
# RUN: %offloader %t/max.yaml %t-vertex.o %t-max.o
