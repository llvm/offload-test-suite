#--- pipeline.yaml
---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: Int64
    Stride: 32
    Data: [ -4294967297, 4294967298, -4294967299, 4294967300,
            4294967301, -4294967302, 4294967303, -4294967304,
            -4294967305, 4294967306, -4294967307, 4294967308,
            4294967309, -4294967310, 4294967311, -4294967312,
            -4294967313, 4294967314, -4294967315, 4294967316,
            4294967317, -4294967318, 4294967319, -4294967320,
            -4294967321, 4294967322, -4294967323, 4294967324,
            4294967325, -4294967326, 4294967327, -4294967328 ]
  - Name: Out
    Format: UInt32
    Stride: 16
    FillSize: 512
  - Name: Expected
    Format: UInt32
    Stride: 16
    FillSize: 512
    FillValue: 1
Results:
  - Result: ScalarAndVectors
    Rule: BufferExact
    Actual: Out
    Expected: Expected
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# REQUIRES: Int64

# Unimplemented: https://github.com/llvm/llvm-project/issues/99174
# XFAIL: Clang

# Unimplemented: https://github.com/llvm/offload-test-suite/issues/1641
# XFAIL: Vulkan

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_5 -DTYPE=int64_t \
# RUN:   -Fo %t.o %S/Inputs/QuadReadLaneAt.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
# RUN: %dxc_target -T cs_6_5 -DTYPE=uint64_t \
# RUN:   -Fo %t.o %S/Inputs/QuadReadLaneAt.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
