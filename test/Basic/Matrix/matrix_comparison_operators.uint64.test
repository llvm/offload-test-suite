#--- source.hlsl

RWBuffer<uint64_t> Uint64LHSIn : register(u0);
RWBuffer<uint64_t> Uint64RHSIn : register(u1);
RWStructuredBuffer<bool> BoolOut : register(u2);

[numthreads(1, 1, 1)]
void main() {
  uint64_t3x4 Uint64GELHS = uint64_t3x4(Uint64LHSIn[0], Uint64LHSIn[1], Uint64LHSIn[2], Uint64LHSIn[3], Uint64LHSIn[4], Uint64LHSIn[5], Uint64LHSIn[6], Uint64LHSIn[7], Uint64LHSIn[8], Uint64LHSIn[9], Uint64LHSIn[10], Uint64LHSIn[11]);
  uint64_t3x4 Uint64GERHS = uint64_t3x4(Uint64RHSIn[0], Uint64RHSIn[1], Uint64RHSIn[2], Uint64RHSIn[3], Uint64RHSIn[4], Uint64RHSIn[5], Uint64RHSIn[6], Uint64RHSIn[7], Uint64RHSIn[8], Uint64RHSIn[9], Uint64RHSIn[10], Uint64RHSIn[11]);
  bool3x4 Uint64GE = Uint64GELHS >= Uint64GERHS;

  for (uint Row = 0; Row < 3; ++Row)
    for (uint Col = 0; Col < 4; ++Col)
      BoolOut[Row * 4 + Col] = Uint64GE[Row][Col];
}

#--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: Uint64LHSIn
    Format: UInt64
    Data: [ 1, 2, 3, 4, 5, 6, 7, 8, 9,
            9223372036854775808, 9223372036854775809,
            18446744073709551615 ]
  - Name: Uint64RHSIn
    Format: UInt64
    Data: [ 2, 1, 3, 5, 4, 6, 8, 7, 9,
            9223372036854775809, 9223372036854775808,
            18446744073709551615 ]
  - Name: BoolOut
    Format: Int32
    FillSize: 48
  - Name: BoolExpected
    Format: Int32
    Data: [ 0, 1, 1, 0, 1, 1, 0, 1, 1, 0, 1, 1 ]
Results:
  - Result: BoolOut
    Rule: BufferExact
    Actual: BoolOut
    Expected: BoolExpected
DescriptorSets:
  - Resources:
    - Name: Uint64LHSIn
      Kind: RWBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Uint64RHSIn
      Kind: RWBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: BoolOut
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
...
#--- end

# Bug https://github.com/llvm/offload-test-suite/issues/1531
# XFAIL Clang  && Vulkan && AMD

# Unimplemented https://github.com/microsoft/DirectXShaderCompiler/issues/8796
# XFAIL: DXC && Vulkan

# REQUIRES: Int64

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_0 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
