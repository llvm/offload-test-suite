#--- source.hlsl

RWBuffer<int64_t> Int64LHSIn : register(u0);
RWBuffer<int64_t> Int64RHSIn : register(u1);
RWStructuredBuffer<bool> BoolOut : register(u2);

[numthreads(1, 1, 1)]
void main() {
  int64_t3x3 Int64LELHS = int64_t3x3(Int64LHSIn[0], Int64LHSIn[1], Int64LHSIn[2], Int64LHSIn[3], Int64LHSIn[4], Int64LHSIn[5], Int64LHSIn[6], Int64LHSIn[7], Int64LHSIn[8]);
  int64_t3x3 Int64LERHS = int64_t3x3(Int64RHSIn[0], Int64RHSIn[1], Int64RHSIn[2], Int64RHSIn[3], Int64RHSIn[4], Int64RHSIn[5], Int64RHSIn[6], Int64RHSIn[7], Int64RHSIn[8]);
  bool3x3 Int64LE = Int64LELHS <= Int64LERHS;

  for (uint Row = 0; Row < 3; ++Row)
    for (uint Col = 0; Col < 3; ++Col)
      BoolOut[Row * 3 + Col] = Int64LE[Row][Col];
}

#--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: Int64LHSIn
    Format: Int64
    Data: [ -4, -3, -2, -1, 0, 1, 2, 3, 4 ]
  - Name: Int64RHSIn
    Format: Int64
    Data: [ -3, -4, -2, 0, -1, 1, 3, 2, 4 ]
  - Name: BoolOut
    Format: Int32
    FillSize: 36
  - Name: BoolExpected
    Format: Int32
    Data: [ 1, 0, 1, 1, 0, 1, 1, 0, 1 ]
Results:
  - Result: BoolOut
    Rule: BufferExact
    Actual: BoolOut
    Expected: BoolExpected
DescriptorSets:
  - Resources:
    - Name: Int64LHSIn
      Kind: RWBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: Int64RHSIn
      Kind: RWBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: BoolOut
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 2
        Space: 0
      VulkanBinding:
        Binding: 2
...
#--- end

# Unimplemented https://github.com/microsoft/DirectXShaderCompiler/issues/8796
# XFAIL: DXC && Vulkan

# REQUIRES: Int64

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_0 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
