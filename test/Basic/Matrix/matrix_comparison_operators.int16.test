#--- source.hlsl

RWBuffer<int16_t> Int16In : register(u0);
RWStructuredBuffer<bool> BoolOut : register(u1);

[numthreads(1, 1, 1)]
void main() {
  int16_t2x3 Int16LTLHS = Int16In[0], Int16LTRHS = Int16In[1];
  bool2x3 Int16LT = Int16LTLHS < Int16LTRHS;

  for (uint Row = 0; Row < 2; ++Row)
    for (uint Col = 0; Col < 3; ++Col)
      BoolOut[Row * 3 + Col] = Int16LT[Row][Col];
}

#--- pipeline.yaml

---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: Int16In
    Format: Int16
    Data: [ 1, 2 ]
  - Name: BoolOut
    Format: Int32
    FillSize: 24
  - Name: BoolExpected
    Format: Int32
    Data: [ 1, 1, 1, 1, 1, 1 ]
Results:
  - Result: BoolOut
    Rule: BufferExact
    Actual: BoolOut
    Expected: BoolExpected
DescriptorSets:
  - Resources:
    - Name: Int16In
      Kind: RWBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
    - Name: BoolOut
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
...
#--- end

# REQUIRES: Int16

# RUN: split-file %s %t
# RUN: %dxc_target -enable-16bit-types -T cs_6_2 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
